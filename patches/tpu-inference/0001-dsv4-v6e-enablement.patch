+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""fp8_fake_quant vs DeepSeek-V4 reference act_quant(x, 64, "ue8m0", inplace)."""
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+from absl.testing import absltest
+
+from tpu_inference.kernels.experimental.deepseek_v4.compress_and_store.compute import \
+    fp8_fake_quant
+
+
+def _reference(x: np.ndarray, block: int, nope: int) -> np.ndarray:
+    # DeepSeek-V4 inference/kernel.py act_quant_kernel with round_scale and
+    # inplace=True, applied to x[..., :nope].
+    out = x.astype(np.float32).copy()
+    xb = out[..., :nope].reshape(*x.shape[:-1], nope // block, block)
+    amax = np.maximum(np.abs(xb).max(-1, keepdims=True), 1e-4)
+    scale = np.exp2(np.ceil(np.log2(amax / 448.0))).astype(np.float32)
+    q = np.clip(xb / scale, -448, 448)
+    q = np.asarray(jnp.asarray(q).astype(jnp.float8_e4m3fn).astype(jnp.float32))
+    out[..., :nope] = (q * scale).reshape(*x.shape[:-1], nope)
+    return out
+
+
+class Fp8FakeQuantTest(absltest.TestCase):
+
+    def test_flat_matches_reference(self):
+        x = jax.random.normal(jax.random.key(0), (37, 512), jnp.float32) * 3
+        x = x.at[3].set(0.0)  # all-zero row exercises the 1e-4 amax floor
+        x = x.astype(jnp.bfloat16)
+        got = fp8_fake_quant(x, 64, 448)
+        want = _reference(np.asarray(x.astype(jnp.float32)), 64, 448)
+        np.testing.assert_array_equal(np.asarray(got.astype(jnp.float32)),
+                                      np.asarray(jnp.asarray(want).astype(
+                                          jnp.bfloat16).astype(jnp.float32)))
+        # RoPE channels are untouched.
+        np.testing.assert_array_equal(np.asarray(got[:, 448:]),
+                                      np.asarray(x[:, 448:]))
+
+    def test_tiled_layout_matches_flat(self):
+        # Compressor kernel layout: (tokens, head_tiles, 128) f32.
+        x = jax.random.normal(jax.random.key(1), (8, 512), jnp.float32)
+        flat = fp8_fake_quant(x, 64, 448)
+        tiled = fp8_fake_quant(x.reshape(8, 4, 128), 64, 448).reshape(8, 512)
+        np.testing.assert_array_equal(np.asarray(flat), np.asarray(tiled))
+
+
+if __name__ == "__main__":
+    absltest.main()
