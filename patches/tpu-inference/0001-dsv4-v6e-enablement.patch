+def _init_accepts(cls: type, name: str) -> bool:
+    """Whether ``cls(...)`` accepts keyword ``name``.
+
+    Follows the MRO through constructors that forward ``*args, **kwargs``
+    (e.g. vLLM's ``AsyncScheduler``), whose own signature does not name it.
+    """
+    import inspect
+    for klass in cls.__mro__:
+        init = klass.__dict__.get("__init__")
+        if init is None:
+            continue
+        params = inspect.signature(init).parameters
+        if name in params:
+            return True
+        if not any(p.kind is inspect.Parameter.VAR_KEYWORD
+                   for p in params.values()):
+            return False
+    return False
+
