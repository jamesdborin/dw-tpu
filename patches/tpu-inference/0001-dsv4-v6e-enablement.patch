diff --git a/tests/kernels/deepseek_v4/fp8_fake_quant_test.py b/tests/kernels/deepseek_v4/fp8_fake_quant_test.py
new file mode 100644
index 0000000..034a78e
--- /dev/null
+++ b/tests/kernels/deepseek_v4/fp8_fake_quant_test.py
@@ -0,0 +1,62 @@
+# Copyright 2025 Google LLC
