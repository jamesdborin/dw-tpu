+def fp4_weight_to_codes(weight: jax.Array) -> jax.Array:
+    """Store an fp4 expert weight as gmm_v2's uint4 codes if the chip needs it.
+
+    On TPUs whose Mosaic cannot materialize f4 (v6e and older) tokamax gmm_v2
+    decodes fp4 in-kernel from uint4 codes. Handing it float4_e2m1fn weights
+    makes it re-encode all experts' weights on every call, a full HBM pass
+    (~30 ms per DeepSeek-V4 layer per step on v6e, ~90% of decode time).
+    Encode once here instead; gmm_wrapper passes ``rhs_fp4_codes`` for uint4
+    weights. The encoding is exact.
+    """
+    if weight.dtype != jnp.float4_e2m1fn:
+        return weight
+    device = next(iter(weight.devices()))
+    if device.platform != "tpu":
+        return weight
+    from tokamax._src.ops.experimental.gmm_v2.gmm_v2 import (
+        e2m1_to_codes, needs_fp4_emulation)
+
+    # Weight loading may run with a CPU default device; ask about the chip
+    # the weight lives on.
+    with jax.default_device(device):
+        if not needs_fp4_emulation(weight.dtype):
+            return weight
+    return jax.jit(e2m1_to_codes, donate_argnums=0)(weight)
+
+
