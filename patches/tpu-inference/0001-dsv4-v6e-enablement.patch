+def _dequantize_linear_weight(w: jax.Array, s: jax.Array) -> jax.Array:
+    """Exact bf16 copy of a processed [in, out] fp8 linear weight."""
+    k, n = w.shape
+    w = w.astype(jnp.float32)
+    if s.ndim == 1:  # per output channel
+        w = w * s[None, :]
+    elif s.ndim == 2:  # [in_blocks, out_blocks] (requantization disabled)
+        kb, nb = s.shape
+        w = (w.reshape(kb, k // kb, nb, n // nb) *
+             s[:, None, :, None]).reshape(k, n)
+    else:  # [(1,) in_blocks, 1, out]: block quantized-matmul kernel layout
+        s = s.reshape(-1, n)
+        w = (w.reshape(s.shape[0], -1, n) * s[:, None, :]).reshape(k, n)
+    return w.astype(jnp.bfloat16)
+
+
+class VllmDeepseekV4WoALinearMethod(VllmFp8LinearMethod):
+    """DeepSeek-V4 attention ``wo_a``.
+
+    It is consumed by the fused inverse-RoPE + grouped-bmm kernel rather than a
+    matmul, and the reference model runs it in bf16 on the dequantized fp8
+    weight. Load it like any fp8 linear, then keep an exact bf16 copy with a
+    unit per-channel scale.
+    """
+
+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
+        super().process_weights_after_loading(layer)
+        w = _dequantize_linear_weight(jax_view(layer.weight),
+                                      jax_view(layer.weight_scale))
+        layer.weight = Parameter(torch_view(w), requires_grad=False)
+        layer.weight_scale = Parameter(torch_view(
+            jnp.ones((w.shape[1], ), jnp.float32)),
+                                       requires_grad=False)
+
+
 @register_quantization_config(DSV4_FP8)
