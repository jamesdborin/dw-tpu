+            if (key in ("w13_weight", "w2_weight") and moe_backend
+                    in (MoEBackend.GMM_TP, MoEBackend.GMM_EP)):
+                weight = fp4_weight_to_codes(weight)
             setattr(weights, key, weight)
     return weights
 
