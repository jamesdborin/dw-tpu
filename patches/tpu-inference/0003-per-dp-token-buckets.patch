+    *, dp_size: int = 1) -> list[int]:
     """Token buckets for the runner: never pad a step past the budget.
 
     `get_token_paddings` grows buckets until one covers `max_token_size`, so
@@ -246,6 +247,19 @@ def build_token_paddings(
     `compilation_sizes`, which are kept as given even when above the budget.
     A budget that is already a bucket yields the stock list.
     """
+    override = os.environ.get("TPU_TOKEN_PADDINGS_PER_DP")
+    if override is not None:
+        per_dp = [int(value.strip()) for value in override.split(",")]
+        assert dp_size > 0 and min_token_size > 0, "Invalid DP/alignment"
+        assert per_dp and all(value > 0 for value in per_dp), "Buckets must be positive"
+        assert per_dp == sorted(set(per_dp)), "Buckets must be strictly increasing"
+        paddings = [value * dp_size for value in per_dp]
+        assert paddings[-1] == max_token_size, "Last bucket must equal the scheduler budget"
+        assert all(value % min_token_size == 0 for value in paddings), "Buckets must respect token alignment"
+        logger.info(f"Prepared token paddings: {paddings}")
+        logger.info(f"Prepared token paddings per DP: {per_dp}")
+        return paddings
+
