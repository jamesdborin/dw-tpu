diff --git a/tpu_inference/runner/async_host_output.py b/tpu_inference/runner/async_host_output.py
new file mode 100644
index 0000000..22e8ee0
--- /dev/null
+++ b/tpu_inference/runner/async_host_output.py
@@ -0,0 +1,26 @@
+"""Prepare complete local async-output buffers from the all-worker path.
+
+Every process must call this in the same order. Any reshard collective is
+scheduled here, never in the designated output rank's background thread.
+"""
+import jax
+from jax.sharding import NamedSharding, PartitionSpec
+
+
+def prepare_async_host_output(value, mesh):
+    replicated_sharding = NamedSharding(mesh, PartitionSpec())
+
+    def local_copy(leaf):
+        if not isinstance(leaf, jax.Array):
+            return leaf
+        if not leaf.is_fully_addressable:
+            if not leaf.is_fully_replicated:
+                leaf = jax.device_put(leaf, replicated_sharding)
+            if not leaf.addressable_shards:
+                raise RuntimeError("Async output requires a local replicated shard")
+            leaf = leaf.addressable_shards[0].data
+        if not leaf.is_fully_addressable:
+            raise RuntimeError("Async output still contains a nonlocal array")
+        return jax.copy_to_host_async(leaf)
+
+    return jax.tree_util.tree_map(local_copy, value)
