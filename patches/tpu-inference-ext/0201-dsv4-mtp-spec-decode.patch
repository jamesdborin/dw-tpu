+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Multi-process CPU trace of the DSV4 MTP speculative-decoding request path.
+
+Emulates the multi-host serving setup on CPU: 2 JAX processes x 2 CPU devices
+(jax.distributed on localhost), attention DP = 4, TPU_MULTIHOST_BACKEND=ray
+(host->device puts go through make_array_from_callback) and
+TPU_ASYNC_REPLICATE_OUTPUTS=1, async scheduling, k = 3 MTP drafts. Arrays
+spanning the other process's devices are non-addressable, so any host read of
+a global array fails exactly as on the 8-host slice.
+
+The real TPUModelRunner runs end to end: execute_model (_prepare_inputs,
+target step via the real VllmModelWrapper/get_model path) -> sample_tokens
+(_sample_from_logits: bonus sampling, rejection sampler, logprobs, prompt
+logprobs, async replicated outputs) -> SpeculativeDecodingManager ->
+DeepseekV4MtpProposer (prepare_inputs/propose through the real draft step)
+-> AsyncTPUModelRunnerOutput.get_output, over several async steps with the
+runner's own placeholder substitution and rejection correction. Only
+`VllmModelWrapper.load_weights` is replaced by tiny torch models:
+
+  target:  next(x_t) = (7 * x_t + t) mod V (one-hot logits), aux hidden = x
+  draft:   MTP slot i (input x_{i+1}, pos i) predicts (7 x_{i+1} + i + 1) mod V,
+           i.e. the target's rule, except positions = 5 mod 6 are corrupted,
+           so steps see accepted and rejected drafts.
+
+The request mirrors the acceptance probe: an 8-token prompt, greedy, logprobs
+and prompt_logprobs (echo). Greedy outputs must equal the target's rule.
+
+Run: python mp_dsv4_spec_runner_trace.py <ckpt-config-dir>  (spawns 2 procs)
+SPECDEC_TRACE_MODE=sample runs the temperature-1 / logprobs=20 variant.
+"""
+import os
+import subprocess
+import sys
+import tempfile
+
+N_PROC, DEV_PER_PROC, K = 2, 2, 3
+PROMPT = [11, 23, 5, 17, 2, 9, 31, 4]
+MAX_TOKENS = 20
+MTP_LAYER = "model.layers.43.attn.swa_cache"
+OTHER_LAYER = "model.layers.0.attn.swa_cache"
+
+
+def main_driver(cfg_dir):
+    port = 47000 + os.getpid() % 1000
+    env = dict(os.environ,
+               JAX_PLATFORMS="cpu",
+               XLA_FLAGS=f"--xla_force_host_platform_device_count={DEV_PER_PROC}",
+               NEW_MODEL_DESIGN="1",
+               MODEL_IMPL_TYPE="vllm",
+               DRAFT_MODEL_IMPL_TYPE="vllm",
+               TPU_MULTIHOST_BACKEND="ray",
+               TPU_ASYNC_REPLICATE_OUTPUTS="1",
+               SKIP_JAX_PRECOMPILE="1",
+               TPU_TOKEN_PADDINGS_PER_DP="4,8,16",
+               SPECDEC_TRACE_PORT=str(port))
+    procs = [
+        subprocess.Popen([sys.executable, __file__, cfg_dir, str(i)], env=env)
+        for i in range(N_PROC)
+    ]
+    codes = [p.wait(timeout=900) for p in procs]
+    print("process exit codes", codes)
+    sys.exit(max(codes))
+
+
+def worker(cfg_dir, pid):
+    import jax
+    jax.distributed.initialize(
+        f"127.0.0.1:{os.environ['SPECDEC_TRACE_PORT']}",
+        num_processes=N_PROC,
+        process_id=pid)
+    import numpy as np
+    import torch
+    from torchax.interop import jax_view
+    from vllm.config import set_current_vllm_config
+    from vllm.engine.arg_utils import EngineArgs
+    from vllm.forward_context import get_forward_context
+    from vllm.sampling_params import SamplingParams
+    from vllm.v1.core.sched.output import CachedRequestData, NewRequestData
+    from vllm.v1.kv_cache_interface import (KVCacheConfig, KVCacheGroupSpec,
+                                            SlidingWindowSpec)
+
+    from tpu_inference.core.sched.dp_scheduler import DPSchedulerOutput
+    from tpu_inference.layers.common.sharding import ShardingAxisName
+    from tpu_inference.models.vllm import vllm_model_wrapper as wm
+    from tpu_inference.models.vllm.experimental import register_models
+    from tpu_inference.models.vllm.vllm_model_wrapper_context import \
+        get_vllm_model_wrapper_context
+    from tpu_inference.runner.tpu_runner import TPUModelRunner
+    register_models()
+
+    ea = EngineArgs(
+        model=cfg_dir,
+        tokenizer=cfg_dir,
+        load_format="dummy",
+        speculative_config={
+            "method": "mtp",
+            "num_speculative_tokens": K,
+            "disable_eagle_block_drop": True
+        },
+        max_model_len=64,
+        max_num_batched_tokens=16,
+        max_num_seqs=2,
+        kv_cache_dtype="fp8",
+        enable_prefix_caching=True,
+        tensor_parallel_size=N_PROC * DEV_PER_PROC,
+        tokenizer_mode="deepseek_v4",
+        additional_config={
+            "sharding": {
+                "sharding_strategy": {
+                    "enable_dp_attention": True
+                }
+            }
+        })
+    cfg = ea.create_engine_config()
+    cfg.cache_config.block_size = 16
+    assert cfg.scheduler_config.async_scheduling
+
+    BS = 16
+
+    class ToyTarget(torch.nn.Module):
+
+        def __init__(self, vocab):
+            super().__init__()
+            self.vocab = vocab
+            self.bias = torch.nn.Parameter(torch.zeros(vocab),
+                                           requires_grad=False)
+            # Stand-ins for the parameters the MTP drafter shares.
+            self.model = torch.nn.Module()
+            self.model.embed_tokens = torch.nn.Embedding(4, 4)
+            self.lm_head = torch.nn.Linear(4, 4, bias=False)
+
+        def forward(self,
+                    input_ids,
+                    positions,
+                    intermediate_tensors=None,
+                    inputs_embeds=None):
+            nxt = (input_ids * 7 + positions) % self.vocab
+            # Scale 100: probability ~1 on the rule's token even at
+            # temperature 1 over the full 129k vocabulary.
+            h = torch.nn.functional.one_hot(nxt, self.vocab).to(
+                torch.bfloat16) * 100
+            aux = torch.nn.functional.one_hot(input_ids % 64, 64).to(
+                torch.bfloat16)
+            return h, [aux]
+
+        def compute_logits(self, h):
+            return h.to(torch.float32) + self.bias
+
+    class ToyDraft(torch.nn.Module):
+
+        def __init__(self, vocab):
+            super().__init__()
+            self.vocab = vocab
+            self.bias = torch.nn.Parameter(torch.zeros(vocab),
+                                           requires_grad=False)
+
+        def forward(self,
+                    input_ids,
+                    positions,
+                    hidden_states,
+                    intermediate_tensors=None,
+                    inputs_embeds=None,
+                    spec_step_idx=0):
+            md = get_forward_context().attn_metadata[MTP_LAYER]
+            ctx = get_vllm_model_wrapper_context()
+            idx = ctx.layer_name_to_kvcache_index[MTP_LAYER]
+            from jax.sharding import PartitionSpec as P
+            import jax.numpy as jnp
+
+            def write(ids, pos, qsl, bt, dist, cache):
+                t = jnp.arange(ids.shape[0])
+                n = dist[2]
+                nreq = qsl.shape[0] - 1
+                stride = bt.shape[0] // nreq
+                req = jnp.minimum(jnp.searchsorted(qsl[1:], t, side="right"),
+                                  nreq - 1)
+                valid = t < qsl[n]
+                slot = bt[req * stride + pos // BS] * BS + pos % BS
+                slot = jnp.where(valid, slot, cache.shape[0])
+                return cache.at[slot].set(ids + 1, mode="drop")
+
+            data = P(ShardingAxisName.ATTN_DATA)
+            ctx.kv_caches[idx] = jax.shard_map(
+                write, mesh=ctx.mesh, in_specs=(data, ) * 6,
+                out_specs=data)(jax_view(input_ids), jax_view(positions),
+                                md.query_start_loc, md.block_tables,
+                                md.request_distribution, ctx.kv_caches[idx])
+            d = (input_ids * 7 + positions + 1) % self.vocab
+            d = torch.where(positions % 6 == 5, (d + 1) % self.vocab, d)
+            return torch.nn.functional.one_hot(d, self.vocab).to(
+                torch.bfloat16) * 10
+
+        def compute_logits(self, h):
+            return h.to(torch.float32) + self.bias
+
+    def fake_load_weights(self, shared_params=None):
+        import jax.numpy as jnp
+        from jax.sharding import NamedSharding, PartitionSpec
+        vocab = 129280
+        if self.is_draft_model:
+            self.model = wm._VllmRunner(ToyDraft(vocab))
+            names = ["vllm_model.bias"]
+        else:
+            self.model = wm._VllmRunner(ToyTarget(vocab))
+            names = [
+                "vllm_model.bias", "vllm_model.model.embed_tokens.weight",
+                "vllm_model.lm_head.weight"
+            ]
+        rep = NamedSharding(self.mesh, PartitionSpec())
+        params = {
+            "vllm_model.bias":
+            jax.device_put(jnp.zeros((vocab, ), jnp.float32), rep)
+        }
+        for n in names[1:]:
+            params[n] = jax.device_put(jnp.zeros((4, 4), jnp.float32), rep)
+        if self.is_draft_model:
+            assert shared_params and set(shared_params) == {
+                "vllm_model.model.embed_tokens.weight",
+                "vllm_model.model.layers.43.shared_head.head.weight"
+            }, shared_params
+        self._pooler = None
+        self._mm_encoder_jit_manager = None
+        return params, None
+
+    wm.VllmModelWrapper.load_weights = fake_load_weights
+    # CPU XLA rejects the TPU-only compiler options; same programs otherwise.
+    wm.get_step_fn_compiler_options = lambda: {}
+    from tpu_inference.spec_decode.jax import dsv4_mtp
+    dsv4_mtp.DeepseekV4MtpProposer._propose_dsv4 = jax.jit(
+        dsv4_mtp.DeepseekV4MtpProposer._propose_dsv4.__wrapped__,
+        donate_argnames=("kv_caches", ),
+        static_argnums=(0, 7, 8))
+    wm.VllmModelWrapper.__init__.__globals__["get_tpu_quantization_config"] = (
+        lambda *a, **k: None)
+
+    with set_current_vllm_config(cfg):
+        runner = TPUModelRunner(cfg, jax.devices())
+        assert runner.dp_size == N_PROC * DEV_PER_PROC, runner.dp_size
+        runner.load_model()
+
+        # Two SWA groups; the MTP layer is NOT in the last group's position 0
+        # and its block table differs from the other group's.
+        spec = SlidingWindowSpec(block_size=BS,
+                                 num_kv_heads=1,
+                                 head_size=128,
+                                 dtype=torch.bfloat16,
+                                 sliding_window=64)
+        kvc = KVCacheConfig(num_blocks=16,
+                            kv_cache_tensors=[],
+                            kv_cache_groups=[
+                                KVCacheGroupSpec([OTHER_LAYER], spec),
+                                KVCacheGroupSpec([MTP_LAYER], spec),
+                            ])
+        mgr = runner.kv_cache_manager
+
+        def init_kv(kv_cache_config):
+            from jax.sharding import NamedSharding, PartitionSpec
+            mgr.maybe_reinitialize_input_batch(kv_cache_config)
+            sh = NamedSharding(runner.mesh,
+                               PartitionSpec(ShardingAxisName.BATCH))
+            runner.kv_caches.extend(
+                jax.make_array_from_callback(
+                    (runner.dp_size * 16 * BS, ), sh,
+                    lambda i: np.zeros(runner.dp_size * 16 * BS, np.int32)[i])
+                for _ in range(2))
+            runner.layer_name_to_kvcache_index.update({
+                OTHER_LAYER: 0,
+                MTP_LAYER: 1
+            })
+
+        mgr.initialize_kv_cache = init_kv
+        runner.initialize_kv_cache(kvc)
+
+        sample_mode = os.environ.get("SPECDEC_TRACE_MODE") == "sample"
+        if sample_mode:
+            # spec_acceptance.py: temperature 1, top-20 logprobs, no echo.
+            sp = SamplingParams(temperature=1.0,
+                                top_p=1.0,
+                                max_tokens=MAX_TOKENS,
+                                logprobs=20,
+                                ignore_eos=True)
+        else:
+            # runner probe: greedy, logprobs + prompt logprobs (echo).
+            sp = SamplingParams(temperature=0.0,
+                                max_tokens=MAX_TOKENS,
+                                logprobs=10,
+                                prompt_logprobs=10,
+                                ignore_eos=True)
+        # Two concurrent requests on ranks owned by different processes
+        # (rank 3 -> process 1, rank 0 -> process 0); rank 1/2 stay empty.
+        REQS = {"probe-0": (3, list(PROMPT)),
+                "probe-1": (0, [7, 3, 19, 41, 5, 13, 2, 29])}
+        RIDS = list(REQS)
+        per_rank = {r: [] for r in range(runner.dp_size)}
+        for rid, (rank, _) in REQS.items():
+            per_rank[rank].append(rid)
+
+        def sched(new=(), cached=None, n=0, spec_toks=None):
+            return DPSchedulerOutput(
+                scheduled_new_reqs=list(new),
+                scheduled_cached_reqs=cached or CachedRequestData.make_empty(),
+                num_scheduled_tokens={rid: n for rid in RIDS},
+                total_num_scheduled_tokens=n * len(RIDS),
+                scheduled_spec_decode_tokens=({
+                    rid: spec_toks for rid in RIDS
+                } if spec_toks else {}),
+                scheduled_encoder_inputs={},
+                num_common_prefix_blocks=[0, 0],
+                finished_req_ids=set(),
+                free_encoder_mm_hashes=[],
+                assigned_dp_rank={rid: REQS[rid][0] for rid in RIDS},
+                max_num_scheduled_tokens_per_dp_rank=n,
+                req_ids_per_rank=per_rank,
+            )
+
+        def cached(computed, out_tokens):
+            return CachedRequestData(req_ids=RIDS,
+                                     resumed_req_ids=set(),
+                                     new_token_ids=[[] for _ in RIDS],
+                                     all_token_ids={},
+                                     new_block_ids=[None for _ in RIDS],
+                                     num_computed_tokens=[computed[r] for r in RIDS],
+                                     num_output_tokens=[out_tokens[r] for r in RIDS])
+
+        # Async engine loop with one step in flight (as the batch queue).
+        generated = {rid: [] for rid in RIDS}
+        step_counts = []
+        computed = {}
+        pending = []  # (async_output, num_drafts_scheduled, sched_output)
+        from types import SimpleNamespace
+        from tpu_inference.core.sched.dp_scheduler import DPScheduler
+        ns = SimpleNamespace(dp_size=runner.dp_size)
+        ns._slice_logprobs = DPScheduler._slice_logprobs  # staticmethod
+
+        def drain_one():
+            out, drafts, so_k = pending.pop(0)
+            res = out.get_output()
+            # Engine side: the DP scheduler splits outputs per rank, including
+            # variable-length (speculative) logprobs.
+            by_rank = DPScheduler._split_model_output_by_rank(ns, so_k, res)
+            for rid in RIDS:
+                rank_out = by_rank[REQS[rid][0]]
+                j = rank_out.req_id_to_index[rid]
+                toks = res.sampled_token_ids[res.req_id_to_index[rid]]
+                assert rank_out.sampled_token_ids[j] == toks
+                if rank_out.logprobs is not None:
+                    lpl = rank_out.logprobs
+                    cu = lpl.cu_num_generated_tokens
+                    a, b = (cu[j], cu[j + 1]) if cu is not None else (j, j + 1)
+                    got = lpl.logprob_token_ids[a:b, 0].tolist()
+                    assert got == toks, ("logprob token ids", rid, got,
+                                         "sampled", toks, "cu", cu)
+                    # Near-one-hot target: the sampled token's logprob is ~0
+                    # and it is the top-1 entry.
+                    lp = np.asarray(lpl.logprobs)[a:b]
+                    assert (lp[:, 0] > -1e-2).all(), lp[:, :3]
+                    assert (lpl.logprob_token_ids[a:b, 1] ==
+                            lpl.logprob_token_ids[a:b, 0]).all()
+                assert 1 <= len(toks) <= drafts + 1, (toks, drafts)
+                computed[rid] -= drafts + 1 - len(toks)
+                generated[rid].extend(toks)
+                step_counts.append(len(toks))
+            return res
+
+        new = [
+            NewRequestData(req_id=rid,
+                           prompt_token_ids=prompt,
+                           mm_features=[],
+                           sampling_params=sp,
+                           pooling_params=None,
+                           block_ids=([1, 2, 3, 4], [5, 6, 7, 8]),
+                           num_computed_tokens=0,
+                           lora_request=None)
+            for rid, (_, prompt) in REQS.items()
+        ]
+        so0 = sched(new=new, n=len(PROMPT))
+        assert runner.execute_model(so0) is None
+        pending.append((runner.sample_tokens(None), 0, so0))
+        computed = {rid: len(PROMPT) for rid in RIDS}
+        first = None
+        steps = 0
+        while (max(len(g) for g in generated.values()) + 1 + K <= MAX_TOKENS
+               and steps < 12):
+            steps += 1
+            # Scheduler assumes all in-flight drafts accepted (placeholders).
+            n = 1 + K
+            # vLLM: num_output_tokens = outputs + in-flight placeholders
+            # (1 + drafts per unprocessed step).
+            placeholders = sum(d + 1 for _, d, _ in pending)
+            so = sched(cached=cached(
+                computed,
+                {r: len(generated[r]) + placeholders
+                 for r in RIDS}),
+                       n=n,
+                       spec_toks=[-1] * K)
+            import logging, time
+            if steps >= 4:
+                print(f"STEP {steps} BEGIN", flush=True)
+            t0 = time.perf_counter()
+            assert runner.execute_model(so) is None
+            pending.append((runner.sample_tokens(None), K, so))
+            if steps >= 4:
+                print(f"STEP {steps} END host {1e3*(time.perf_counter()-t0):.1f} ms", flush=True)
+            for r in RIDS:
+                computed[r] += n
+            res = drain_one()
+            if first is None:
+                first = res
+        while pending:
+            drain_one()
+
+        for rid, (_, prompt) in REQS.items():
+            ref = []
+            x, t = prompt[-1], len(prompt) - 1
+            for _ in range(len(generated[rid])):
+                x = (x * 7 + t) % 129280
+                ref.append(x)
+                t += 1
+            if jax.process_index() == 0:
+                print(rid, "generated", generated[rid])
+            assert generated[rid] == ref, (rid, generated[rid], ref)
+            if not sample_mode:
+                plp = first.prompt_logprobs_dict.get(rid)
+                assert plp is not None and plp.logprobs.shape[0] == len(
+                    prompt) - 1, plp
+        if jax.process_index() == 0:
+            print("tokens per step", step_counts)
+        if sample_mode:
+            print(f"proc {jax.process_index()} TRACE OK (sample)", flush=True)
+            return
+        # Both full acceptance (k+1) and rejection (<k+1) must occur.
+        assert max(step_counts) == K + 1 and min(step_counts[2:]) < K + 1, \
+            step_counts
+        print(f"proc {jax.process_index()} TRACE OK", flush=True)
+
+
+if __name__ == "__main__":
+    if len(sys.argv) == 2:
+        main_driver(sys.argv[1])
+    else:
+        worker(sys.argv[1], int(sys.argv[2]))
