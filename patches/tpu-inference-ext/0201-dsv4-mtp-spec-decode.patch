+"""CPU test of the DeepSeek V4 MTP proposer glue under attention DP.
+
+Runs the real ``DeepseekV4MtpProposer`` (prepare_inputs + propose, k=3) and
+the real ``VllmModelWrapper`` draft step on a 4-device CPU mesh (attn_dp=4,
+one request per rank) with a toy torch draft model in place of the DSV4 MTP
+layer. The toy reads its own layer's entry of the GroupedAttentionMetadata,
+writes ``input_id + 1`` into its KV cache at the block-table slot of each
+token, and drafts ``g(input_id, position, argmax(hidden))``. The test checks
+the drafted tokens and the KV writes against a Python model of MTP chaining
+with per-rank rejection counts 0..3, and that the proposer picked the MTP
+layer's KV-cache group (not the last one) and its DP-ordered block table.
+
+Needs ``XLA_FLAGS=--xla_force_host_platform_device_count=4`` (or more) and
+``NEW_MODEL_DESIGN=1``.
+"""
+import os
+from types import SimpleNamespace
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+import torch
+from jax.sharding import NamedSharding
+from jax.sharding import PartitionSpec as P
+from torchax.interop import jax_view, torch_view
+from vllm.forward_context import get_forward_context
+
+from tpu_inference.layers.common.attention_metadata import (
+    AttentionMetadata, GroupedAttentionMetadata)
+from tpu_inference.layers.common.sharding import (MESH_AXIS_NAMES,
+                                                  ShardingAxisName)
+from tpu_inference.models.vllm.vllm_model_wrapper_context import \
+    get_vllm_model_wrapper_context
+
+DP = 4
+K = 3
+V = 16  # vocab == hidden size of the toy
+BS = 4  # KV block size
+MAX_BLOCKS = 4  # per request
+NUM_BLOCKS = 4  # per rank
+T_LOCAL = 4  # verify tokens per rank (1 req x (K + 1))
+MTP_LAYER = "model.layers.43.attn.swa_cache"
+OTHER_LAYER = "model.layers.0.attn.swa_cache"
+
+pytestmark = pytest.mark.skipif(
+    jax.device_count() < DP or os.environ.get("NEW_MODEL_DESIGN") != "1",
+    reason="needs >=4 (CPU) devices and NEW_MODEL_DESIGN=1")
+
+
+def g(token, position, hidden_argmax):
+    return (token * 3 + position + hidden_argmax) % V
+
+
+class ToyMTP(torch.nn.Module):
+
+    def __init__(self):
+        super().__init__()
+        self.bias = torch.nn.Parameter(torch.zeros(V), requires_grad=False)
+
+    def forward(self,
+                input_ids,
+                positions,
+                hidden_states,
+                intermediate_tensors=None,
+                inputs_embeds=None,
+                spec_step_idx=0):
+        md = get_forward_context().attn_metadata[MTP_LAYER]
+        ctx = get_vllm_model_wrapper_context()
+        idx = ctx.layer_name_to_kvcache_index[MTP_LAYER]
+
+        def write(ids, pos, qsl, bt, dist, cache):
+            t = jnp.arange(ids.shape[0])
+            n = dist[2]
+            req = jnp.searchsorted(qsl[1:], t, side="right")
+            valid = t < qsl[n]
+            req = jnp.minimum(req, bt.shape[0] // MAX_BLOCKS - 1)
+            slot = bt[req * MAX_BLOCKS + pos // BS] * BS + pos % BS
+            slot = jnp.where(valid, slot, cache.shape[0])
+            return cache.at[slot].set(ids + 1, mode="drop")
+
+        data = P(ShardingAxisName.ATTN_DATA)
+        ctx.kv_caches[idx] = jax.shard_map(
+            write,
+            mesh=ctx.mesh,
+            in_specs=(data, ) * 6,
+            out_specs=data,
+        )(jax_view(input_ids), jax_view(positions), md.query_start_loc,
+          md.block_tables, md.request_distribution, ctx.kv_caches[idx])
+
+        hidden_argmax = torch.argmax(hidden_states, dim=-1)
+        nxt = (input_ids * 3 + positions + hidden_argmax) % V
+        return torch.nn.functional.one_hot(nxt, V).to(
+            torch.float32) * 10 + self.bias
+
+    def compute_logits(self, hidden_states):
+        return hidden_states
+
+
+def _mesh():
+    shape = [1] * len(MESH_AXIS_NAMES)
+    shape[MESH_AXIS_NAMES.index("attn_dp")] = DP
+    devices = np.array(jax.devices()[:DP]).reshape(shape)
+    return jax.sharding.Mesh(devices, MESH_AXIS_NAMES)
+
+
+def _put(mesh, x, spec):
+    return jax.device_put(np.asarray(x), NamedSharding(mesh, spec))
+
+
+def test_dsv4_mtp_proposer_dp_chaining():
+    from tpu_inference.models.vllm.vllm_model_wrapper import (
+        VllmModelWrapper, _VllmRunner)
+    from tpu_inference.spec_decode.jax.dsv4_mtp import DeepseekV4MtpProposer
+
+    mesh = _mesh()
+    data = P(ShardingAxisName.ATTN_DATA)
+    rng = np.random.default_rng(0)
+
+    # ---------------------------------------------------------- draft model
+    spec_config = SimpleNamespace(
+        method="mtp",
+        num_speculative_tokens=K,
+        draft_model_config=SimpleNamespace(hf_config=SimpleNamespace(
+            num_hidden_layers=43, num_nextn_predict_layers=1)),
+        use_gemma4_mtp=lambda: False)
+    vllm_config = SimpleNamespace(
+        speculative_config=spec_config,
+        cache_config=SimpleNamespace(block_size=BS),
+        model_config=SimpleNamespace(seed=0),
+        lora_config=None,
+        compilation_config=SimpleNamespace(static_forward_context={}),
+        parallel_config=SimpleNamespace(data_parallel_size=1),
+    )
+    wrapper = VllmModelWrapper.__new__(VllmModelWrapper)
+    wrapper.vllm_config = vllm_config
+    wrapper.mesh = mesh
+    wrapper.is_draft_model = True
+    wrapper.model = _VllmRunner(ToyMTP())
+    params = {"vllm_model.bias": _put(mesh, np.zeros(V, np.float32), P())}
+
+    kv_caches = [
+        _put(mesh, np.zeros(DP * NUM_BLOCKS * BS, np.int32), data)
+        for _ in range(2)
+    ]
+    runner = SimpleNamespace(
+        mesh=mesh,
+        max_num_tokens=DP * T_LOCAL,
+        max_model_len=MAX_BLOCKS * BS,
+        kv_cache_config=SimpleNamespace(kv_cache_groups=[
+            SimpleNamespace(layer_names=[OTHER_LAYER]),
+            SimpleNamespace(layer_names=[MTP_LAYER]),
+            SimpleNamespace(layer_names=["model.layers.2.attn"]),
+        ]),
+        layer_name_to_kvcache_index={
+            OTHER_LAYER: 0,
+            MTP_LAYER: 1
+        },
+    )
+    # set_forward_context needs a real-ish VllmConfig only for DP metadata,
+    # which the toy does not use.
+    import vllm.forward_context as fc
+    orig_set_forward_context = fc.set_forward_context
+
+    from contextlib import contextmanager
+
+    @contextmanager
+    def _set_forward_context(attn_metadata, vllm_config, num_tokens=None):
+        prev = fc._forward_context
+        fc._forward_context = SimpleNamespace(attn_metadata=attn_metadata)
+        try:
+            yield
+        finally:
+            fc._forward_context = prev
+
+    import tpu_inference.models.vllm.vllm_model_wrapper as wrapper_module
+    wrapper_module.set_forward_context = _set_forward_context
+    try:
+        # Same program without the TPU-only compiler options.
+        cpu_propose = jax.jit(DeepseekV4MtpProposer._propose_dsv4.__wrapped__,
+                              static_argnums=(0, 7, 8))
+
+        class CpuProposer(DeepseekV4MtpProposer):
+            _propose_dsv4 = cpu_propose
+
+        proposer = CpuProposer.__new__(CpuProposer)
+        # Eagle3Proposer.__init__ minus vLLM config plumbing.
+        proposer.vllm_config = vllm_config
+        proposer.speculative_config = spec_config
+        proposer.draft_model_config = spec_config.draft_model_config
+        proposer.method = "mtp"
+        proposer.runner = runner
+        proposer.mesh = mesh
+        proposer.num_speculative_tokens = K
+        proposer.block_size = BS
+        proposer.max_num_tokens = runner.max_num_tokens
+        proposer.token_arange = jnp.arange(runner.max_num_tokens)
+        proposer.constant_draft_positions = False
+        proposer._draft_gid = None
+        proposer._draft_layer_names = None
+        proposer.model_fn = wrapper.jit_step_func()
+        proposer.compute_logits_fn = wrapper.jit_compute_logits_func()
+        proposer.state_leaves = params
+
+        # ------------------------------------------------ target step
+        p0 = np.array([5, 6, 7, 8])  # first verify position per rank
+        rejected = np.array([0, 1, 2, 3])
+        target_ids = rng.integers(0, V, size=(DP, T_LOCAL))
+        aux_argmax = rng.integers(0, V, size=(DP, T_LOCAL))
+        bonus = rng.integers(0, V, size=DP)
+        positions = (p0[:, None] + np.arange(T_LOCAL)[None]).reshape(-1)
+        aux = np.zeros((DP * T_LOCAL, V), np.float32)
+        aux[np.arange(DP * T_LOCAL), aux_argmax.reshape(-1)] = 5.0
+        # DP-ordered block tables: rank-local block ids, distinct per group.
+        bt_mtp = np.stack([rng.permutation(NUM_BLOCKS) for _ in range(DP)])
+        bt_other = np.stack([rng.permutation(NUM_BLOCKS) for _ in range(DP)])
+
+        def md(bt):
+            return AttentionMetadata(
+                input_positions=_put(mesh, positions, data),
+                block_tables=_put(mesh, bt.reshape(-1), data),
+                seq_lens=_put(mesh, p0 + T_LOCAL, data),
+                query_start_loc=_put(mesh, np.tile([0, T_LOCAL], DP), data),
+                request_distribution=_put(mesh, np.tile([0, 0, 1], DP), data),
+                padded_num_reqs=DP,
+            )
+
+        target_md = GroupedAttentionMetadata(
+            groups=(md(bt_other), md(bt_mtp), md(bt_other)),
+            layer_names_per_group=((OTHER_LAYER, ), (MTP_LAYER, ),
+                                   ("model.layers.2.attn", )),
+        )
+        (target_hidden, draft_ids_in, last_idx,
+         draft_md) = proposer.prepare_inputs(
+             target_md,
+             _put(mesh, target_ids.reshape(-1), data),
+             (_put(mesh, aux, P(ShardingAxisName.ATTN_DATA, None)), ),
+             _put(mesh, bonus, data),
+             _put(mesh, np.zeros(DP, np.int32), data),
+             _put(mesh, np.zeros(DP, np.int32), data),
+             _put(mesh, rejected, data),
+             _put(mesh, np.ones(DP, np.int32), data),
+         )
+        assert proposer._draft_gid == 1
+        kv_out, drafts = proposer.propose(kv_caches, draft_ids_in, draft_md,
+                                          last_idx, target_hidden)
+        drafts = np.asarray(drafts)
+        kv_mtp = np.asarray(kv_out[1]).reshape(DP, NUM_BLOCKS * BS)
+        kv_other = np.asarray(kv_out[0])
+    finally:
+        wrapper_module.set_forward_context = orig_set_forward_context
+
+    assert drafts.shape == (DP, K)
+    assert not kv_other.any(), "draft wrote into another layer's cache"
+    for r in range(DP):
+        accepted = T_LOCAL - rejected[r]
+        last = accepted - 1
+        inputs = [int(target_ids[r, i + 1]) for i in range(last)
+                  ] + [int(bonus[r])]
+        expected_kv = {}
+        for i in range(accepted):
+            expected_kv[p0[r] + i] = inputs[i] + 1
+        d = [g(int(bonus[r]), p0[r] + last, int(aux_argmax[r, last]))]
+        for j in range(1, K):
+            expected_kv[p0[r] + last + j] = d[-1] + 1
+            d.append(g(d[-1], p0[r] + last + j, d[-1]))
+        assert drafts[r].tolist() == d, (r, drafts[r], d)
+        for pos, value in expected_kv.items():
+            slot = bt_mtp[r, pos // BS] * BS + pos % BS
+            assert kv_mtp[r, slot] == value, (r, pos, kv_mtp[r], value)
+        assert int((kv_mtp[r] != 0).sum()) == len(expected_kv), (r, kv_mtp[r])
+
+
+def test_manager_passes_grouped_metadata_and_host_logits_indices():
+    """SpeculativeDecodingManager glue for the DSV4 MTP drafter.
+
+    * propose_eagle3_draft_token_ids must hand the drafter the full
+      GroupedAttentionMetadata (it picks its own KV group); the generic path
+      collapses it to the first layer's entry, i.e. another group's tables.
+    * get_spec_decode_metadata must keep a host copy of the final logits
+      indices: the runner writes it into its host buffer, and the device copy
+      spans every host's devices (not readable on multi-host).
+    """
+    from tpu_inference.runner.speculative_decoding_manager import \
+        SpeculativeDecodingManager
+    from tpu_inference.spec_decode.jax.dsv4_mtp import DeepseekV4MtpProposer
+
+    mesh = _mesh()
+    data = P(ShardingAxisName.ATTN_DATA)
+    seen = {}
+
+    class FakeDrafter(DeepseekV4MtpProposer):
+
+        def __init__(self):
+            pass
+
+        def prepare_inputs(self, attn_metadata, *args):
+            seen["md"] = attn_metadata
+            return "h", "ids", "last", "dmd"
+
+        def propose(self, kv_caches, **kwargs):
+            return kv_caches, jnp.zeros((DP, K), jnp.int32)
+
+    runner = SimpleNamespace(
+        drafter=FakeDrafter(),
+        speculative_config=SimpleNamespace(method="mtp",
+                                           num_speculative_tokens=K),
+        input_batch=SimpleNamespace(req_ids=[f"r{i}" for i in range(DP)]),
+        requests={},
+        dp_size=DP,
+        max_num_reqs=DP,
+        mesh=mesh,
+        kv_caches=["kv"],
+        arange_cpu=np.arange(64),
+    )
+    manager = SpeculativeDecodingManager(runner)
+
+    def md(tag):
+        return AttentionMetadata(
+            input_positions=_put(mesh, np.zeros(DP * T_LOCAL, np.int32),
+                                 data),
+            block_tables=_put(mesh, np.full(DP * MAX_BLOCKS, tag, np.int32),
+                              data),
+            seq_lens=_put(mesh, np.zeros(DP, np.int32), data),
+            query_start_loc=_put(mesh, np.zeros(2 * DP, np.int32), data),
+            request_distribution=_put(mesh, np.zeros(3 * DP, np.int32),
+                                      data),
+            padded_num_reqs=DP,
+        )
+
+    grouped = GroupedAttentionMetadata(
+        groups=(md(0), md(1)),
+        layer_names_per_group=((OTHER_LAYER, ), (MTP_LAYER, )))
+    # The runner calls these under jax.set_mesh (PartitionSpec placements).
+    mesh_ctx = jax.set_mesh(mesh)
+    mesh_ctx.__enter__()
+    spec_md = manager.get_spec_decode_metadata(
+        num_draft_tokens_dp=np.full(DP, K, np.int32),
+        dp_size=DP,
+        req_indices_dp={r: [r]
+                        for r in range(DP)},
+        req_ids_dp={r: [f"r{r}"]
+                    for r in range(DP)},
+        query_start_loc=np.tile([0, T_LOCAL], DP),
+        padded_num_reqs_per_dp_rank=1,
+        padded_logits_length_dp_rank=T_LOCAL,
+        max_num_reqs_per_dp_rank=1,
+    )
+    assert isinstance(spec_md.final_logits_indices_cpu, np.ndarray)
+    np.testing.assert_array_equal(spec_md.final_logits_indices_cpu,
+                                  np.tile(np.arange(T_LOCAL), DP))
+
+    out = manager.propose_eagle3_draft_token_ids(
+        spec_md, None, None, [], [jnp.zeros((DP * T_LOCAL, V))], grouped,
+        SimpleNamespace(num_scheduled_tokens={}), None, True, None)
+    mesh_ctx.__exit__(None, None, None)
+    assert seen["md"] is grouped
+    assert out.shape == (DP, K)
