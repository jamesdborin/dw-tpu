+"""DeepSeek V4 MTP wrapper math vs the DeepSeek reference (CPU, torchax).
+
+The decoder block is stubbed (identity on the hc streams) so this checks only
+the MTP-specific parts: position-0 embedding mask, enorm, per-stream hnorm,
+``h_proj(h) + e_proj(e)[:, None]``, the MTP layer's own hc_head + norm, and
+the checkpoint-name mapping.
+"""
+import math
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+import torch
+import torch.nn.functional as F
+import torchax
+from torchax.interop import jax_view, torch_view
+
+HIDDEN, HC, VOCAB, EPS = 64, 4, 96, 1e-6
+
+
+def ref_rmsnorm(x, w, eps=EPS):
+    x32 = x.float()
+    y = x32 * torch.rsqrt(x32.square().mean(-1, keepdim=True) + eps)
+    return (w.float() * y).to(x.dtype)
+
+
+def ref_hc_head(x, fn, scale, base, eps=EPS):
+    # DeepSeek model.py ParallelHead.hc_head, x: [T, hc, d]
+    shape, dtype = x.size(), x.dtype
+    xf = x.flatten(1).float()
+    rsqrt = torch.rsqrt(xf.square().mean(-1, keepdim=True) + eps)
+    mixes = F.linear(xf, fn) * rsqrt
+    pre = torch.sigmoid(mixes * scale + base) + eps
+    return torch.sum(pre.unsqueeze(-1) * xf.view(shape), dim=1).to(dtype)
+
+
+class StubBlock(torch.nn.Module):
+
+    def __init__(self, *args, **kwargs):
+        super().__init__()
+
+    def forward(self, x, positions, input_ids, *args):
+        return x, None, None, None
+
+
+@pytest.fixture
+def mtp_layer():
+    from vllm.config import VllmConfig, set_current_vllm_config
+
+    from tpu_inference.models.vllm.experimental import deepseek_v4_mtp
+    config = SimpleNamespace(hidden_size=HIDDEN,
+                             rms_norm_eps=EPS,
+                             hc_eps=EPS,
+                             hc_mult=HC,
+                             vocab_size=VOCAB)
+    from vllm.platforms import current_platform
+    with mock.patch.object(type(current_platform), "check_and_update_config"):
+        vllm_config = VllmConfig()
+    vllm_config.model_config = SimpleNamespace(hf_config=config)
+    vllm_config.quant_config = None
+    with set_current_vllm_config(vllm_config), mock.patch.object(
+            deepseek_v4_mtp, "DeepseekV4DecoderLayer", StubBlock), \
+            mock.patch.object(deepseek_v4_mtp, "ReplicatedLinear",
+                              lambda i, o, **kw: torch.nn.Linear(
+                                  i, o, bias=False)), \
+            mock.patch.object(deepseek_v4_mtp, "ParallelLMHead",
+                              lambda v, h, **kw: torch.nn.Linear(
+                                  h, v, bias=False)):
+        layer = deepseek_v4_mtp.DeepSeekV4MultiTokenPredictorLayer(
+            vllm_config, None, "model.layers.43")
+    g = torch.Generator().manual_seed(0)
+    with torch.no_grad():
+        for p in layer.parameters():
+            p.copy_(torch.randn(p.shape, generator=g) * 0.5)
+        layer.hc_head_scale.fill_(0.7)
+    return layer
+
+
+def test_mtp_wrapper_matches_reference(mtp_layer):
+    layer = mtp_layer
+    T = 6
+    g = torch.Generator().manual_seed(1)
+    emb = torch.randn(T, HIDDEN, generator=g)
+    prev = torch.randn(T, HC * HIDDEN, generator=g) * 3
+    positions = torch.tensor([0, 1, 2, 7, 0, 9])
+    input_ids = torch.arange(T)
+
+    # Reference (DeepSeek model.py MTPBlock, with vLLM's pos==0 mask).
+    e = torch.where(positions[:, None] == 0, torch.zeros_like(emb), emb)
+    e = ref_rmsnorm(e, layer.enorm.weight)
+    h = ref_rmsnorm(prev.view(T, HC, HIDDEN), layer.hnorm.weight)
+    x = F.linear(e, layer.e_proj.weight).unsqueeze(1) + F.linear(
+        h, layer.h_proj.weight)
+    ref_out = x.flatten(1)
+    ref_head_in = ref_rmsnorm(
+        ref_hc_head(x, layer.hc_head_fn, layer.hc_head_scale,
+                    layer.hc_head_base), layer.shared_head.norm.weight)
+
+    from vllm.ir import enable_torch_wrap
+    with torchax.default_env(), enable_torch_wrap(False):
+        layer_j = __import__("copy").deepcopy(layer).to("jax")
+        out = layer_j(input_ids.to("jax"), positions.to("jax"),
+                      prev.to("jax"), emb.to("jax"))
+        head_in = layer_j.pre_head(out)
+        out = torch.from_numpy(
+            __import__("numpy").asarray(jax_view(out).astype("float32")))
+        head_in = torch.from_numpy(
+            __import__("numpy").asarray(
+                jax_view(head_in).astype("float32")))
+    torch.testing.assert_close(out, ref_out, rtol=1e-5, atol=1e-5)
+    # The TPU hc_head op returns bf16.
+    torch.testing.assert_close(head_in, ref_head_in, rtol=2e-2, atol=2e-2)
+    # The pos==0 rows really were masked (differ from the unmasked result).
+    unmasked = F.linear(ref_rmsnorm(emb, layer.enorm.weight),
+                        layer.e_proj.weight)
+    assert not torch.allclose(
+        ref_out.view(T, HC, HIDDEN)[0] -
+        F.linear(h[0], layer.h_proj.weight), unmasked[0].expand(HC, -1))
+
+
+def test_checkpoint_name_mapping():
+    from tpu_inference.models.vllm.experimental.deepseek_v4_mtp import \
+        DeepSeekV4MTP
+    m = DeepSeekV4MTP.__new__(DeepSeekV4MTP)
+    torch.nn.Module.__init__(m)
+    m.config = SimpleNamespace(expert_dtype="fp4")
+    m.model = SimpleNamespace(num_mtp_layers=1, mtp_start_layer_idx=43)
+    f = m.checkpoint_name_to_param_name
+    assert f("layers.3.attn.wkv.weight") is None
+    assert f("mtp.1.enorm.weight") is None
+    assert f("head.weight") is None and f("embed.weight") is None
+    assert f("mtp.0.enorm.weight") == "model.layers.43.enorm.weight"
+    assert f("mtp.0.norm.weight") == "model.layers.43.shared_head.norm.weight"
+    assert f("mtp.0.e_proj.scale") == "model.layers.43.e_proj.weight_scale_inv"
+    assert f("mtp.0.hc_head_fn") == "model.layers.43.hc_head_fn"
+    assert f("mtp.0.attn_norm.weight") == \
+        "model.layers.43.mtp_block.attn_norm.weight"
+    assert f("mtp.0.attn.kv_norm.weight") == \
+        "model.layers.43.mtp_block.attn.kv_norm.weight"
+    assert f("mtp.0.hc_attn_fn") == "model.layers.43.mtp_block.hc_attn_fn"
+    assert f("mtp.0.ffn.experts.7.w2.scale") == \
+        "model.layers.43.mtp_block.ffn.experts.7.w2.weight_scale"
+    assert f("mtp.0.ffn.shared_experts.w2.scale") == \
+        "model.layers.43.mtp_block.ffn.shared_experts.down_proj.weight_scale_inv"
+    assert f("mtp.0.ffn.gate.bias") == \
+        "model.layers.43.mtp_block.ffn.gate.e_score_correction_bias"
