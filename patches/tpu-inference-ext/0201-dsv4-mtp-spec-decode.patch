+"""Batch-prefill admission with DP_SCHED_BATCH_PREFILL_IDLE_FLUSH=0."""
+from types import SimpleNamespace
+from unittest import mock
+
+from tpu_inference.core.sched import dp_scheduler
+from tpu_inference.core.sched.dp_scheduler import DPScheduler
+
+DP = 4
+
+
+def make(idle_flush, max_wait_ms, idle_ranks):
+    s = DPScheduler.__new__(DPScheduler)
+    s.dp_size = DP
+    s._batch_prefills = True
+    s._batch_prefill_threshold = DP
+    s._batch_prefill_flush_timeout_ms = 30000
+    s._batch_prefill_last_flush = 1000.0
+    s._batch_prefill_idle_flush = idle_flush
+    s._batch_prefill_max_wait_ms = max_wait_ms
+    s._batch_prefill_pending_since = 0.0
+    s._pending_new_requests = []
+    s.cached_schedulers_output = [[
+        SimpleNamespace(total_num_scheduled_tokens=0 if r < idle_ranks else 4)
+        for r in range(DP)
+    ]]
+    s.flushed = []
+
+    def flush():
+        s.flushed.append(len(s._pending_new_requests))
+        s._pending_new_requests = []
+        s._batch_prefill_last_flush = clock[0]
+
+    s._flush_pending = flush
+    return s
+
+
+clock = [1000.0]
+
+
+def add(s, n=1):
+    for _ in range(n):
+        with mock.patch.object(dp_scheduler, "time", lambda: clock[0]):
+            if not s._pending_new_requests:
+                s._batch_prefill_pending_since = clock[0]
+            s._pending_new_requests.append(object())
+            s._try_flush_pending()
+
+
+def tick(s, dt_ms):
+    clock[0] += dt_ms / 1000.0
+    with mock.patch.object(dp_scheduler, "time", lambda: clock[0]):
+        s._try_flush_pending()
+
+
+def test_default_idle_trigger_admits_one_by_one():
+    s = make(True, 0, idle_ranks=1)
+    add(s)
+    assert s.flushed == [1]
+
+
+def test_wait_for_threshold_when_idle_flush_disabled():
+    s = make(False, 2000, idle_ranks=1)
+    add(s, DP - 1)
+    tick(s, 100)
+    assert s.flushed == []  # one idle rank no longer admits a lone request
+    add(s)
+    assert s.flushed == [DP]  # whole turn admitted together
+
+
+def test_max_wait_bounds_the_delay():
+    s = make(False, 2000, idle_ranks=2)
+    add(s, 2)
+    tick(s, 1999)
+    assert s.flushed == []
+    tick(s, 2)
+    assert s.flushed == [2]
+
+
+def test_all_ranks_idle_flushes_after_grace():
+    s = make(False, 2000, idle_ranks=DP)
+    add(s)
+    assert s.flushed == []
+    tick(s, 60)
+    assert s.flushed == [1]
