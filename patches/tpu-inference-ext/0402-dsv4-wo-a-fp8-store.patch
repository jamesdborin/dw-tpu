+    dequantize_linear_weight
 from tpu_inference.layers.common.sharding import ShardingAxisName
 from tpu_inference.layers.vllm.custom_ops.experimental.deepseek_v4.deepseek_v4_compressor import \
     VllmDeepseekCompressor
@@ -251,6 +253,11 @@ class VllmDeepseekV4MLAAttention(DeepseekV4Attention):
         mesh = get_vllm_model_wrapper_context().mesh
         wo_a = jax_view(self.wo_a.weight)
         wo_a_scale = jax_view(self.wo_a.weight_scale)
+        if getattr(self.wo_a, "wo_a_fp8_store", False):
+            # DSV4_WO_A_FP8_STORE: the same exact bf16 weight the load-time
+            # path stores, rebuilt per call from fp8 + power-of-two scales.
+            wo_a = dequantize_linear_weight(wo_a, wo_a_scale)
+            wo_a_scale = jnp.ones((wo_a.shape[1], ), jnp.float32)
         # wo_a is kept as exact bf16 (VllmDeepseekV4WoALinearMethod), as in
         # the reference model; only an fp8 wo_a quantizes the activations.
         quantize_activations = wo_a.dtype != jnp.bfloat16
