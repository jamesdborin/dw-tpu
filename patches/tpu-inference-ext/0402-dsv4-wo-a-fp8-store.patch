+"""Exact bf16 dequantization of a processed fp8 linear weight.
+
+Shared by the DeepSeek-V4 ``wo_a`` load-time conversion and, with
+DSV4_WO_A_FP8_STORE=1, its per-call conversion, so both produce the same bf16
+values from the same fp8 weight and power-of-two scales.
+"""
+
+import jax
+import jax.numpy as jnp
+
+
+def dequantize_linear_weight(w: jax.Array, s: jax.Array) -> jax.Array:
+    """Exact bf16 copy of a processed [in, out] fp8 linear weight."""
+    k, n = w.shape
+    w = w.astype(jnp.float32)
+    if s.ndim == 1:  # per output channel
+        w = w * s[None, :]
+    elif s.ndim == 2:  # [in_blocks, out_blocks] (requantization disabled)
+        kb, nb = s.shape
+        w = (w.reshape(kb, k // kb, nb, n // nb) *
+             s[:, None, :, None]).reshape(k, n)
+    else:  # [(1,) in_blocks, 1, out]: block quantized-matmul kernel layout
+        s = s.reshape(-1, n)
+        w = (w.reshape(s.shape[0], -1, n) * s[:, None, :]).reshape(k, n)
+    return w.astype(jnp.bfloat16)
