         if not bool(jnp.all(scale_bf16.astype(jnp.float32) == scale)):
             logger.warning_once(
@@ -699,8 +714,10 @@ def shard_moe_weights(
         key = field.name
         if (weight := getattr(weights, key, None)) is not None:
             layout = getattr(weight_layouts, key)
