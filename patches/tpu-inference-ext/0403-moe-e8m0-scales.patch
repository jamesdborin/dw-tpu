     MOE_HIERARCHICAL_COLLECT: bool = False
@@ -607,6 +608,13 @@ environment_variables: dict[str, Callable[[], Any]] = {
     # transient per call). Bit-identical.
     "DSV4_WO_A_FP8_STORE":
     env_bool("DSV4_WO_A_FP8_STORE", default=False),
+    # Store requantized FP4 routed-expert block scales as uint8 exponent codes
