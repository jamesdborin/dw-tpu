+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Expert split for GMM_TP (MOE_TP_EXPERT_SPLIT).
+
+GMM_TP gives every one of the ``tp`` shards a 1/tp slice of every expert's
+intermediate dimension. When that slice is narrower than 128 lanes (DeepSeek
+V4 Flash on 32 chips: 2048 / 32 = 64), the fused gate/up GMM needs each half
+padded to 128 lanes, so half the w13 bytes every shard streams are zeros and
+the w2 GMM contracts a 64-deep K with a 128-deep tile.
+
+With split S, the experts are divided into S groups of E/S and each group is
+tensor-sharded over tp/S shards: shard c holds experts
+[(c // (tp/S)) * E/S, +E/S) and intermediate columns
+[(c % (tp/S)) * I*S/tp, +I*S/tp) of each of them. The weights keep the GMM_TP
+shapes and shardings (experts unsharded, intermediate on MLP_TENSOR), with E/S
+instead of E experts. Every shard still sees every token after the dispatch
+all-gather, runs its local experts only (group_offset), and the output
+reduce-scatter adds the partial sums exactly as before. Only the grouping of
+the partial sums changes (reduction order).
+"""
+
+import jax
+import jax.numpy as jnp
+
+
+def split_local_intermediate(intermediate_size: int, tp: int, split: int) -> int:
+    return intermediate_size * split // tp
+
+
+def split_supported(num_experts: int, intermediate_size: int, tp: int,
+                    split: int, align: int = 128) -> bool:
+    return (split > 1 and tp % split == 0 and num_experts % split == 0
+            and (intermediate_size * split) % tp == 0
+            and split_local_intermediate(intermediate_size, tp, split) %
+            align == 0)
+
+
+def _split_w13_cols(t, *, tp, split, local, padded_local):
+    """[E, ..., tp * 2 * padded_local] GMM_TP w13 columns -> [E/S, ..., tp * 2 * L'].
+
+    Input shard c holds [w1 cols c*local.. (+pad) | w3 cols c*local.. (+pad)].
+    """
+    e = t.shape[0]
+    mid = t.shape[1:-1]
+    t = t.reshape(e, *mid, tp, 2, padded_local)[..., :local]  # drop padding
+    # -> [E, ..., 2, I] with I = tp * local in original column order
+    nd = t.ndim
+    t = jnp.moveaxis(t, nd - 3, nd - 2)  # [E, ..., 2, tp, local]
+    t = t.reshape(e, *mid, 2, tp * local)
+    lp = split_local_intermediate(tp * local, tp, split)
+    g = tp // split
+    # [S, E', ..., 2, g, L']
+    t = t.reshape(split, e // split, *mid, 2, g, lp)
+    # target shard c = h * g + s holds [w1 | w3] of expert group h, slice s:
+    # [E', ..., S, g, 2, L']
+    nd = t.ndim
+    perm = (list(range(1, nd - 3)) + [0, nd - 2, nd - 3, nd - 1])
+    t = jnp.transpose(t, perm)
+    return t.reshape(e // split, *mid, tp * 2 * lp)
+
+
+def _split_w2_rows(t, *, tp, split, rows_per_unit):
+    """[E, I_units, ..., H] -> [E/S, I_units, ..., H] with shard c's rows from
+    expert group c // (tp/S), intermediate slice c % (tp/S). ``rows_per_unit``
+    is how many intermediate columns one row of dim 1 covers (1 for weights,
+    the block size for block scales)."""
+    e, units = t.shape[0], t.shape[1]
+    rest = t.shape[2:]
+    g = tp // split
+    per = units // g  # rows of dim 1 per target shard
+    t = t.reshape(split, e // split, g, per, *rest)
+    t = jnp.moveaxis(t, 0, 1)  # [E', S, g, per, ...]
+    return t.reshape(e // split, split * g * per, *rest)
+
+
+def _to_bytes(t):
+    """4-bit arrays -> uint8 [..., n/2] (pairs along the last dim), else as is.
+
+    Moving packed bytes instead of 4-bit elements makes the relayout an
+    ordinary byte copy (XLA CPU handles sub-byte transposes element by element,
+    ~20 s per DeepSeek V4 layer). Every moved run starts at an even element.
+    """
+    if t.dtype not in (jnp.float4_e2m1fn, jnp.uint4, jnp.int4):
+        return t, None
+    return jax.lax.bitcast_convert_type(
+        t.reshape(*t.shape[:-1], t.shape[-1] // 2, 2), jnp.uint8), t.dtype
+
+
+def _from_bytes(t, dtype):
+    if dtype is None:
+        return t
+    return jax.lax.bitcast_convert_type(t, dtype).reshape(*t.shape[:-1],
+                                                           t.shape[-1] * 2)
+
+
+def split_gmm_tp_weights(w13_weight,
+                         w13_weight_scale,
+                         w2_weight,
+                         w2_weight_scale,
+                         *,
+                         tp: int,
+                         split: int,
+                         align: int = 128):
+    """Re-lay GMM_TP-processed MoE weights for MOE_TP_EXPERT_SPLIT=split.
+
+    Shapes in (GMM_TP layout after process_moe_weights):
+      w13_weight       [E, H, tp * 2 * Lp]      (Lp = padded local intermediate)
+      w13_weight_scale [E, H/bk, 1, tp * 2 * Lp]
+      w2_weight        [E, I, H]
+      w2_weight_scale  [E, I/bk2, 1, H]
+    Shapes out: E -> E/S, w13 last dim tp * 2 * L' (= 2 * S * I), w2 dim 1 S * I
+    (= tp * L'); the total number of kept values is unchanged.
+    Pure data movement: every kept value is copied bit for bit.
+    """
+    e = w13_weight.shape[0]
+    intermediate = w2_weight.shape[1]
+    assert split_supported(e, intermediate, tp, split,
+                           align), (e, intermediate, tp, split)
+    local = intermediate // tp
+    padded_local = w13_weight.shape[-1] // (2 * tp)
+    assert padded_local >= local, (padded_local, local)
+    w13_bytes, w13_dtype = _to_bytes(w13_weight)
+    pack = 1 if w13_dtype is None else 2
+    assert local % pack == 0 and padded_local % pack == 0
+    w13 = _from_bytes(
+        _split_w13_cols(w13_bytes,
+                        tp=tp,
+                        split=split,
+                        local=local // pack,
+                        padded_local=padded_local // pack), w13_dtype)
+    w13s = None
+    if w13_weight_scale is not None:
+        assert w13_weight_scale.shape[-1] == w13_weight.shape[-1]
+        w13s = _split_w13_cols(w13_weight_scale,
+                               tp=tp,
+                               split=split,
+                               local=local,
+                               padded_local=padded_local)
+    w2_bytes, w2_dtype = _to_bytes(w2_weight)
+    w2 = _from_bytes(
+        _split_w2_rows(w2_bytes, tp=tp, split=split, rows_per_unit=1),
+        w2_dtype)
+    w2s = None
+    if w2_weight_scale is not None:
+        units = w2_weight_scale.shape[1]
+        assert intermediate % units == 0
+        bk2 = intermediate // units
+        assert split_local_intermediate(intermediate, tp, split) % bk2 == 0
+        w2s = _split_w2_rows(w2_weight_scale,
+                             tp=tp,
+                             split=split,
+                             rows_per_unit=bk2)
+    return w13, w13s, w2, w2s
+
+
+split_gmm_tp_weights_jit = jax.jit(split_gmm_tp_weights,
+                                   static_argnames=("tp", "split", "align"),
+                                   donate_argnums=(0, 1, 2, 3))
