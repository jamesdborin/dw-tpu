+def _tp_split_group_offset(local_experts: int,
+                           num_experts: int) -> jax.Array:
+    """First expert of this shard's group under MOE_TP_EXPERT_SPLIT: shard c of
+    the tp MLP_TENSOR shards holds group c // (tp / split)."""
+    axes = _as_axes(ShardingAxisName.MLP_TENSOR)
+    tp, rank = 1, 0
+    for a in axes:
+        size = jax.lax.axis_size(a)
+        rank = rank * size + jax.lax.axis_index(a)
+        tp *= size
+    split = num_experts // local_experts
+    assert tp % split == 0, (tp, split)
+    group = rank // (tp // split)
+    return jnp.reshape(group * local_experts, (1, )).astype(jnp.int32)
+
