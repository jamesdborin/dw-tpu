diff --git a/tpu_inference/layers/common/process_weights/moe_expert_split.py b/tpu_inference/layers/common/process_weights/moe_expert_split.py
new file mode 100644
index 000000000..795400d30
--- /dev/null
+++ b/tpu_inference/layers/common/process_weights/moe_expert_split.py
@@ -0,0 +1,169 @@
+# Copyright 2026 Google LLC
