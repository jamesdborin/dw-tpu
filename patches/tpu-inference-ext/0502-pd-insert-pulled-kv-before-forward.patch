+def _load_order(scheduler_output):
+    """Order of start_load_kv vs the forward in vLLM's runner mixin."""
+    from vllm.v1.worker import kv_connector_model_runner_mixin as mixin
+
+    events = []
+
+    class Recorder:
+
+        def bind_connector_metadata(self, meta):
+            pass
+
+        def start_load_kv(self, ctx, **kwargs):
+            events.append("start_load_kv")
+
+        def get_transfer_results(self, finished_req_ids):
+            return types.SimpleNamespace(finished_sending=None,
+                                         finished_recving=None,
+                                         failed_recving=None)
+
+        def __getattr__(self, name):
+            return lambda *a, **k: None
+
+    orig = (mixin.get_kv_transfer_group, mixin.get_forward_context,
+            mixin.KVConnectorBase)
+    mixin.get_kv_transfer_group = Recorder
+    mixin.get_forward_context = lambda: None
+    mixin.KVConnectorBase = Recorder
+    try:
+        with mixin.KVConnectorModelRunnerMixin._get_kv_connector_output(
+                scheduler_output):
+            events.append("forward")
+    finally:
+        (mixin.get_kv_transfer_group, mixin.get_forward_context,
+         mixin.KVConnectorBase) = orig
+    return events
+
