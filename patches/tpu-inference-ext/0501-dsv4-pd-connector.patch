index 000000000..b873aa4f9
--- /dev/null
+++ b/pdmini/run_all.sh
@@ -0,0 +1,76 @@
+#!/usr/bin/env bash
+# Host-side orchestration of the P/D mini test. Run as a systemd unit:
+#   sudo systemd-run --unit=dsv4-pdm-job --uid=$(id -u) --gid=$(id -g) --collect \
+#     --property=LimitMEMLOCK=infinity /bin/bash /opt/dsv4/pdmini/run_all.sh <run-dir> [phase ...]
+# Phases (default all, in order): mini probe micro colo pd routing. Each writes <run>/<phase>.done;
+# finished phases are skipped on rerun. Progress: <run>/progress.log.
+set -uo pipefail
+RUN=${1:?run dir}; shift
+PHASES=${*:-mini probe micro colo pd routing}
+K=/opt/dsv4/pdmini; PY=/opt/dsv4/.venv/bin/python
+mkdir -p "$RUN"; cd "$RUN"
+log() { echo "$(date -u +%FT%TZ) $*" | tee -a "$RUN/progress.log"; }
+down() { for u in $(systemctl list-units --plain --no-legend 'dsv4-pdm-*' | awk '{print $1}' | grep -v dsv4-pdm-job); do sudo -n systemctl stop "$u"; done; sleep 3; }
+export BOUNDS=$(cat "$RUN/bounds" 2>/dev/null || echo 1,2,1)
+export PAIRS=$(cat "$RUN/pairs" 2>/dev/null || echo "0,1 2,3 4,5 6,7")
+METRICS="--metrics http://127.0.0.1:8100 http://127.0.0.1:8101 http://127.0.0.1:8200 http://127.0.0.1:8201"
+
+phase_mini() {
+  test -f /opt/dsv4/ckpt/dsv4-flash-5L/model.safetensors.index.json && { log "mini ckpt exists"; return 0; }
+  JAX_PLATFORMS=cpu $PY "$K/build_mini.py" /opt/dsv4/ckpt/dsv4-flash-full /opt/dsv4/ckpt/dsv4-flash-5L.tmp --layers 5 \
+    > "$RUN/build_mini.log" 2>&1 || return 1
+  grep -q "compress_ratios \[0, 0, 4, 128, 4\]" "$RUN/build_mini.log" || { log "unexpected compress_ratios"; return 1; }
+  mv /opt/dsv4/ckpt/dsv4-flash-5L.tmp /opt/dsv4/ckpt/dsv4-flash-5L
+}
+
+phase_probe() {
+  OUT=$RUN/probe bash "$K/chip_probe.sh" coords > "$RUN/probe-coords.txt" 2>&1
+  for b in 1,2,1 2,1,1; do
+    rm -rf "$RUN/probe"; OUT=$RUN/probe bash "$K/chip_probe.sh" pairs "$PAIRS" $b > "$RUN/probe-$b.txt" 2>&1
+    if test "$(grep -c PAIR_OK "$RUN/probe-$b.txt")" = 4; then echo $b > "$RUN/bounds"; export BOUNDS=$b; log "pairs ok with bounds $b"; return 0; fi
+  done
+  log "no working 2-chip bounds for pairs $PAIRS"; return 1
+}
+
+phase_micro() { BOUNDS=$BOUNDS bash "$K/xfer_micro.sh" "$RUN/micro" "${PAIRS%% *}" "$(echo $PAIRS | cut -d' ' -f3)" > "$RUN/micro.txt" 2>&1; }
+
+phase_colo() {
+  down
+  bash "$K/pd_up.sh" "$RUN/colo" colo || return 1
+  $PY "$K/correctness.py" colo --url http://127.0.0.1:8300 --out "$RUN/correct-colo.json" > "$RUN/correct-colo.txt" 2>&1 || return 1
+  $PY "$K/xfer_sweep.py" --url http://127.0.0.1:8300 --mode colo --out "$RUN/colo-sweep.jsonl" > "$RUN/colo-sweep.txt" 2>&1 || return 1
+  down
+}
+
+phase_pd() {
+  down
+  bash "$K/pd_up.sh" "$RUN/pd" pd affinity || return 1
+  $PY "$K/correctness.py" pd --url http://127.0.0.1:8000 --out "$RUN/correct-pd.json" > "$RUN/correct-pd.txt" 2>&1 || return 1
+  $PY "$K/correctness.py" compare "$RUN/correct-colo.json" "$RUN/correct-pd.json" > "$RUN/correctness.txt" 2>&1
+  log "correctness: $(tail -1 "$RUN/correctness.txt")"
+  $PY "$K/xfer_sweep.py" --url http://127.0.0.1:8000 --mode pd --out "$RUN/pd/pd-sweep.jsonl" > "$RUN/pd-sweep.txt" 2>&1 || return 1
+}
+
+agent() {  # label policy seed sessions turns shared context output env
+  curl -sf -XPOST "127.0.0.1:8000/router/policy/$2" >/dev/null || return 1
+  $PY "$K/agent_load.py" --url http://127.0.0.1:8000 --label "$1" --seed "$3" --sessions "$4" --turns "$5" \
+    --shared "$6" --context "$7" --output "$8" --env "$9" $METRICS --out "$RUN/agent.jsonl" >> "$RUN/agent.txt" 2>&1
+}
+
+phase_routing() {
+  curl -sf 127.0.0.1:8000/health >/dev/null || { bash "$K/pd_up.sh" "$RUN/pd" pd affinity || return 1; }
+  agent warm affinity 100 8 3 2048 2048 64 512 || return 1
+  agent aff1 affinity 1 16 6 2048 3072 128 768 || return 1
+  agent rr1 rr 2 16 6 2048 3072 128 768 || return 1
+  agent aff2 affinity 3 32 8 2048 4096 128 1024 || return 1
+  agent rr2 rr 4 32 8 2048 4096 128 1024 || return 1
+}
+
+trap 'down' EXIT
+for ph in $PHASES; do
+  test -f "$RUN/$ph.done" && { log "skip $ph (done)"; continue; }
+  log "start $ph"
+  if "phase_$ph"; then touch "$RUN/$ph.done"; log "done $ph"; else log "FAILED $ph"; echo "$ph" > "$RUN/FAILED"; exit 1; fi
+done
+down
+log "ALL DONE"; touch "$RUN/ALL_DONE"
