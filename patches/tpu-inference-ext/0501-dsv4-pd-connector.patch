+#!/usr/bin/env bash
+# Run pd_check.py on up to two model variants side by side (each = 1 P + 1 D on two chip pairs + a router).
+#   bash variants.sh <outdir> "<tag>:<ckpt>" ["<tag>:<ckpt>"]
+# Variant 0 uses pairs 0 (P) and 1 (D), ports P 8110 / D 8210 / router 8010; variant 1 uses pairs 2, 3 and
+# 8120 / 8220 / 8020. Extra env for the servers: PD_EXTRA_ENV, GPU_MEM, etc. (see pd_up.sh). Each variant writes
+# <outdir>/<tag>/{P,D,router}.log, layout.txt and check.json. Stops its units at the end.
+set -uo pipefail
+OUT=${1:?outdir}; shift
+K=${PDMINI:-/opt/dsv4/pdmini}; PY=/opt/dsv4/.venv/bin/python
+export GPU_MEM=${GPU_MEM:-0.45}
+pids=(); tags=()
+idx=0
+for v in "$@"; do
+  tag=${v%%:*}; ckpt=${v#*:}; d=$OUT/$tag; mkdir -p "$d"; tags+=("$tag")
+  pp=$((2 * idx)); dp=$((2 * idx + 1)); n=$((idx + 1))
+  ( INSTANCES="${tag}P kv_producer $pp 81${n}0 $ckpt;${tag}D kv_consumer $dp 82${n}0 $ckpt" \
+    ROUTER_NAME=${tag}R ROUTER_PORT=80${n}0 KV_PORT_BASE=91${n}0 SIDE_PORT_BASE=96${n}0 \
+    bash "$K/pd_up.sh" "$d" custom affinity > "$d/up.log" 2>&1 \
+    && $PY "$K/pd_check.py" --p "http://127.0.0.1:81${n}0" --d "http://127.0.0.1:82${n}0" \
+         --router "http://127.0.0.1:80${n}0" --label "$tag" --out "$d/check.json" > "$d/check.txt" 2>&1
+    echo "rc=$?" >> "$d/check.txt" ) &
+  pids+=($!); idx=$((idx + 1))
+done
+wait "${pids[@]}"
+for tag in "${tags[@]}"; do
+  for u in "${tag}P" "${tag}D" "${tag}R"; do sudo -n systemctl stop "dsv4-pdm-$u" 2>/dev/null; done
+  echo "== $tag"; tail -3 "$OUT/$tag/check.txt" 2>/dev/null; tail -3 "$OUT/$tag/up.log" 2>/dev/null
+done
+sleep 3
