--- /dev/null
+++ b/tests/distributed/test_tpu_connector_dsv4_sched_cpu.py
@@ -0,0 +1,231 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Scheduler-level trace of TPUConnectorDSV4 with vLLM's real Scheduler and
+DSV4-shaped hybrid cache groups: P (producer) prefills with chunked prefill,
+D (consumer) loads with and without a local prefix hit. Checks that the
+transfer plan only reads P blocks that exist and covers every block D needs.
+
+  JAX_PLATFORMS=cpu python -m pytest -q tests/distributed/test_tpu_connector_dsv4_sched_cpu.py
+"""
+import os
+
+import vllm.platforms as _vp
+
+_vp.builtin_platform_plugins = {
+    "tpu": lambda: "tpu_inference.platforms.tpu_platform.TpuPlatform"
+}
+
+import pytest  # noqa: E402
+import torch  # noqa: E402
+from vllm.config import (CacheConfig, DeviceConfig, KVTransferConfig,  # noqa
+                         ModelConfig, SchedulerConfig, VllmConfig)
+from vllm.sampling_params import SamplingParams  # noqa: E402
+from vllm.utils.hashing import sha256  # noqa: E402
+from vllm.v1.core.kv_cache_utils import (get_request_block_hasher,  # noqa
+                                         init_none_hash)
+from vllm.v1.core.sched.scheduler import Scheduler  # noqa: E402
+from vllm.v1.kv_cache_interface import (KVCacheConfig,  # noqa: E402
+                                        KVCacheGroupSpec, MLAAttentionSpec,
+                                        SlidingWindowMLASpec)
+from vllm.v1.outputs import KVConnectorOutput, ModelRunnerOutput  # noqa
+from vllm.v1.request import Request, RequestStatus  # noqa: E402
+from vllm.v1.structured_output import StructuredOutputManager  # noqa: E402
+
+from tpu_inference.distributed import tpu_connector_dsv4 as c4  # noqa: E402
+
+MODEL = os.environ.get("DSV4_PD_TEST_MODEL", "Qwen/Qwen3-0.6B")
+HASH_BS = 4
+EOS = 50256
+
+
+def _groups():
+
+    def full(bs):
+        return MLAAttentionSpec(block_size=bs, num_kv_heads=1, head_size=64,
+                                dtype=torch.uint8)
+
+    def sw(bs, w):
+        return SlidingWindowMLASpec(block_size=bs, num_kv_heads=1,
+                                    head_size=64, dtype=torch.uint8,
+                                    sliding_window=w)
+
+    return [
+        KVCacheGroupSpec(["l2.attn", "l4.attn"], full(1024)),
+        KVCacheGroupSpec(["l2.attn.indexer.k_cache", "l4.attn.indexer.k_cache"],
+                         full(1024)),
+        KVCacheGroupSpec(["l3.attn"], full(1024)),
+        KVCacheGroupSpec([f"l{i}.attn.swa_cache" for i in range(5)],
+                         sw(64, 128)),
+        KVCacheGroupSpec(["l2.attn.compressor.state_cache",
+                          "l4.attn.compressor.state_cache",
+                          "l2.attn.indexer.compressor.state_cache",
+                          "l4.attn.indexer.compressor.state_cache"],
+                         sw(4, 8)),
+        KVCacheGroupSpec(["l3.attn.compressor.state_cache"], sw(8, 128)),
+    ]
+
+
+def _scheduler(role, mnbt=1024, num_blocks=4000):
+    init_none_hash(sha256)
+    model_config = ModelConfig(model=MODEL, dtype="bfloat16", seed=0)
+    vllm_config = VllmConfig(
+        scheduler_config=SchedulerConfig(
+            max_num_seqs=8, max_num_batched_tokens=mnbt, max_model_len=40000,
+            enable_chunked_prefill=True,
+            is_encoder_decoder=False,
+            disable_hybrid_kv_cache_manager=False),
+        model_config=model_config,
+        cache_config=CacheConfig(block_size=1024, enable_prefix_caching=True),
+        kv_transfer_config=KVTransferConfig(
+            kv_connector="TPUConnectorDSV4",
+            kv_connector_module_path="tpu_inference.distributed."
+            "tpu_connector_dsv4",
+            kv_role=role),
+        device_config=DeviceConfig("cpu"),
+    )
+    vllm_config.cache_config.num_gpu_blocks = num_blocks
+    kv_cache_config = KVCacheConfig(num_blocks=num_blocks,
+                                    kv_cache_tensors=[],
+                                    kv_cache_groups=_groups())
+    return Scheduler(vllm_config=vllm_config,
+                     kv_cache_config=kv_cache_config,
+                     log_stats=True,
+                     structured_output_manager=StructuredOutputManager(
+                         vllm_config),
+                     block_size=1024,
+                     hash_block_size=HASH_BS)
+
+
+_n = [0]
+
+
+def _request(tokens, max_tokens, params=None):
+    _n[0] += 1
+    sp = SamplingParams(max_tokens=max_tokens, ignore_eos=True)
+    sp.update_from_generation_config({}, EOS)
+    r = Request(request_id=f"r{_n[0]}", prompt_token_ids=list(tokens),
+                sampling_params=sp, pooling_params=None, mm_features=None,
+                block_hasher=get_request_block_hasher(HASH_BS, sha256))
+    r.kv_transfer_params = params
+    return r
+
+
+def _step(s, finished_recving=None, finished_sending=None):
+    so = s.schedule()
+    reqs = list(so.num_scheduled_tokens)
+    sampled = []
+    for rid in reqs:
+        r = s.requests[rid]
+        # schedule() has already advanced num_computed_tokens.
+        done = r.num_computed_tokens >= r.num_tokens
+        sampled.append([7] if done else [])
+    out = ModelRunnerOutput(
+        req_ids=reqs, req_id_to_index={r: i for i, r in enumerate(reqs)},
+        sampled_token_ids=sampled, logprobs=None, prompt_logprobs_dict={},
+        pooler_output=[],
+        kv_connector_output=KVConnectorOutput(
+            finished_sending=finished_sending,
+            finished_recving=finished_recving))
+    eco = s.update_from_output(so, out)
+    return so, eco
+
+
+def _run_prefill_on_p(p, tokens):
+    req = _request(tokens, 1, params={"do_remote_decode": True})
+    p.add_request(req)
+    params, send_meta = None, None
+    for _ in range(100):
+        so, eco = _step(p)
+        meta = so.kv_connector_metadata
+        if meta is not None and meta.reqs_to_send:
+            send_meta = meta.reqs_to_send[req.request_id]
+        for o in eco.values():
+            for x in o.outputs:
+                if x.kv_transfer_params:
+                    params = x.kv_transfer_params
+        if params is not None and send_meta is not None:
+            return req, params, send_meta
+    raise AssertionError("P did not finish")
+
+
+def _check_plan(num_tokens, p_ids, d_ids, hit, groups):
+    plan = c4.plan_entries(num_tokens, 1024, groups)
+    needed = c4.entries_needed(num_tokens, 1024, hit, plan)
+    for e in needed:
+        for gid, idxs in plan[e].items():
+            assert idxs[-1] < len(p_ids[gid]), (gid, idxs, len(p_ids[gid]))
+            assert idxs[-1] < len(d_ids[gid]), (gid, idxs, len(d_ids[gid]))
+            for i in idxs:
+                if p_ids[gid][i] == 0:
+                    assert d_ids[gid][i] == 0, (
+                        f"group {gid} block {i}: P freed it, D needs it")
+    # Everything D allocated beyond its hit must come from some entry.
+    for gid, g in enumerate(groups):
+        covered = {i for e in needed for i in plan[e].get(gid, [])}
+        for i, lid in enumerate(d_ids[gid]):
+            if lid != 0 and i * g.block_size >= hit and \
+                    i * g.block_size < num_tokens:
+                assert i in covered, f"group {gid} block {i} not transferred"
+
+
+@pytest.mark.parametrize("align", [None, 4, 128, 1024])
+@pytest.mark.parametrize("num_tokens,d_prefix", [(5000, 0), (3000, 0),
+                                                 (5000, 2048), (700, 0),
+                                                 (9300, 4096), (4096, 0)])
+def test_pd_flow(num_tokens, d_prefix, align):
+    p = _scheduler("kv_producer", mnbt=1024)
+    d = _scheduler("kv_consumer", mnbt=2048)
+    tokens = [(i * 7919) % 30000 + 10 for i in range(num_tokens)]
+
+    if d_prefix:
+        # Give D a local copy of the prefix (a previous turn decoded there).
+        warm = _request(tokens[:d_prefix] + [3, 4, 5], 2)
+        d.add_request(warm)
+        for _ in range(20):
+            _step(d)
+            if warm.is_finished():
+                break
+        assert warm.is_finished()
+
+    # The router may prefill only an aligned prefix on P; D computes the rest.
+    target = num_tokens if not align else (num_tokens - 1) // align * align
+    if target == 0:
+        return  # nothing to transfer: D prefills locally
+    preq, params, send_meta = _run_prefill_on_p(p, tokens[:target])
+    assert params["num_tokens"] == target
+    assert params["remote_side_port"] == int(os.environ.get(
+        "TPU_SIDE_CHANNEL_PORT", "9600"))
+    assert isinstance(send_meta, c4.SendMetaDSV4)
+    groups = [c4._group_info(g.kv_cache_spec) for g in _groups()]
+
+    dreq = _request(tokens, 4, params=dict(params, do_remote_prefill=True))
+    d.add_request(dreq)
+    so, _ = _step(d)
+    load = so.kv_connector_metadata.reqs_to_load[dreq.request_id]
+    assert dreq.status == RequestStatus.WAITING_FOR_REMOTE_KVS
+    assert load.remote_block_ids is not None
+    assert load.local_hit_tokens == d_prefix, load.local_hit_tokens
+    _check_plan(target, send_meta.local_block_ids, load.local_block_ids,
+                load.local_hit_tokens, groups)
+
+    # Worker reports the pull done; D recomputes the last token only.
+    so, _ = _step(d, finished_recving={dreq.request_id})
+    if dreq.request_id not in so.num_scheduled_tokens:
+        so, _ = _step(d)
+    # D recomputes the last token, or everything past the aligned prefix.
+    assert so.num_scheduled_tokens[dreq.request_id] == max(
+        1, num_tokens - target)
+    insert = so.kv_connector_metadata.reqs_to_load[dreq.request_id]
+    assert insert.remote_block_ids is None
+    for g, (x, y) in enumerate(zip(load.local_block_ids,
+                                   insert.local_block_ids)):
+        assert y[:len(x)] == x, (g, x, y)
+    assert insert.remote_side_port == params["remote_side_port"]
+    for _ in range(10):
+        _step(d)
+        if dreq.is_finished():
+            break
+    assert dreq.is_finished()
+
+    # P frees the blocks after D's notification.
+    so, _ = _step(p, finished_sending={preq.request_id})
+    assert preq.request_id not in p.requests
