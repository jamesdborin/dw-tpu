+#!/usr/bin/env bash
+# titan-6 driver for the P/D mini test host.
+#   remote.sh deploy                 tar this worktree's tpu_inference + pdmini/ -> /opt/dsv4/pdmini on the host
+#   remote.sh ssh '<command>'
+#   remote.sh pull <remote-dir>      -> dw-tpu-work/dsv4-pd-mini/results/<basename>
+set -euo pipefail
+export CLOUDSDK_CONFIG=${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}
+NAME=${PDM_HOST:?set PDM_HOST to the v6e-8 VM name}; ZONE=${PDM_ZONE:-us-east5-b}
+HERE=$(cd "$(dirname "$0")" && pwd); WT=$(dirname "$HERE")
+RESULTS=${PDM_RESULTS:-$PWD/results}
+TMPD=${CLAUDE_JOB_DIR:-/tmp}/tmp; mkdir -p "$TMPD"
+g_ssh() { gcloud compute ssh "$NAME" --zone "$ZONE" --tunnel-through-iap --quiet --command "$1"; }
+g_scp() { gcloud compute scp --zone "$ZONE" --tunnel-through-iap --quiet "$@"; }
+case "${1:?command}" in
+  deploy)
+    K=$TMPD/pdkit; rm -rf "$K"; mkdir -p "$K/pdmini/tpu-inference"
+    git -C "$WT" diff --quiet HEAD || { echo "commit the worktree first" >&2; exit 1; }
+    git -C "$WT" archive HEAD tpu_inference | tar -x -C "$K/pdmini/tpu-inference"
+    git -C "$WT" rev-parse HEAD > "$K/pdmini/TPU_INFERENCE_SHA"
+    cp "$HERE"/*.py "$HERE"/*.sh "$HERE"/prompts.json "$HERE"/NOTES.md "$K/pdmini/"
+    tar -czf "$TMPD/pdkit.tgz" -C "$K" pdmini
+    g_ssh "mkdir -p /opt/dsv4/incoming"
+    g_scp "$TMPD/pdkit.tgz" "$NAME:/opt/dsv4/incoming/pdkit.tgz"
+    g_ssh "rm -rf /opt/dsv4/pdmini/tpu-inference && mkdir -p /opt/dsv4/pdmini && tar -xzf /opt/dsv4/incoming/pdkit.tgz -C /opt/dsv4 && chmod +x /opt/dsv4/pdmini/*.sh && cat /opt/dsv4/pdmini/TPU_INFERENCE_SHA && cd /tmp && PYTHONPATH=/opt/dsv4/pdmini/tpu-inference JAX_PLATFORMS=cpu /opt/dsv4/.venv/bin/python -c 'import tpu_inference, tpu_inference.distributed.tpu_connector_dsv4 as c; print(tpu_inference.__file__)'" ;;
+  ssh) g_ssh "$2" ;;
+  pull)
+    R=${2:?remote dir}; mkdir -p "$RESULTS"
+    g_ssh "tar -czf /tmp/pdpull.tgz -C $(dirname "$R") $(basename "$R")"
+    g_scp "$NAME:/tmp/pdpull.tgz" "$TMPD/pdpull.tgz"
+    tar -xzf "$TMPD/pdpull.tgz" -C "$RESULTS"
+    echo "$RESULTS/$(basename "$R")" ;;
+  *) echo "unknown command" >&2; exit 2 ;;
+esac
