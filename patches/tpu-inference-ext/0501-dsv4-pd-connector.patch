+++ b/pdmini/determinism_probe.py
@@ -0,0 +1,22 @@
+"""Same prompt prefilled on P0 and on P1 (as P/D requests, DSV4_PD_DEBUG=1):
+compare the PDDEBUG send checksums per entry/unit afterwards with
+  grep PDDEBUG P0.log P1.log
+Also runs a P0->D1 'tail' case after D1 computed X locally (see bisect_probe).
+"""
+import random
+
+import httpx
+
+ROUTER, D1 = "http://127.0.0.1:8000", "http://127.0.0.1:8201"
+rng = random.Random(4242)
+X = [rng.randrange(1000, 100000) for _ in range(5000)]
+with httpx.Client(timeout=600) as c:
+    for p, d in ((0, 0), (1, 1)):
+        r = c.post(ROUTER + "/v1/completions", json=dict(
+            model="dsv4-flash", prompt=X, max_tokens=4, temperature=0.0,
+            ignore_eos=True, return_token_ids=True,
+            pd_force={"p": p, "d": d}))
+        r.raise_for_status()
+        j = r.json()
+        print("P%d->D%d" % (p, d), j["choices"][0]["token_ids"],
+              j["router"]["uuid"], flush=True)
diff --git a/pdmini/dump_diff.py b/pdmini/dump_diff.py
new file mode 100644
index 000000000..f48ebbb4e
--- /dev/null
+++ b/pdmini/dump_diff.py
@@ -0,0 +1,100 @@
+"""Compare two pd_debug_dump records of the same resume step on two instances.
+
+  python dump_diff.py <a.json> <b.json> [--out diff.json]
+
+Block ids are instance-local, so block tables are compared after mapping ids to
+(group, logical block index) with each record's own block lists, and KV rows are
+keyed by (group, logical index, array).
+"""
+import argparse
+import json
+from collections import Counter
+
+
+def id_map(rec):
+    m = {}
+    for g in rec.get("blocks", []):
+        for li, b in enumerate(g["block_ids"]):
+            if b:
+                m.setdefault(b, []).append((g["group"], li))
+    return m
+
+
+def translate(vals, m):
+    return [("null" if v == 0 else (m.get(v, [("?", v)])[0] if v in m else ("?", v)))
+            for v in vals]
+
+
+def cmp_meta(a, b, out):
+    for k in ("num_scheduled", "num_computed", "num_prompt", "new_req_num_computed",
+              "request_distribution", "num_reqs", "req_index"):
+        if a.get(k) != b.get(k):
+            out.append(f"meta {k}: {a.get(k)} != {b.get(k)}")
+    pa, pb = a.get("positions", {}).get("head"), b.get("positions", {}).get("head")
+    if pa != pb:
+        first = next((i for i, (x, y) in enumerate(zip(pa or [], pb or [])) if x != y), None)
+        out.append(f"positions differ (first at {first})")
+    for ga, gb in zip(a.get("blocks", []), b.get("blocks", [])):
+        na = [bool(x) for x in ga["block_ids"]]
+        nb = [bool(x) for x in gb["block_ids"]]
+        if na != nb:
+            out.append(f"group {ga['group']} non-null pattern differs: a {sum(na)}/{len(na)} "
+                       f"b {sum(nb)}/{len(nb)}; first diff at logical "
+                       f"{next((i for i, (x, y) in enumerate(zip(na, nb)) if x != y), min(len(na), len(nb)))}")
+        if ga.get("block_table_row") != ga["block_ids"] or gb.get("block_table_row") != gb["block_ids"]:
+            out.append(f"group {ga['group']}: runner block-table row != scheduler block ids "
+                       f"(a {ga.get('block_table_row') != ga['block_ids']}, b {gb.get('block_table_row') != gb['block_ids']})")
+    ma, mb = id_map(a), id_map(b)
+    am, bm = a.get("attn_metadata", {}), b.get("attn_metadata", {})
+    for key in sorted(set(am) | set(bm)):
+        fa, fb = am.get(key), bm.get(key)
+        if fa is None or fb is None or "same_as" in fa or "same_as" in fb:
+            continue
+        for f in sorted(set(fa) | set(fb)):
+            va, vb = fa.get(f), fb.get(f)
+            if isinstance(va, dict) and isinstance(vb, dict) and "head" in va:
+                ha, hb = va["head"], vb["head"]
+                if "block" in f or "page" in f:
+                    ha, hb = translate(ha, ma), translate(hb, mb)
+                if va.get("shape") != vb.get("shape") or ha != hb:
+                    first = next((i for i, (x, y) in enumerate(zip(ha, hb)) if x != y), None)
+                    out.append(f"attn[{key}].{f}: shape {va.get('shape')}/{vb.get('shape')} "
+                               f"first diff at {first}: {ha[first] if first is not None else ''} vs "
+                               f"{hb[first] if first is not None else ''}")
+            elif va != vb:
+                out.append(f"attn[{key}].{f}: {str(va)[:80]} != {str(vb)[:80]}")
+
+
+def cmp_kv(a, b):
+    ka, kb = a.get("kv", {}), b.get("kv", {})
+    both = set(ka) & set(kb)
+    diff = sorted(k for k in both if ka[k] != kb[k])
+    rep_a = sorted(k for k in ka if len(set(ka[k])) > 1)
+    rep_b = sorted(k for k in kb if len(set(kb[k])) > 1)
+    by = Counter("/".join(k.split("/")[::2]) for k in diff)  # group/array
+    return dict(rows_a=len(ka), rows_b=len(kb), rows_both=len(both),
+                only_a=Counter(k.split("/")[0] for k in set(ka) - set(kb)),
+                only_b=Counter(k.split("/")[0] for k in set(kb) - set(ka)),
+                differ=len(diff), differ_by_group_array=dict(by),
+                differ_examples=diff[:30],
+                replica_mismatch_a=rep_a[:20], replica_mismatch_b=rep_b[:20])
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("a")
+    ap.add_argument("b")
+    ap.add_argument("--out")
+    x = ap.parse_args()
+    a, b = json.load(open(x.a)), json.load(open(x.b))
+    meta = []
+    cmp_meta(a, b, meta)
+    kv = cmp_kv(a, b)
+    res = dict(a=x.a, b=x.b, meta_diffs=meta, kv=kv)
+    print(json.dumps(res, indent=1, default=str))
+    if x.out:
+        json.dump(res, open(x.out, "w"), indent=1, default=str)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pdmini/dump_probe.py b/pdmini/dump_probe.py
new file mode 100644
index 000000000..2aac94fad
--- /dev/null
+++ b/pdmini/dump_probe.py
@@ -0,0 +1,69 @@
+"""Drive the local-hit vs remote-load dump scenario (servers run with DSV4_PD_DUMP_DIR set).
+
+  python dump_probe.py --p http://127.0.0.1:8110 --d1 http://127.0.0.1:8210 --d2 http://127.0.0.1:8220 --out probe.json
+
+X (5000 tokens):
+  D1: X (warm, local compute), then X again as "dumpme-local": prefix hit 4096, computes [4096, 5000)
+  P:  X[:4096] (max_tokens 1, do_remote_decode) -> kv_transfer_params
+  D2: X as "dumpme-load" with those params: loads 4096 tokens, computes [4096, 5000)
+  P:  X (cold reference for the tokens)
+X2 (5000 tokens): P full X2 -> D2 "dumpme-load1" (D2 resumes at 4999 with one token).
+"""
+import argparse
+import json
+import random
+
+import httpx
+
+
+def post(c, url, ids, rid, n=4, kvp=None):
+    body = dict(model="dsv4-flash", prompt=ids, max_tokens=n, temperature=0.0,
+                ignore_eos=True, return_token_ids=True, logprobs=1)
+    if kvp is not None:
+        body["kv_transfer_params"] = kvp
+    r = c.post(url + "/v1/completions", json=body, headers={"X-Request-Id": rid})
+    r.raise_for_status()
+    j = r.json()
+    ch = j["choices"][0]
+    return dict(tokens=ch.get("token_ids"),
+                logprobs=(ch.get("logprobs") or {}).get("token_logprobs"),
+                kv_transfer_params=j.get("kv_transfer_params"),
+                usage=j.get("usage"))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--p", required=True)
+    ap.add_argument("--d1", required=True)
+    ap.add_argument("--d2", required=True)
+    ap.add_argument("--L", type=int, default=5000)
+    ap.add_argument("--T", type=int, default=4096)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    rng = random.Random(5)
+    X = [rng.randrange(1000, 100000) for _ in range(a.L)]
+    X2 = [rng.randrange(1000, 100000) for _ in range(a.L)]
+    res = {}
+    with httpx.Client(timeout=900) as c:
+        res["d1_warm"] = post(c, a.d1, X, "warm-x")
+        res["d1_local"] = post(c, a.d1, X, "dumpme-local")
+        pp = post(c, a.p, X[:a.T], "p-prefix", n=1,
+                  kvp={"do_remote_decode": True, "do_remote_prefill": False})
+        kvp = dict(pp["kv_transfer_params"], do_remote_prefill=True,
+                   do_remote_decode=False)
+        res["d2_load"] = post(c, a.d2, X, "dumpme-load", kvp=kvp)
+        res["ref"] = post(c, a.p, X, "ref-x")
+        pp2 = post(c, a.p, X2, "p-full2", n=1,
+                   kvp={"do_remote_decode": True, "do_remote_prefill": False})
+        kvp2 = dict(pp2["kv_transfer_params"], do_remote_prefill=True,
+                    do_remote_decode=False)
+        res["d2_load1"] = post(c, a.d2, X2, "dumpme-load1", kvp=kvp2)
+        res["ref2"] = post(c, a.p, X2, "ref-x2")
+    for k in ("d1_warm", "d1_local", "d2_load", "ref"):
+        print(k, res[k]["tokens"], (res[k].get("usage") or {}).get("prompt_tokens_details"))
+    print("d2_load1", res["d2_load1"]["tokens"], "ref2", res["ref2"]["tokens"])
+    json.dump(res, open(a.out, "w"), indent=1)
+
+
+if __name__ == "__main__":
+    main()
