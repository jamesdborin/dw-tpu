+"""Send named correctness cases through the router and diff with a saved colocated run.
+  python probe_pd.py --url http://127.0.0.1:8000 --colo correct-colo.json base3_L2600:fresh syn5000:fresh
+"""
+import argparse
+import json
+
+import httpx
+
+from correctness import cases, query
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--url", default="http://127.0.0.1:8000")
+ap.add_argument("--colo", required=True)
+ap.add_argument("names", nargs="+")
+a = ap.parse_args()
+colo = json.load(open(a.colo))
+allc = dict(cases())
+with httpx.Client(timeout=600) as c:
+    for n in a.names:
+        r = query(c, a.url, allc[n], 16)
+        want = colo[n]["token_ids"][:16]
+        print(n, "EQUAL" if r["token_ids"] == want else "DIFF", r["token_ids"][:8], want[:8],
+              (r.get("router") or {}).get("uuid"), (r.get("router") or {}).get("d"), flush=True)
