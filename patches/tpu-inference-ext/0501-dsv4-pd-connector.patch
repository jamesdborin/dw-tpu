@@ -0,0 +1,93 @@
+"""Raw jax transfer-server bandwidth between two 2-chip processes on one host.
+
+  bash xfer_micro.sh <outdir>      # starts server (pair 0) + client (pair 2)
+
+Server registers, for each size S and layout, a uint8 array of S bytes split
+into --arrays equal arrays (like per-layer KV) placed either replicated over
+its 2 chips (what TP2 + attn_dp_size=1 KV looks like) or sharded over them.
+Client pulls each one --reps times and reports wall time and GB/s of logical
+payload. Same transfer-server settings as TPUConnector.
+"""
+import argparse
+import json
+import os
+import time
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+from jax.experimental.transfer import start_transfer_server
+from jax.sharding import Mesh, NamedSharding, PartitionSpec as P
+
+
+
+def shardings(mesh):
+    return {"replicated": NamedSharding(mesh, P()),
+            "sharded": NamedSharding(mesh, P("x"))}
+
+
+def uid(size_mb, layout, rep):
+    return (size_mb << 20) | ((layout == "sharded") << 16) | rep
+
+
+def specs(size_mb, n, sh):
+    rows = size_mb * (1 << 20) // n // 512
+    return [jax.ShapeDtypeStruct((rows, 512), jnp.uint8, sharding=sh)] * n
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("role", choices=["server", "client"])
+    ap.add_argument("--addr", required=True)
+    ap.add_argument("--peer")
+    ap.add_argument("--arrays", type=int, default=16)
+    ap.add_argument("--reps", type=int, default=3)
+    ap.add_argument("--channels", type=int, default=8)
+    ap.add_argument("--sizes-mb", default="1,4,16,64,256,1024")
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    SIZES_MB = [int(x) for x in a.sizes_mb.split(",")]
+    devs = jax.devices()
+    mesh = Mesh(np.array(devs), ("x", ))
+    host = a.addr.rsplit(":", 1)[0]
+    srv = start_transfer_server(devs[0].client, a.addr,
+                                [f"{host}:0"] * a.channels,
+                                max_num_parallel_copies=8,
+                                transfer_size=256 * 1024 * 1024,
+                                use_raw_buffers=False)
+    if a.role == "server":
+        keep = []
+        for layout, sh in shardings(mesh).items():
+            for mb in SIZES_MB:
+                for rep in range(a.reps):
+                    arrs = [jax.device_put(np.full(s.shape, rep, np.uint8), sh)
+                            for s in specs(mb, a.arrays, sh)]
+                    srv.await_pull(uid(mb, layout, rep), arrs)
+                    keep.append(arrs)
+        open(a.out + ".ready", "w").write("ok")
+        print("server ready", flush=True)
+        while not os.path.exists(a.out + ".done"):
+            time.sleep(1)
+        return
+    while not os.path.exists(a.out + ".ready"):
+        time.sleep(1)
+    conn = srv.connect(a.peer)
+    res = []
+    for layout, sh in shardings(mesh).items():
+        for mb in SIZES_MB:
+            for rep in range(a.reps):
+                t0 = time.perf_counter()
+                out = conn.pull(uid(mb, layout, rep), specs(mb, a.arrays, sh))
+                jax.block_until_ready(out)
+                dt = time.perf_counter() - t0
+                assert int(out[0][0, 0]) == rep
+                r = dict(layout=layout, mb=mb, arrays=a.arrays, rep=rep,
+                         s=dt, gbps=mb / 1024 / dt)
+                res.append(r)
+                print(json.dumps(r), flush=True)
+    json.dump(res, open(a.out, "w"))
+    open(a.out + ".done", "w").write("ok")
+
+
+if __name__ == "__main__":
+    main()
