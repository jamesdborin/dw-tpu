@@ -0,0 +1,30 @@
+"""Does a full prefix-cache hit (only the last prompt token recomputed) give the
+same greedy tokens as the cold run? Sends each prompt twice to one instance.
+
+  python hit_probe.py --url http://127.0.0.1:8200 --lengths 4096,4097,4100,5000
+"""
+import argparse
+import random
+
+import httpx
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--url", required=True)
+ap.add_argument("--lengths", default="1024,2048,4096,4097,4100,4224,5000")
+ap.add_argument("--seed", type=int, default=99)
+a = ap.parse_args()
+rng = random.Random(a.seed)
+with httpx.Client(timeout=600) as c:
+    for L in [int(x) for x in a.lengths.split(",")]:
+        ids = [rng.randrange(1000, 100000) for _ in range(L)]
+        outs = []
+        for _ in range(2):
+            r = c.post(a.url + "/v1/completions", json=dict(
+                model="dsv4-flash", prompt=ids, max_tokens=8, temperature=0.0,
+                ignore_eos=True, return_token_ids=True))
+            r.raise_for_status()
+            j = r.json()
+            outs.append((j["choices"][0]["token_ids"],
+                         (j.get("usage") or {}).get("prompt_tokens_details")))
+        print(L, "SAME" if outs[0][0] == outs[1][0] else "DIFF", outs[0][0],
+              outs[1][0], outs[1][1], flush=True)
diff --git a/pdmini/pd_check.py b/pdmini/pd_check.py
new file mode 100644
index 000000000..d0f245f59
--- /dev/null
+++ b/pdmini/pd_check.py
@@ -0,0 +1,83 @@
+"""P/D correctness check for one P/D pair (+ its router), per prompt length.
+
+  python pd_check.py --p http://127.0.0.1:8100 --d http://127.0.0.1:8200 \
+      --router http://127.0.0.1:8000 --label v1 --out res.json
+
+For every length L, with fresh random prompts X and Z:
+  ref      X on P directly (cold, colocated compute: the reference)
+  pd_full  X through the router: D loads the whole prompt from P
+  d_local  X on D directly (D's own compute; also fills D's prefix cache)
+  pd_tail  X through the router again: D holds the 1024-blocks locally and pulls
+           only the last chunk + the sliding-window/state tail
+  pd_align Z through the router with pd_recompute_align=1024 (P prefills an
+           aligned prefix, D loads it and computes the rest); refZ = Z on P
+Each case: greedy tokens (max_tokens 8) and chosen-token logprobs.
+"""
+import argparse
+import json
+import random
+import time
+
+import httpx
+
+
+def run(c, url, ids, extra=None, n=8):
+    body = dict(model="dsv4-flash", prompt=ids, max_tokens=n,
+                temperature=0.0, ignore_eos=True, return_token_ids=True,
+                logprobs=1)
+    body.update(extra or {})
+    t0 = time.time()
+    r = c.post(url + "/v1/completions", json=body)
+    r.raise_for_status()
+    j = r.json()
+    ch = j["choices"][0]
+    lp = (ch.get("logprobs") or {}).get("token_logprobs") or []
+    return dict(tokens=ch.get("token_ids"),
+                logprobs=[None if x is None else round(x, 5) for x in lp],
+                uuid=(j.get("router") or {}).get("uuid"),
+                s=round(time.time() - t0, 3))
+
+
+def same(a, b):
+    return a["tokens"] == b["tokens"]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--p", required=True)
+    ap.add_argument("--d", required=True)
+    ap.add_argument("--router", required=True)
+    ap.add_argument("--lengths", default="300,1500,2600,5000")
+    ap.add_argument("--seed", type=int, default=11)
+    ap.add_argument("--label", default="")
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    rng = random.Random(a.seed)
+    rows = []
+    with httpx.Client(timeout=900) as c:
+        for L in [int(x) for x in a.lengths.split(",")]:
+            X = [rng.randrange(1000, 100000) for _ in range(L)]
+            Z = [rng.randrange(1000, 100000) for _ in range(L)]
+            r = {"L": L}
+            r["ref"] = run(c, a.p, X)
+            r["pd_full"] = run(c, a.router, X)
+            r["d_local"] = run(c, a.d, X)
+            r["pd_tail"] = run(c, a.router, X)
+            r["refZ"] = run(c, a.p, Z)
+            r["pd_align"] = run(c, a.router, Z, {"pd_recompute_align": 1024})
+            r["ok"] = dict(pd_full=same(r["pd_full"], r["ref"]),
+                           d_local=same(r["d_local"], r["ref"]),
+                           pd_tail=same(r["pd_tail"], r["ref"]),
+                           pd_align=same(r["pd_align"], r["refZ"]))
+            print(a.label, L, r["ok"], "ref", r["ref"]["tokens"][:4],
+                  "pd_full", r["pd_full"]["tokens"][:4], flush=True)
+            rows.append(r)
+    summary = {k: sum(r["ok"][k] for r in rows)
+               for k in ("pd_full", "d_local", "pd_tail", "pd_align")}
+    json.dump(dict(label=a.label, n=len(rows), equal_counts=summary,
+                   rows=rows), open(a.out, "w"), indent=1)
+    print(a.label, "EQUAL COUNTS", summary, "of", len(rows), flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pdmini/pd_router.py b/pdmini/pd_router.py
new file mode 100644
index 000000000..c45275d0b
--- /dev/null
+++ b/pdmini/pd_router.py
@@ -0,0 +1,322 @@
+"""Disaggregated P/D router with block-level prefix affinity.
+
+  python pd_router.py --prefill http://127.0.0.1:8100 http://127.0.0.1:8101 \
+      --decode http://127.0.0.1:8200 http://127.0.0.1:8201 --policy affinity \
+      --log /opt/dsv4/runs/x/router.jsonl
+
+Prompts are hashed in chained blocks of --block tokens (1024 = the DSV4 KV
+block). The router remembers which blocks it sent to each prefill and decode
+copy (LRU, --capacity-blocks per copy) and sends a request to the prefill copy
+and the decode copy with the longest cached prefix, if that prefix covers at least --match-threshold of the
+prompt's full blocks; otherwise (e.g. a new session that only shares the
+system prompt) it goes to the least-loaded copy (fewest in-flight requests),
+so new sessions spread over the copies. Ties go to the least-loaded copy, and
+a copy more than --max-imbalance requests busier than the least-loaded one is
+skipped.
+--policy rr is the no-affinity control (independent round robin for P and D).
+
+--recompute-align A (or a request's "pd_recompute_align") makes P prefill only
+the first T = ((L - 1) // A) * A prompt tokens; D receives their KV and computes
+the remaining L - T tokens itself, resuming at an A-aligned position like a
+local prefix-cache hit (T = 0: D prefills everything, P is skipped).
+
+Only /v1/completions is routed. A string prompt is tokenized once with the
+first prefill copy's /tokenize so every copy sees the same token ids.
+POST /router/reset clears the affinity tables (and the log counters);
+GET /router/stats returns per-copy counters.
+"""
+import argparse
+import asyncio
+import hashlib
+import itertools
+import json
+import time
+import uuid
+from collections import OrderedDict
+
+import httpx
+import uvicorn
+from fastapi import FastAPI, Request
+from fastapi.responses import JSONResponse, StreamingResponse
+
+
+def block_hashes(tokens: list[int], block: int) -> list[bytes]:
+    out, h = [], b""
+    for i in range(len(tokens) // block):
+        m = hashlib.blake2b(h, digest_size=16)
+        m.update(json.dumps(tokens[i * block:(i + 1) * block]).encode())
+        h = m.digest()
+        out.append(h)
+    return out
+
+
+class Copy:
+
+    def __init__(self, role: str, idx: int, url: str, capacity: int):
+        self.role, self.idx, self.url = role, idx, url
+        self.name = f"{role}{idx}"
+        self.client = httpx.AsyncClient(base_url=url, timeout=None)
+        self.blocks: OrderedDict[bytes, None] = OrderedDict()
+        self.capacity = capacity
+        self.inflight = 0
+        self.requests = 0
+        self.routed_with_match = 0
+
+    def match(self, hashes: list[bytes]) -> int:
+        n = 0
+        for h in hashes:
+            if h not in self.blocks:
+                break
+            n += 1
+        return n
+
+    def remember(self, hashes: list[bytes]):
+        for h in hashes:
+            self.blocks[h] = None
+            self.blocks.move_to_end(h)
+        while len(self.blocks) > self.capacity:
+            self.blocks.popitem(last=False)
+
+
+class Router:
+
+    def __init__(self, args):
+        self.args = args
+        self.p = [Copy("P", i, u, args.capacity_blocks)
+                  for i, u in enumerate(args.prefill)]
+        self.d = [Copy("D", i, u, args.capacity_blocks)
+                  for i, u in enumerate(args.decode)]
+        self.rr = {"P": itertools.cycle(range(len(self.p))),
+                   "D": itertools.cycle(range(len(self.d)))}
+        self.log = open(args.log, "a") if args.log else None
+
+    def reset(self):
+        for c in self.p + self.d:
+            c.blocks.clear()
+            c.requests = c.routed_with_match = 0
+        self.rr = {"P": itertools.cycle(range(len(self.p))),
+                   "D": itertools.cycle(range(len(self.d)))}
+
+    def pick(self, copies: list[Copy], role: str,
+             hashes: list[bytes]) -> tuple[Copy, int]:
+        if self.args.policy == "rr":
+            c = copies[next(self.rr[role])]
+            return c, c.match(hashes)
+        least = min(c.inflight for c in copies)
+        eligible = [c for c in copies
+                    if c.inflight <= least + self.args.max_imbalance]
+        best = max(c.match(hashes) for c in eligible)
+        if hashes and best >= self.args.match_threshold * len(hashes):
+            # Longest cached prefix, then fewest in flight, then lowest index.
+            key = lambda c: (c.match(hashes), -c.inflight, -c.idx)
+        else:
+            # Fewest in flight, then fewest blocks held, then longest prefix.
+            key = lambda c: (-c.inflight, -len(c.blocks), c.match(hashes),
+                             -c.idx)
+        c = max(eligible, key=key)
+        return c, c.match(hashes)
+
+    def write(self, rec: dict):
+        if self.log:
+            self.log.write(json.dumps(rec) + "\n")
+            self.log.flush()
+
+
+app = FastAPI()
+R: Router = None  # type: ignore
+
+
+async def _tokenize(prompt: str) -> list[int]:
+    r = await R.p[0].client.post("/tokenize", json={"prompt": prompt})
+    r.raise_for_status()
+    return r.json()["tokens"]
+
+
+@app.post("/v1/completions")
+async def completions(request: Request):
+    body = await request.json()
+    t0 = time.time()
+    rid = request.headers.get("x-request-id") or str(uuid.uuid4())
+    prompt = body.get("prompt")
+    if isinstance(prompt, list) and len(prompt) == 1 and isinstance(
+            prompt[0], (str, list)):
+        prompt = prompt[0]
+    if isinstance(prompt, str):
+        prompt = await _tokenize(prompt)
+    body["prompt"] = prompt
+    hashes = block_hashes(prompt, R.args.block)
+    session = body.pop("session", None)
+    align = int(body.pop("pd_recompute_align", R.args.recompute_align))
+    n_p = len(prompt) if align <= 1 else (len(prompt) - 1) // align * align
+    p_hashes = hashes[:n_p // R.args.block]
+
+    force = body.pop("pd_force", None)  # debugging: {"p": i, "d": j}
+    pc, p_match = R.pick(R.p, "P", hashes)
+    dc, d_match = R.pick(R.d, "D", hashes)
+    if force:
+        pc, dc = R.p[force["p"]], R.d[force["d"]]
+        p_match, d_match = pc.match(hashes), dc.match(hashes)
+    pc.inflight += 1
+    dc.inflight += 1
+    pc.requests += 1
+    dc.requests += 1
+    pc.routed_with_match += p_match > 0
+    dc.routed_with_match += d_match > 0
+    rec = dict(id=rid, session=session, prompt_tokens=len(prompt),
+               p_tokens=n_p, recompute_align=align,
+               full_blocks=len(hashes), policy=R.args.policy, p=pc.name,
+               d=dc.name, p_match_blocks=p_match, d_match_blocks=d_match,
+               p_best_blocks=max(c.match(hashes) for c in R.p),
+               d_best_blocks=max(c.match(hashes) for c in R.d), t0=t0)
+
+    pbody = dict(body)
+    pbody.update(prompt=prompt[:n_p], stream=False, max_tokens=1,
+                 kv_transfer_params={"do_remote_decode": True,
+                                     "do_remote_prefill": False})
+    pbody.pop("stream_options", None)
+    pbody.pop("max_completion_tokens", None)
+    pj = {}
+    if n_p > 0:
+        try:
+            resp = await pc.client.post("/v1/completions", json=pbody,
+                                        headers={"X-Request-Id": rid + "-p"})
+            resp.raise_for_status()
+        except Exception:
+            pc.inflight -= 1
+            dc.inflight -= 1
+            raise
+        pj = resp.json()
+    pc.inflight -= 1
+    pc.remember(p_hashes)
+    rec["t_prefill"] = time.time()
+    usage = pj.get("usage") or {}
+    rec["p_cached_tokens"] = (usage.get("prompt_tokens_details") or
+                              {}).get("cached_tokens")
+    kvp = pj.get("kv_transfer_params") or {}
+    rec["uuid"] = kvp.get("uuid")
+    dbody = dict(body)
+    if kvp:
+        dbody["kv_transfer_params"] = dict(kvp, do_remote_prefill=True,
+                                           do_remote_decode=False)
+    stream = bool(body.get("stream"))
+    dbody["stream"] = True
+    dbody["stream_options"] = {"include_usage": True,
+                               "continuous_usage_stats": False}
+    dc.remember(hashes)
+
+    async def gen():
+        first = None
+        last_usage = None
+        try:
+            async with dc.client.stream(
+                    "POST", "/v1/completions", json=dbody,
+                    headers={"X-Request-Id": rid + "-d"}) as r:
+                r.raise_for_status()
+                buf = b""
+                async for chunk in r.aiter_bytes():
+                    if first is None:
+                        first = time.time()
+                    buf += chunk
+                    while b"\n\n" in buf:
+                        ev, buf = buf.split(b"\n\n", 1)
+                        if ev.startswith(b"data: ") and ev[6:] != b"[DONE]":
+                            try:
+                                j = json.loads(ev[6:])
+                                if j.get("usage"):
+                                    last_usage = j["usage"]
+                            except ValueError:
+                                pass
+                    yield chunk
+        finally:
+            dc.inflight -= 1
+            rec["t_first"] = first
+            rec["t_end"] = time.time()
+            if last_usage:
+                rec["d_cached_tokens"] = (last_usage.get(
+                    "prompt_tokens_details") or {}).get("cached_tokens")
+                rec["completion_tokens"] = last_usage.get(
+                    "completion_tokens")
+            R.write(rec)
+
+    if stream:
+        return StreamingResponse(gen(), media_type="text/event-stream")
+    # Non-streaming client: collect the stream into one completion.
+    text, token_ids, logprobs, finish, usage = [], [], None, None, None
+    async for chunk in gen():
+        for ev in chunk.split(b"\n\n"):
+            ev = ev.strip()
+            if not ev.startswith(b"data: ") or ev[6:] == b"[DONE]":
+                continue
+            try:
+                j = json.loads(ev[6:])
+            except ValueError:
+                continue
+            if j.get("usage"):
+                usage = j["usage"]
+            for ch in j.get("choices") or []:
+                text.append(ch.get("text") or "")
+                token_ids.extend(ch.get("token_ids") or [])
+                finish = ch.get("finish_reason") or finish
+                lp = ch.get("logprobs")
+                if lp:
+                    if logprobs is None:
+                        logprobs = {k: [] for k in lp}
+                    for k, v in lp.items():
+                        if isinstance(v, list):
+                            logprobs.setdefault(k, []).extend(v)
+    return JSONResponse(dict(
+        id=rid, object="text_completion", model=body.get("model"),
+        choices=[dict(index=0, text="".join(text), token_ids=token_ids,
+                      logprobs=logprobs, finish_reason=finish)],
+        usage=usage, router=rec))
+
+
+@app.get("/router/stats")
+async def stats():
+    return {c.name: dict(url=c.url, requests=c.requests,
+                         routed_with_match=c.routed_with_match,
+                         inflight=c.inflight, blocks=len(c.blocks))
+            for c in R.p + R.d}
+
+
+@app.post("/router/reset")
+async def reset():
+    R.reset()
+    return {"ok": True}
+
+
+@app.post("/router/policy/{policy}")
+async def set_policy(policy: str):
+    assert policy in ("affinity", "rr")
+    R.args.policy = policy
+    R.reset()
+    return {"policy": policy}
+
+
+@app.get("/health")
+async def health():
+    return {"ok": True}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--host", default="127.0.0.1")
+    ap.add_argument("--port", type=int, default=8000)
+    ap.add_argument("--prefill", nargs="+", required=True)
+    ap.add_argument("--decode", nargs="+", required=True)
+    ap.add_argument("--policy", choices=["affinity", "rr"],
+                    default="affinity")
+    ap.add_argument("--block", type=int, default=1024)
+    ap.add_argument("--capacity-blocks", type=int, default=1 << 20)
+    ap.add_argument("--max-imbalance", type=int, default=8)
+    ap.add_argument("--match-threshold", type=float, default=0.5)
+    ap.add_argument("--recompute-align", type=int, default=1)
+    ap.add_argument("--log", default=None)
+    args = ap.parse_args()
+    global R
+    R = Router(args)
+    uvicorn.run(app, host=args.host, port=args.port, log_level="warning")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pdmini/pd_up.sh b/pdmini/pd_up.sh
new file mode 100755
index 000000000..6e899936b
--- /dev/null
+++ b/pdmini/pd_up.sh
@@ -0,0 +1,108 @@
+#!/usr/bin/env bash
+# Start mini-DSV4 vLLM instances on 2-chip subslices of one v6e-8 host, each as a systemd unit
+# dsv4-pdm-<name>, logs in $RUN/<name>.log. Then (pd layouts) the router as dsv4-pdm-router.
+#   bash pd_up.sh <run-dir> <layout> [router-policy]
+# Layouts:
+#   pd    P0 P1 (kv_producer) + D0 D1 (kv_consumer) on the four chip pairs, router on :8000
+#   colo  C0 (no connector) on pair 0: the colocated reference for correctness / TTFT
+#   colo2 C0 C1 on pairs 0 and 1 (control: two colocated copies, same chips as P0 P1)
+#   custom INSTANCES="NAME ROLE PAIR_IDX PORT [CKPT];..." (ROLE kv_producer|kv_consumer|none); if it has
+#          producers, a router named dsv4-pdm-${ROUTER_NAME:-router} on ${ROUTER_PORT:-8000} fronts them.
+#          KV_PORT_BASE / SIDE_PORT_BASE (9100 / 9600) let several custom launches coexist.
+# Env knobs: CKPT, PAIRS ("0,1 2,3 4,5 6,7"), BOUNDS (1,2,1), MAX_LEN, MNBT, MAX_SEQS, GPU_MEM,
+#   SKIP_JAX_PRECOMPILE (default 1), EXTRA_SERVE_ARGS, ATTN_DP (1 = single scheduler, KV replicated;
+#   2 = attention DP over the pair through DPScheduler), DSV4_PD_XFER_LAYOUT (single|replicated).
+set -euo pipefail
+RUN=${1:?run dir}; LAYOUT=${2:?layout}; POLICY=${3:-affinity}
+mkdir -p "$RUN"
+KIT=/opt/dsv4/pdmini
+CKPT=${CKPT:-/opt/dsv4/ckpt/dsv4-flash-5L}
+read -r -a PAIR <<< "${PAIRS:-0,1 2,3 4,5 6,7}"
+BOUNDS=${BOUNDS:-1,2,1}
+MAX_LEN=${MAX_LEN:-34816}; MNBT=${MNBT:-2048}; MAX_SEQS=${MAX_SEQS:-32}; GPU_MEM=${GPU_MEM:-0.6}
+
+case "$LAYOUT" in
+  pd)    INST=("P0 kv_producer 0 8100" "P1 kv_producer 1 8101" "D0 kv_consumer 2 8200" "D1 kv_consumer 3 8201") ;;
+  colo)  INST=("C0 none 0 8300") ;;
+  colo2) INST=("C0 none 0 8300" "C1 none 1 8301") ;;
+  custom) IFS=';' read -r -a INST <<< "${INSTANCES:?INSTANCES}" ;;
+  *) echo "unknown layout $LAYOUT" >&2; exit 2 ;;
+esac
+
+unit() {  # name log command
+  sudo -n systemctl stop "$1" 2>/dev/null || true
+  sudo -n systemctl reset-failed "$1" 2>/dev/null || true
+  sudo -n systemd-run --unit="$1" --uid="$(id -u)" --gid="$(id -g)" --collect \
+    --property=KillMode=control-group --property=TimeoutStopSec=30 \
+    --property=LimitMEMLOCK=infinity --property=LimitNOFILE=1048576 \
+    /bin/bash -c "exec > '$2' 2>&1; set -eo pipefail; $3"
+}
+
+i=0
+for spec in "${INST[@]}"; do
+  read -r NAME ROLE PIDX PORT ICKPT <<< "$spec"
+  ICKPT=${ICKPT:-$CKPT}
+  KVPORT=$((${KV_PORT_BASE:-9100} + i)); SIDE=$((${SIDE_PORT_BASE:-9600} + i))
+  ENVF=$RUN/$NAME.env
+  {
+    echo 'export PATH=/opt/dsv4/.venv/bin:/opt/dsv4/tools:/usr/local/bin:/usr/bin:/bin'
+    echo 'export PYTHONUNBUFFERED=1 HF_HOME=/opt/dsv4/hf-cache TZ=UTC VLLM_SERVER_DEV_MODE=1'
+    echo 'unset JAX_PLATFORMS'
+    echo 'source /opt/dsv4/dw-tpu/env.sh'
+    echo 'unset TPU_TOKEN_PADDINGS_PER_DP'
+    echo "export SKIP_JAX_PRECOMPILE=${SKIP_JAX_PRECOMPILE:-1} VLLM_XLA_CACHE_PATH=/opt/dsv4/xla-cache-pdmini"
+    echo "export PYTHONPATH=$KIT/tpu-inference"
+    echo "export TPU_VISIBLE_CHIPS=${PAIR[$PIDX]} TPU_CHIPS_PER_PROCESS_BOUNDS=$BOUNDS TPU_PROCESS_BOUNDS=1,1,1 TPU_PROCESS_PORT=$((8476 + PIDX))"
+    echo "export TPU_KV_TRANSFER_PORT=$KVPORT TPU_SIDE_CHANNEL_PORT=$SIDE DSV4_PD_CHUNK_TOKENS=${DSV4_PD_CHUNK_TOKENS:-1024}"
+    echo "export DSV4_PD_XFER_LAYOUT=${DSV4_PD_XFER_LAYOUT:-single}"
+    echo "export TPU_P2P_WAIT_PULL_TIMEOUT=${TPU_P2P_WAIT_PULL_TIMEOUT:-120} TPU_ENABLE_BLOCK_KV_TRANSFER=true"
+    echo "export VLLM_RPC_TIMEOUT=1800000 VLLM_ENGINE_READY_TIMEOUT_S=3600"
+    test -n "${PD_EXTRA_ENV:-}" && echo "export $PD_EXTRA_ENV"
+  } > "$ENVF"
+  KVCFG=""
+  if test "$ROLE" != none; then
+    KVCFG="--kv-transfer-config '{\"kv_connector\":\"TPUConnectorDSV4\",\"kv_connector_module_path\":\"tpu_inference.distributed.tpu_connector_dsv4\",\"kv_role\":\"$ROLE\"}'"
+  fi
+  cat > "$RUN/$NAME.sh" <<EOF
+source $ENVF
+set -x
+exec vllm serve $ICKPT --served-model-name dsv4-flash --host 127.0.0.1 --port $PORT \\
+  --tensor-parallel-size 2 --kv-cache-dtype fp8 --tokenizer-mode deepseek_v4 \\
+  --enable-prefix-caching --enable-prompt-tokens-details --no-async-scheduling \\
+  --max-model-len $MAX_LEN --max-num-batched-tokens $MNBT --max-num-seqs $MAX_SEQS \\
+  --gpu-memory-utilization $GPU_MEM --max-logprobs 20 \\
+  --additional-config '{"sharding": {"sharding_strategy": {"enable_dp_attention": true, "attn_dp_size": ${ATTN_DP:-1}}}}' \\
+  $KVCFG ${EXTRA_SERVE_ARGS:-}
+EOF
+  unit "dsv4-pdm-$NAME" "$RUN/$NAME.log" "exec bash '$RUN/$NAME.sh'"
+  echo "$NAME $ROLE chips=${PAIR[$PIDX]} http=$PORT kv=$KVPORT side=$SIDE ckpt=$ICKPT" | tee -a "$RUN/layout.txt"
+  i=$((i + 1))
+done
+
+# Wait for health.
+for spec in "${INST[@]}"; do
+  read -r NAME ROLE PIDX PORT ICKPT <<< "$spec"
+  for _ in $(seq 1 720); do
+    curl -sf "127.0.0.1:$PORT/health" >/dev/null && break
+    if ! sudo -n systemctl is-active --quiet "dsv4-pdm-$NAME"; then
+      echo "instance $NAME died; tail:" >&2; tail -40 "$RUN/$NAME.log" >&2; exit 1
+    fi
+    sleep 5
+  done
+  curl -sf "127.0.0.1:$PORT/health" >/dev/null || { echo "$NAME not healthy" >&2; exit 1; }
+  echo "$NAME healthy"
+done
+
+PRE=(); DEC=()
+for spec in "${INST[@]}"; do
+  read -r NAME ROLE PIDX PORT ICKPT <<< "$spec"
+  test "$ROLE" = kv_producer && PRE+=("http://127.0.0.1:$PORT")
+  test "$ROLE" = kv_consumer && DEC+=("http://127.0.0.1:$PORT")
+done
+if test ${#PRE[@]} -gt 0; then
+  RNAME=${ROUTER_NAME:-router}; RPORT=${ROUTER_PORT:-8000}
+  unit "dsv4-pdm-$RNAME" "$RUN/$RNAME.log" "exec /opt/dsv4/.venv/bin/python $KIT/pd_router.py \
+    --port $RPORT --prefill ${PRE[*]} --decode ${DEC[*]} --policy $POLICY --log $RUN/$RNAME.jsonl"
+  for _ in $(seq 1 60); do curl -sf "127.0.0.1:$RPORT/health" >/dev/null && break; sleep 1; done
+  curl -sf "127.0.0.1:$RPORT/health" && echo " router $RNAME up on $RPORT"
+fi
