+# SPDX-License-Identifier: Apache-2.0
+"""CPU smoke test of tpu_inference.runner.pd_debug_dump with a fake runner.
+
+  JAX_PLATFORMS=cpu python -m pytest -q tests/runner/test_pd_debug_dump_cpu.py
+"""
+import importlib
+import json
+import os
+from types import SimpleNamespace
+
+os.environ.setdefault("XLA_FLAGS", "--xla_force_host_platform_device_count=2")
+
+import jax  # noqa: E402
+import numpy as np  # noqa: E402
+from jax.sharding import Mesh, NamedSharding  # noqa: E402
+from jax.sharding import PartitionSpec as P  # noqa: E402
+
+
+def test_dump(tmp_path, monkeypatch):
+    monkeypatch.setenv("DSV4_PD_DUMP_DIR", str(tmp_path))
+    from tpu_inference.runner import pd_debug_dump
+    m = importlib.reload(pd_debug_dump)
+    mesh = Mesh(np.array(jax.devices()[:2]), ("x", ))
+    sh = NamedSharding(mesh, P())
+    kv = [jax.device_put(np.arange(8 * 4, dtype=np.uint8).reshape(8, 4) + i,
+                         sh) for i in range(3)]
+    groups = [SimpleNamespace(layer_names=["a"]),
+              SimpleNamespace(layer_names=["b", "c"])]
+    bt = [SimpleNamespace(get_cpu_tensor=lambda: np.array([[0, 2, 3, 0]])),
+          SimpleNamespace(get_cpu_tensor=lambda: np.array([[5, 6, 0, 0]]))]
+    runner = SimpleNamespace(
+        kv_caches=kv,
+        kv_cache_config=SimpleNamespace(kv_cache_groups=groups),
+        layer_name_to_kvcache_index={"a": 0, "a_rope": 1, "b": 1, "c": 2},
+        input_batch=SimpleNamespace(
+            req_id_to_index={"cmpl-dumpme-x": 0},
+            num_computed_tokens_cpu=np.array([4096]),
+            num_prompt_tokens=np.array([5000]), num_reqs=1,
+            request_distribution=[0, 0, 1], block_table=bt),
+        requests={"cmpl-dumpme-x": SimpleNamespace(
+            block_ids=([0, 2, 3], [5, 6]))})
+    so = SimpleNamespace(num_scheduled_tokens={"cmpl-dumpme-x": 904,
+                                               "other": 1},
+                         scheduled_new_reqs=[SimpleNamespace(
+                             req_id="cmpl-dumpme-x", num_computed_tokens=4096)])
+    md = SimpleNamespace(seq_lens=np.array([5000]),
+                         block_tables=np.zeros((2, 8), np.int32))
+    m.dump(runner, so, "pre", np.arange(904), {"l0": md, "l1": md})
+    m.dump(runner, so, "post")
+    files = sorted(os.listdir(tmp_path / "cmpl-dumpme-x"))
+    assert files == ["0001-post.json", "0001-pre.json"], files
+    rec = json.load(open(tmp_path / "cmpl-dumpme-x" / "0001-pre.json"))
+    assert rec["num_computed"] == 4096 and rec["new_req_num_computed"] == 4096
+    assert rec["attn_metadata"]["l1"] == {"same_as": "l0"}
+    # group 0 arrays: a (0) and a_rope (1); group 1: b (1), c (2)
+    assert set(rec["kv"]) == {"0/1/0", "0/1/1", "0/2/0", "0/2/1", "1/0/1",
+                              "1/0/2", "1/1/1", "1/1/2"}
+    assert all(len(v) == 2 and v[0] == v[1] for v in rec["kv"].values())
+    assert rec["blocks"][0]["block_table_row"] == [0, 2, 3]
