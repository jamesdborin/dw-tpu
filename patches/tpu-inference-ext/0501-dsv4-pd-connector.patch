+# SPDX-License-Identifier: Apache-2.0
+"""DPScheduler P/D helpers: per-rank block-id offsets and per-rank
+finished_sending/recving (CPU, no scheduler processes)."""
+import vllm.platforms as _vp
+
+_vp.builtin_platform_plugins = {
+    "tpu": lambda: "tpu_inference.platforms.tpu_platform.TpuPlatform"
+}
+
+from vllm.v1.outputs import KVConnectorOutput  # noqa: E402
+
+from tpu_inference.core.sched import dp_scheduler as dps  # noqa: E402
+from tpu_inference.distributed.tpu_connector_dsv4 import (  # noqa: E402
+    LoadMetaDSV4, SendMetaDSV4)
+
+
+def test_offset_block_ids():
+    m = SendMetaDSV4(uuid=1, local_block_ids=[[0, 3, 4], [0, 0, 7]],
+                     expiration_time=0.0)
+    dps._offset_pd_block_ids(m, 100)
+    assert m.local_block_ids == [[0, 103, 104], [0, 0, 107]]
+    m = LoadMetaDSV4(uuid=1, local_block_ids=[5, 0, 6], remote_block_ids=None,
+                     remote_host="h", remote_port=1)
+    dps._offset_pd_block_ids(m, 10)
+    assert m.local_block_ids == [15, 0, 16]
+    m = LoadMetaDSV4(uuid=1, local_block_ids=None, remote_block_ids=None,
+                     remote_host="h", remote_port=1)
+    dps._offset_pd_block_ids(m, 10)
+    assert m.local_block_ids is None
+
+
+def test_split_kv_connector_output():
+    s = dps.DPScheduler.__new__(dps.DPScheduler)
+    s.dp_size = 2
+    s.kv_xfer_rank = {"a": 0, "b": 1, "c": 1}
+    out = KVConnectorOutput(finished_sending={"a", "b"},
+                            finished_recving={"c", "x"})
+    r0, r1 = s._split_kv_connector_output(out)
+    assert r0.finished_sending == {"a"} and r1.finished_sending == {"b"}
+    # Untracked ids (other connectors) are still broadcast.
+    assert r0.finished_recving == {"x"} and r1.finished_recving == {"c", "x"}
+    assert s.kv_xfer_rank == {}
+    none = KVConnectorOutput()
+    assert s._split_kv_connector_output(none) == [none, none]
diff --git a/tests/distributed/sw_lists_probe.py b/tests/distributed/sw_lists_probe.py
new file mode 100644
index 000000000..c39604cc2
--- /dev/null
+++ b/tests/distributed/sw_lists_probe.py
@@ -0,0 +1,51 @@
+"""Print D's per-group block lists after a remote load vs a local prefix hit.
+
+  JAX_PLATFORMS=cpu python -m tests.distributed.sw_lists_probe
+"""
+from tests.distributed import test_tpu_connector_dsv4_sched_cpu as b
+
+
+def summarize(ids):
+    nulls = sum(1 for x in ids if x == 0)
+    return f"len={len(ids)} nulls={nulls} first_nonnull={next((i for i, x in enumerate(ids) if x), None)}"
+
+
+def main(L=5000):
+    tokens = [(i * 7919) % 30000 + 10 for i in range(L)]
+    # Local: compute X, then X again (prefix hit).
+    s = b._scheduler("kv_consumer", mnbt=2048)
+    r1 = b._request(tokens, 2)
+    s.add_request(r1)
+    for _ in range(20):
+        b._step(s)
+        if r1.is_finished():
+            break
+    r2 = b._request(tokens, 2)
+    s.add_request(r2)
+    so, _ = b._step(s)
+    hit_ids = s.kv_cache_manager.get_block_ids(r2.request_id)
+    print("local hit: num_computed", r2.num_computed_tokens - so.num_scheduled_tokens[r2.request_id])
+    for g, ids in enumerate(hit_ids):
+        print("  group", g, summarize(ids))
+    # Remote: P prefill + D load.
+    p = b._scheduler("kv_producer", mnbt=2048)
+    d = b._scheduler("kv_consumer", mnbt=2048)
+    preq, params, send = b._run_prefill_on_p(p, tokens)
+    dreq = b._request(tokens, 2, params=dict(params, do_remote_prefill=True))
+    d.add_request(dreq)
+    b._step(d)
+    so, _ = b._step(d, finished_recving={dreq.request_id})
+    if dreq.request_id not in so.num_scheduled_tokens:
+        so, _ = b._step(d)
+    ids = d.kv_cache_manager.get_block_ids(dreq.request_id)
+    print("remote: scheduled", so.num_scheduled_tokens[dreq.request_id])
+    for g, x in enumerate(ids):
+        print("  group", g, summarize(x))
+    nr = [n for n in so.scheduled_new_reqs if n.req_id == dreq.request_id]
+    print("remote new-req num_computed", nr[0].num_computed_tokens if nr else "not new")
+    for g, x in enumerate(nr[0].block_ids if nr else []):
+        print("  sent group", g, summarize(x))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/distributed/test_tpu_connector_dsv4_cpu.py b/tests/distributed/test_tpu_connector_dsv4_cpu.py
new file mode 100644
index 000000000..949f9428b
--- /dev/null
+++ b/tests/distributed/test_tpu_connector_dsv4_cpu.py
@@ -0,0 +1,224 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CPU test of TPUConnectorDSV4: P gathers + registers, D pulls + scatters
+through a real jax transfer server, with DSV4-like overlaid arrays.
+
+  JAX_PLATFORMS=cpu python -m pytest -q tests/distributed/test_tpu_connector_dsv4_cpu.py
+"""
+import os
+import time
+from types import SimpleNamespace
+
+os.environ.setdefault("XLA_FLAGS",
+                      "--xla_force_host_platform_device_count=2")
+
+import vllm.platforms as _vp  # noqa: E402
+
+# Force the TPU platform on GPU/CPU-only hosts (no libtpu).
+_vp.builtin_platform_plugins = {
+    "tpu": lambda: "tpu_inference.platforms.tpu_platform.TpuPlatform"
+}
+
+import jax  # noqa: E402
+import jax.numpy as jnp  # noqa: E402
+from jax.sharding import Mesh, NamedSharding  # noqa: E402
+from jax.sharding import PartitionSpec as P  # noqa: E402
+import numpy as np  # noqa: E402
+import pytest  # noqa: E402
+import torch  # noqa: E402
+from vllm.v1.kv_cache_interface import (  # noqa: E402
+    MLAAttentionSpec, SlidingWindowMLASpec)
+
+from tpu_inference.distributed import tpu_connector_dsv4 as c4  # noqa: E402
+
+NUM_BLOCKS = 64
+
+
+def _spec_full(bs):
+    return MLAAttentionSpec(block_size=bs, num_kv_heads=1, head_size=8,
+                            dtype=torch.uint8)
+
+
+def _spec_sw(bs, w):
+    return SlidingWindowMLASpec(block_size=bs, num_kv_heads=1, head_size=8,
+                                dtype=torch.uint8, sliding_window=w)
+
+
+# Group layout mimicking DSV4: full groups (CSA attn + rope companion,
+# indexer k_cache, HCA attn) and sliding groups overlaid on the same arrays.
+GROUPS = [
+    SimpleNamespace(kv_cache_spec=_spec_full(16),
+                    layer_names=["l2.attn", "l2.attn.indexer.k_cache"]),
+    SimpleNamespace(kv_cache_spec=_spec_full(16), layer_names=["l3.attn"]),
+    SimpleNamespace(kv_cache_spec=_spec_sw(8, 16),
+                    layer_names=["l0.swa_cache", "l1.swa_cache"]),
+    SimpleNamespace(kv_cache_spec=_spec_sw(4, 8),
+                    layer_names=["l2.attn.compressor.state_cache"]),
+]
+INDEX = {
+    "l2.attn": 0, "l2.attn_rope": 1, "l2.attn.indexer.k_cache": 2,
+    "l3.attn": 3, "l0.swa_cache": 0, "l1.swa_cache": 4,
+    "l2.attn.compressor.state_cache": 2,
+}
+SHAPES = [(NUM_BLOCKS, 4, 4, 8), (NUM_BLOCKS, 1, 4, 8), (NUM_BLOCKS, 1, 4, 16),
+          (NUM_BLOCKS, 8, 4, 8), (NUM_BLOCKS, 4, 4, 8)]
+
+
+def _runner(seed, cache_layout):
+    rng = np.random.default_rng(seed)
+    mesh = Mesh(np.array(jax.devices()[:2]), ("x", ))
+    sh = NamedSharding(mesh, P() if cache_layout == "rep" else P("x"))
+    kv = [jax.device_put(rng.integers(0, 255, s, dtype=np.uint8), sh)
+          for s in SHAPES]
+    return SimpleNamespace(
+        topology_order_id=0, mesh=mesh, kv_caches=kv,
+        kv_cache_config=SimpleNamespace(kv_cache_groups=GROUPS),
+        layer_name_to_kvcache_index=dict(INDEX))
+
+
+def _worker(producer, port, side, seed, xfer, cache_layout):
+    os.environ["TPU_KV_TRANSFER_PORT"] = str(port)
+    os.environ["TPU_SIDE_CHANNEL_PORT"] = str(side)
+    os.environ["DSV4_PD_XFER_LAYOUT"] = xfer
+    cfg = SimpleNamespace(kv_transfer_config=SimpleNamespace(
+        is_kv_producer=producer))
+    w = c4.TPUConnectorDSV4Worker(cfg)
+    w.register_runner(_runner(seed, cache_layout))
+    return w
+
+
+def _alloc(num_tokens, rng, used):
+    """Distinct block ids per group; sliding groups get leading nulls."""
+    out = []
+    for g in GROUPS:
+        info = c4._group_info(g.kv_cache_spec)
+        n = -(-num_tokens // info.block_size)
+        ids = []
+        for i in range(n):
+            if info.sliding_window is not None and (
+                    i + 1) * info.block_size <= num_tokens - info.sliding_window - 1:
+                ids.append(0)
+                continue
+            b = int(rng.integers(1, NUM_BLOCKS))
+            while b in used:
+                b = int(rng.integers(1, NUM_BLOCKS))
+            used.add(b)
+            ids.append(b)
+        out.append(ids)
+    return out
+
+
+LAYOUTS = [("single", "rep"), ("single", "dim0"), ("replicated", "rep"),
+           ("replicated", "dim0")]
+
+
+@pytest.fixture(scope="module", params=range(len(LAYOUTS)),
+                ids=["-".join(x) for x in LAYOUTS])
+def pair(request):
+    xfer, cache_layout = LAYOUTS[request.param]
+    k = request.param * 10
+    p = _worker(True, 19310 + k, 19610 + k, 1, xfer, cache_layout)
+    d = _worker(False, 19320 + k, 19611 + k, 2, xfer, cache_layout)
+    for a in d.runner.kv_caches:
+        assert a.sharding == p.runner.kv_caches[0].sharding
+    return p, d
+
+
+@pytest.mark.parametrize("num_tokens,hit", [(37, 0), (100, 0), (100, 64),
+                                            (130, 96), (16, 0)])
+def test_transfer(pair, num_tokens, hit):
+    p, d = pair
+    chunk = 32
+    rng = np.random.default_rng(num_tokens * 7 + hit)
+    p_ids = _alloc(num_tokens, rng, set())
+    d_ids = _alloc(num_tokens, rng, set())
+    uuid = c4.get_uuid()
+    send = c4.SendMetaDSV4(uuid=uuid, local_block_ids=p_ids,
+                           expiration_time=time.perf_counter() + 60,
+                           num_tokens=num_tokens, chunk_tokens=chunk)
+    p._prepare_kv_and_wait("req-p", send)
+    load = c4.LoadMetaDSV4(uuid=uuid, local_block_ids=d_ids,
+                           remote_block_ids=p_ids, remote_host=p.host_ip,
+                           remote_port=str(p.kv_transfer_port), num_tokens=num_tokens,
+                           chunk_tokens=chunk, local_hit_tokens=hit,
+                           remote_side_port=int(p.side_channel_port))
+    before = [np.asarray(a) for a in d.runner.kv_caches]
+    conn = d._maybe_build_kv_connection(load)
+    plan_pulled = d._pull_kv("req-d", conn, load)
+    d._insert("req-d", uuid, plan_pulled, d_ids, hit)
+    for a, b in zip(d.runner.kv_caches, p.runner.kv_caches):
+        assert a.sharding == b.sharding  # scatter kept the cache layout
+    after = [np.asarray(a) for a in d.runner.kv_caches]
+    src = [np.asarray(a) for a in p.runner.kv_caches]
+
+    plan = c4.plan_entries(num_tokens, chunk, d.groups)
+    expect_written = {}  # (array, block) -> source row
+    for e, eplan in plan.items():
+        if e not in plan_pulled[1]:
+            continue
+        for gid, idxs in eplan.items():
+            bs = d.groups[gid].block_size
+            for i in idxs:
+                if d_ids[gid][i] == 0 or i * bs < hit:
+                    continue
+                for u in d.units_by_group[gid]:
+                    a = d.units[u][0]
+                    expect_written[(a, d_ids[gid][i])] = src[a][p_ids[gid][i]]
+    for a in range(len(SHAPES)):
+        for b in range(NUM_BLOCKS):
+            if (a, b) in expect_written:
+                np.testing.assert_array_equal(after[a][b],
+                                              expect_written[(a, b)])
+            else:
+                np.testing.assert_array_equal(after[a][b], before[a][b])
+    # Every block D needs for attention was written or is a local hit.
+    for gid, g in enumerate(d.groups):
+        for i, lid in enumerate(d_ids[gid]):
+            needed = lid != 0 and (g.sliding_window is None or
+                                   (i + 1) * g.block_size >
+                                   num_tokens - g.sliding_window - 1)
+            if needed and i * g.block_size >= hit:
+                for u in d.units_by_group[gid]:
+                    assert (d.units[u][0], lid) in expect_written
+    # Hit chunks were not pulled.
+    pulled_chunks = [e for e in plan_pulled[1] if e != c4._TAIL_ENTRY]
+    assert all((e + 1) * chunk > hit for e in pulled_chunks)
+    # Release drops every entry.
+    with p._pull_done_lock:
+        p._release_kv("req-p", uuid)
+    assert uuid not in p._send_entries
+
+
+def test_notify_reaches_side_port(pair):
+    p, d = pair
+    uuid = c4.get_uuid()
+    send = c4.SendMetaDSV4(uuid=uuid,
+                           local_block_ids=_alloc(40, np.random.default_rng(0),
+                                                  set()),
+                           expiration_time=time.perf_counter() + 60,
+                           num_tokens=40, chunk_tokens=32)
+    p._prepare_kv_and_wait("req-n", send)
+    load = c4.LoadMetaDSV4(uuid=uuid, local_block_ids=None,
+                           remote_block_ids=None, remote_host=p.host_ip,
+                           remote_port=str(p.kv_transfer_port), remote_side_port=int(p.side_channel_port))
+    sock = d._maybe_build_notif_socket(load)
+    d._notify_pull_done(sock, "req-n", uuid)
+    for _ in range(200):
+        if p.reqs_wait_pull.get("req-n", [None, 0])[1] == -1:
+            break
+        time.sleep(0.01)
+    assert p.reqs_wait_pull["req-n"][1] == -1
+    assert uuid not in p._send_entries
+    done_sending, _ = p.get_finished()
+    assert "req-n" in done_sending
+
+
+def test_plan():
+    groups = [c4.GroupInfo(256, None), c4.GroupInfo(64, 128),
+              c4.GroupInfo(8, 128)]
+    plan = c4.plan_entries(5000, 1024, groups)
+    assert sorted(plan) == [0, 1, 2, 3, 4, c4._TAIL_ENTRY]
+    assert plan[4][0] == list(range(16, 20))
+    assert plan[c4._TAIL_ENTRY][1] == list(range((5000 - 192) // 64, 79))
+    assert plan[c4._TAIL_ENTRY][2] == list(range((5000 - 136) // 8, 625))
+    assert c4.entries_needed(5000, 1024, 2048, plan) == [2, 3, 4,
+                                                         c4._TAIL_ENTRY]
diff --git a/tests/distributed/test_tpu_connector_dsv4_dp_sched_cpu.py b/tests/distributed/test_tpu_connector_dsv4_dp_sched_cpu.py
new file mode 100644
index 000000000..5ccc43c7f
--- /dev/null
+++ b/tests/distributed/test_tpu_connector_dsv4_dp_sched_cpu.py
@@ -0,0 +1,160 @@
+# SPDX-License-Identifier: Apache-2.0
+"""TPUConnectorDSV4 through tpu-inference's DPScheduler (attention DP = 2):
+two rank-scheduler subprocesses each for P and D, DSV4-shaped groups.
+Checks global (rank-offset) block ids in the merged connector metadata and
+that finished_sending / finished_recving reach only the owning rank.
+
+  JAX_PLATFORMS=cpu python -m pytest -q tests/distributed/test_tpu_connector_dsv4_dp_sched_cpu.py
+"""
+from types import SimpleNamespace
+
+import vllm.platforms as _vp
+
+_vp.builtin_platform_plugins = {
+    "tpu": lambda: "tpu_inference.platforms.tpu_platform.TpuPlatform"
+}
+
+from vllm.v1.core.sched.scheduler import Scheduler  # noqa: E402
+from vllm.v1.kv_cache_interface import KVCacheConfig  # noqa: E402
+from vllm.v1.outputs import KVConnectorOutput, ModelRunnerOutput  # noqa
+from vllm.v1.structured_output import StructuredOutputManager  # noqa: E402
+
+from tests.distributed import \
+    test_tpu_connector_dsv4_sched_cpu as base  # noqa: E402
+from tpu_inference.core.sched.dp_scheduler import DPScheduler  # noqa: E402
+from tpu_inference.distributed import tpu_connector_dsv4 as c4  # noqa: E402
+
+NUM_BLOCKS = 4000  # 2000 per rank
+
+
+def _dp_scheduler(role):
+    s = base._scheduler(role)  # reuse its VllmConfig
+    cfg = s.vllm_config
+    cfg.sharding_config = SimpleNamespace(total_dp_size=2)
+    cfg.scheduler_config._original_scheduler_cls = Scheduler
+    kv_cache_config = KVCacheConfig(num_blocks=NUM_BLOCKS,
+                                    kv_cache_tensors=[],
+                                    kv_cache_groups=base._groups())
+    return DPScheduler(vllm_config=cfg,
+                       kv_cache_config=kv_cache_config,
+                       structured_output_manager=StructuredOutputManager(cfg),
+                       block_size=1024,
+                       hash_block_size=base.HASH_BS,
+                       log_stats=True)
+
+
+class Driver:
+    """Fake model runner: tracks computed tokens of the parent's requests."""
+
+    def __init__(self, sched):
+        self.s = sched
+        self.reqs = {}
+        self.computed = {}
+
+    def add(self, req):
+        self.reqs[req.request_id] = req
+        self.computed[req.request_id] = 0
+        self.s.add_request(req)
+
+    def step(self, finished_recving=None, finished_sending=None):
+        so = self.s.schedule()
+        ids = list(so.num_scheduled_tokens)
+        sampled = []
+        for rid in ids:
+            r = self.reqs[rid]
+            if r.kv_transfer_params and self.computed[rid] == 0 and \
+                    so.num_scheduled_tokens[rid] == 1:
+                # D: loaded remotely, recomputes the last prompt token.
+                self.computed[rid] = len(r.prompt_token_ids) - 1
+            self.computed[rid] += so.num_scheduled_tokens[rid]
+            done = self.computed[rid] >= len(r.prompt_token_ids)
+            sampled.append([7] if done else [])
+        out = ModelRunnerOutput(
+            req_ids=ids, req_id_to_index={r: i for i, r in enumerate(ids)},
+            sampled_token_ids=sampled, logprobs=None,
+            prompt_logprobs_dict={}, pooler_output=[],
+            kv_connector_output=KVConnectorOutput(
+                finished_sending=finished_sending,
+                finished_recving=finished_recving))
+        eco = self.s.update_from_output(so, out)
+        return so, eco
+
+
+def _in_rank_range(ids_per_group):
+    ranks = set()
+    for g in ids_per_group:
+        for b in g:
+            if b:
+                ranks.add(b // (NUM_BLOCKS // 2))
+    assert len(ranks) <= 1, ids_per_group
+    return ranks.pop() if ranks else None
+
+
+def test_dp_pd_flow():
+    p = Driver(_dp_scheduler("kv_producer"))
+    d = Driver(_dp_scheduler("kv_consumer"))
+    try:
+        prompts = [[(i * 7919 + k * 13) % 30000 + 10 for i in range(n)]
+                   for k, n in enumerate((5000, 3000, 2600, 4100))]
+        preqs = [base._request(t, 1) for t in prompts]
+        for r in preqs:
+            p.add(r)
+        params, sends = {}, {}
+        for _ in range(60):
+            so, eco = p.step()
+            meta = so.kv_connector_metadata
+            if meta is not None:
+                sends.update(meta.reqs_to_send)
+            for o in eco.values():
+                for x in o.outputs:
+                    if x.kv_transfer_params:
+                        params[x.request_id] = x.kv_transfer_params
+            if len(params) == len(preqs) and len(sends) == len(preqs):
+                break
+        assert len(params) == len(preqs) and len(sends) == len(preqs)
+        p_ranks = {rid: _in_rank_range(m.local_block_ids)
+                   for rid, m in sends.items()}
+        assert set(p_ranks.values()) == {0, 1}, p_ranks  # both ranks used
+
+        dreqs = [base._request(t, 3, params=dict(params[r.request_id],
+                                                 do_remote_prefill=True))
+                 for t, r in zip(prompts, preqs)]
+        for r in dreqs:
+            d.add(r)
+        loads = {}
+        for _ in range(5):
+            so, _ = d.step()
+            if so.kv_connector_metadata is not None:
+                loads.update(so.kv_connector_metadata.reqs_to_load)
+            if len(loads) == len(dreqs):
+                break
+        assert len(loads) == len(dreqs)
+        groups = [c4._group_info(g.kv_cache_spec) for g in base._groups()]
+        for r, pr in zip(dreqs, preqs):
+            m = loads[r.request_id]
+            assert m.remote_block_ids is not None
+            _in_rank_range(m.local_block_ids)
+            base._check_plan(len(r.prompt_token_ids),
+                             sends[pr.request_id].local_block_ids,
+                             m.local_block_ids, m.local_hit_tokens, groups)
+        # Pulls done: each rank gets only its own ids (vLLM asserts).
+        done = {r.request_id for r in dreqs}
+        so, _ = d.step(finished_recving=done)
+        inserts = dict(so.kv_connector_metadata.reqs_to_load
+                       ) if so.kv_connector_metadata else {}
+        for _ in range(3):
+            if len(inserts) == len(dreqs):
+                break
+            so, _ = d.step()
+            if so.kv_connector_metadata is not None:
+                inserts.update(so.kv_connector_metadata.reqs_to_load)
+        assert set(inserts) == done
+        assert all(m.remote_block_ids is None for m in inserts.values())
+        for _ in range(10):
+            d.step()
+        # P frees after D's notifications.
+        p.step(finished_sending={r.request_id for r in preqs})
+        p.step()
+    finally:
+        p.s.shutdown()
+        d.s.shutdown()
diff --git a/tests/distributed/test_tpu_connector_dsv4_sched_cpu.py b/tests/distributed/test_tpu_connector_dsv4_sched_cpu.py
