diff --git a/tpu_inference/runner/pd_debug_dump.py b/tpu_inference/runner/pd_debug_dump.py
new file mode 100644
index 000000000..dffbb531f
--- /dev/null
+++ b/tpu_inference/runner/pd_debug_dump.py
@@ -0,0 +1,155 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Debug dump of one request's runner inputs and KV rows (P/D investigation).
+
+Active only when DSV4_PD_DUMP_DIR is set. For every scheduled request whose id
+contains DSV4_PD_DUMP_MATCH (default "dumpme"), the runner calls dump() right
+before the model forward ("pre", after the KV connector inserted remote KV) and
+right after it ("post"). Each call writes <dir>/<req>/<step>-<phase>.json with:
+  - scheduling state: num_scheduled / num_computed / prompt length, request
+    index, batch size, request distribution, the step's positions;
+  - per KV cache group: the request's block ids and the runner's block-table
+    row for it;
+  - attention metadata of every distinct metadata object (array fields,
+    truncated);
+  - for every non-null block of the request, per array that a layer of the
+    block's group lives on: per-replica byte checksums of the row, keyed by
+    (group, logical block index, array).
+Compare two dumps with pdmini/dump_diff.py.
+"""
+import hashlib
+import json
+import os
+import re
+from typing import Any
+
+import numpy as np
+
+DUMP_DIR = os.getenv("DSV4_PD_DUMP_DIR")
+MATCH = os.getenv("DSV4_PD_DUMP_MATCH", "dumpme")
+_MAX_LIST = 4096
+_step = [0]
+
+
+def enabled() -> bool:
+    return bool(DUMP_DIR)
+
+
+def _arrays_per_group(runner) -> list[list[int]]:
+    index = runner.layer_name_to_kvcache_index
+    out = []
+    for group in runner.kv_cache_config.kv_cache_groups:
+        arrays = []
+        for name in group.layer_names:
+            for n in (name, name + "_rope"):
+                if n in index and index[n] not in arrays:
+                    arrays.append(index[n])
+        out.append(arrays)
+    return out
+
+
+def _row_checksums(row) -> list[str]:
+    shards = getattr(row, "addressable_shards", None)
+    datas = [np.asarray(s.data) for s in shards] if shards else [
+        np.asarray(row)
+    ]
+    out = []
+    for d in datas:
+        b = np.ascontiguousarray(d).tobytes()
+        out.append(hashlib.sha1(b).hexdigest()[:16])
+    return out
+
+
+def _tolist(x: Any):
+    try:
+        a = np.asarray(x)
+    except Exception:  # noqa: BLE001
+        return repr(x)[:200]
+    if a.dtype == object:
+        return repr(x)[:200]
+    flat = a.reshape(-1)
+    return dict(shape=list(a.shape), dtype=str(a.dtype),
+                head=flat[:_MAX_LIST].tolist())
+
+
+def _summarize_metadata(attn_metadata) -> dict:
+    out = {}
+    if attn_metadata is None:
+        return out
+    items = attn_metadata.items() if isinstance(attn_metadata,
+                                                dict) else [("_", attn_metadata)]
+    seen = {}
+    for key, md in items:
+        if id(md) in seen:
+            out[key] = {"same_as": seen[id(md)]}
+            continue
+        seen[id(md)] = key
+        fields = {}
+        names = (list(vars(md)) if hasattr(md, "__dict__") else
+                 [f for f in dir(md) if not f.startswith("_")])
+        for f in names:
+            v = getattr(md, f, None)
+            if callable(v) or v is None or isinstance(v, (str, bool)):
+                if isinstance(v, (str, bool)):
+                    fields[f] = v
+                continue
+            if isinstance(v, (int, float)):
+                fields[f] = v
+            else:
+                fields[f] = _tolist(v)
+        out[key] = fields
+    return out
+
+
+def dump(runner, scheduler_output, phase: str, input_positions=None,
+         attn_metadata=None) -> None:
+    if not enabled():
+        return
+    targets = [r for r in scheduler_output.num_scheduled_tokens if MATCH in r]
+    if not targets:
+        return
+    if phase == "pre":
+        _step[0] += 1
+    groups = _arrays_per_group(runner)
+    ib = runner.input_batch
+    for req_id in targets:
+        idx = ib.req_id_to_index.get(req_id)
+        state = runner.requests.get(req_id)
+        rec = dict(req_id=req_id, phase=phase, step=_step[0],
+                   num_scheduled=int(scheduler_output.num_scheduled_tokens[req_id]))
+        if idx is not None:
+            rec.update(req_index=int(idx),
+                       num_computed=int(ib.num_computed_tokens_cpu[idx]),
+                       num_prompt=int(ib.num_prompt_tokens[idx]),
+                       num_reqs=int(ib.num_reqs),
+                       request_distribution=list(
+                           map(int, ib.request_distribution)))
+        new = [n for n in scheduler_output.scheduled_new_reqs
+               if n.req_id == req_id]
+        if new:
+            rec["new_req_num_computed"] = int(new[0].num_computed_tokens)
+        if input_positions is not None:
+            rec["positions"] = _tolist(input_positions)
+        if attn_metadata is not None:
+            rec["attn_metadata"] = _summarize_metadata(attn_metadata)
+        blocks = []
+        kv = {}
+        if state is not None:
+            for g, ids in enumerate(state.block_ids):
+                row = None
+                if idx is not None:
+                    bt = ib.block_table[g].get_cpu_tensor()
+                    row = bt[idx][:len(ids)].tolist()
+                blocks.append(dict(group=g, block_ids=list(ids),
+                                   block_table_row=row))
+                for li, b in enumerate(ids):
+                    if not b:
+                        continue
+                    for a in groups[g]:
+                        kv[f"{g}/{li}/{a}"] = _row_checksums(
+                            runner.kv_caches[a][b])
+        rec["blocks"] = blocks
+        rec["kv"] = kv
+        d = os.path.join(DUMP_DIR, re.sub(r"[^A-Za-z0-9_.-]", "_", req_id))
+        os.makedirs(d, exist_ok=True)
+        with open(os.path.join(d, f"{_step[0]:04d}-{phase}.json"), "w") as f:
+            json.dump(rec, f)
