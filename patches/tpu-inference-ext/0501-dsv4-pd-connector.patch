index 000000000..3096747c4
--- /dev/null
+++ b/pdmini/fake_vllm.py
@@ -0,0 +1,105 @@
+"""Fake vLLM server for CPU tests of pd_router.py / agent_load.py.
+
+Keeps a prefix cache of 1024-token block hashes, reports cached_tokens and
+Prometheus prefix_cache counters like vLLM; a P request (kv_transfer_params
+do_remote_decode) returns kv_transfer_params, a D request streams tokens.
+
+  python fake_vllm.py --port 8100 --delay-per-1k 0.01
+"""
+import argparse
+import asyncio
+import json
+import sys
+
+import uvicorn
+from fastapi import FastAPI, Request
+from fastapi.responses import JSONResponse, PlainTextResponse, StreamingResponse
+
+sys.path.insert(0, __file__.rsplit("/", 1)[0])
+from pd_router import block_hashes  # noqa: E402
+
+app = FastAPI()
+CACHE: set = set()
+STATS = {"queries": 0, "hits": 0}
+ARGS = None
+
+
+def lookup(ids):
+    hs = block_hashes(ids, 1024)
+    n = 0
+    for h in hs:
+        if h not in CACHE:
+            break
+        n += 1
+    cached = n * 1024
+    STATS["queries"] += len(ids)
+    STATS["hits"] += cached
+    return hs, cached
+
+
+@app.post("/v1/completions")
+async def completions(request: Request):
+    body = await request.json()
+    ids = body["prompt"]
+    hs, cached = lookup(ids)
+    await asyncio.sleep(ARGS.delay_per_1k * (len(ids) - cached) / 1024)
+    CACHE.update(hs)
+    kvp = body.get("kv_transfer_params") or {}
+    usage = dict(prompt_tokens=len(ids), completion_tokens=1,
+                 prompt_tokens_details={"cached_tokens": cached})
+    if kvp.get("do_remote_decode"):
+        return JSONResponse(dict(
+            choices=[dict(index=0, text="x", token_ids=[5])], usage=usage,
+            kv_transfer_params=dict(uuid=hash(tuple(ids)) & 0xffffff,
+                                    num_tokens=len(ids))))
+    n = body.get("max_tokens", 16)
+    if not body.get("stream"):
+        toks = [(len(ids) * 31 + i) % 90000 + 1000 for i in range(n)]
+        CACHE.update(block_hashes(ids + toks, 1024))
+        return JSONResponse(dict(
+            choices=[dict(index=0, text="t" * n, token_ids=toks,
+                          logprobs={"token_logprobs": [-0.5] * n},
+                          finish_reason="length")],
+            usage=dict(usage, completion_tokens=n)))
+
+    async def gen():
+        out = []
+        for i in range(n):
+            await asyncio.sleep(0.002)
+            tok = (len(ids) * 31 + i) % 90000 + 1000
+            out.append(tok)
+            ch = dict(choices=[dict(index=0, text="t", token_ids=[tok],
+                                    logprobs=None, finish_reason=None)])
+            yield f"data: {json.dumps(ch)}\n\n".encode()
+        CACHE.update(block_hashes(ids + out, 1024))
+        u = dict(usage, completion_tokens=n)
+        yield f"data: {json.dumps(dict(choices=[], usage=u))}\n\n".encode()
+        yield b"data: [DONE]\n\n"
+
+    return StreamingResponse(gen(), media_type="text/event-stream")
+
+
+@app.post("/tokenize")
+async def tokenize(request: Request):
+    body = await request.json()
+    return {"tokens": [ord(c) for c in body["prompt"]]}
+
+
+@app.get("/metrics")
+async def metrics():
+    return PlainTextResponse(
+        f'vllm:prefix_cache_queries_total{{engine="0"}} {float(STATS["queries"])}\n'
+        f'vllm:prefix_cache_hits_total{{engine="0"}} {float(STATS["hits"])}\n')
+
+
+@app.get("/health")
+async def health():
+    return {}
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--port", type=int)
+    ap.add_argument("--delay-per-1k", type=float, default=0.005)
+    ARGS = ap.parse_args()
+    uvicorn.run(app, host="127.0.0.1", port=ARGS.port, log_level="warning")
