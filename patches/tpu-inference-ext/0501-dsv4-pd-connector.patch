diff --git a/pdmini/xfer_sweep.py b/pdmini/xfer_sweep.py
new file mode 100644
index 000000000..61240cece
--- /dev/null
+++ b/pdmini/xfer_sweep.py
@@ -0,0 +1,76 @@
+"""KV transfer / TTFT sweep vs prompt length, one request at a time.
+
+  python xfer_sweep.py --url http://127.0.0.1:8000 --mode pd --out pd.jsonl
+  python xfer_sweep.py --url http://127.0.0.1:8300 --mode colo --out colo.jsonl
+
+Every request has a fresh random prompt (no prefix-cache hits anywhere) of
+length L in --lengths, --reps repetitions, max_tokens --output (streamed, TTFT
+measured at the client). A warmup pass over all lengths runs first (compiles
+the gather/scatter/model buckets) and is tagged warmup=true. Prompts are
+seeded identically in both modes, so colocated and P/D see the same inputs.
+"""
+import argparse
+import json
+import random
+import time
+
+import httpx
+
+
+def one(client, url, ids, output, rid):
+    body = dict(model="dsv4-flash", prompt=ids, max_tokens=output,
+                temperature=0.0, ignore_eos=True, stream=True,
+                stream_options={"include_usage": True})
+    t0 = time.time()
+    first = None
+    n = 0
+    with client.stream("POST", url + "/v1/completions", json=body,
+                       headers={"X-Request-Id": rid}) as r:
+        r.raise_for_status()
+        buf = b""
+        for chunk in r.iter_bytes():
+            buf += chunk
+            while b"\n\n" in buf:
+                ev, buf = buf.split(b"\n\n", 1)
+                if not ev.startswith(b"data: ") or ev[6:] == b"[DONE]":
+                    continue
+                j = json.loads(ev[6:])
+                for ch in j.get("choices") or []:
+                    if ch.get("text") is not None:
+                        n += 1
+                        if first is None:
+                            first = time.time()
+    t1 = time.time()
+    return dict(t0=t0, ttft=first - t0 if first else None, e2e=t1 - t0,
+                chunks=n)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--url", required=True)
+    ap.add_argument("--mode", choices=["pd", "colo"], required=True)
+    ap.add_argument("--lengths", default="256,1024,2048,4096,8192,16384,32768")
+    ap.add_argument("--reps", type=int, default=3)
+    ap.add_argument("--output", type=int, default=16)
+    ap.add_argument("--seed", type=int, default=7)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    lengths = [int(x) for x in a.lengths.split(",")]
+    rng = random.Random(a.seed)
+    f = open(a.out, "a")
+    with httpx.Client(timeout=900) as c:
+        for warm in (True, False):
+            for L in lengths:
+                for rep in range(1 if warm else a.reps):
+                    ids = [rng.randrange(1000, 100000) for _ in range(L)]
+                    rid = f"sweep-{a.mode}-{L}-{rep}-{'w' if warm else 'm'}"
+                    rec = one(c, a.url, ids, a.output, rid)
+                    rec.update(id=rid, mode=a.mode, prompt_tokens=L, rep=rep,
+                               warmup=warm)
+                    f.write(json.dumps(rec) + "\n")
+                    f.flush()
+                    print(json.dumps(rec), flush=True)
+
+
+if __name__ == "__main__":
+    main()
