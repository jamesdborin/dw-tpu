+#!/usr/bin/env bash
+# Fair routing comparison: big warmup (compiles every bucket), then rr before affinity.
+#   bash routing2.sh <run-dir>
+set -uo pipefail
+R=${1:?run dir}; K=/opt/dsv4/pdmini; PY=/opt/dsv4/.venv/bin/python
+mkdir -p "$R"
+M="--metrics http://127.0.0.1:8100 http://127.0.0.1:8101 http://127.0.0.1:8200 http://127.0.0.1:8201"
+agent() {  # label policy seed sessions turns shared context output env
+  curl -sf -XPOST "127.0.0.1:8000/router/policy/$2" >/dev/null || return 1
+  $PY "$K/agent_load.py" --url http://127.0.0.1:8000 --label "$1" --seed "$3" --sessions "$4" --turns "$5" \
+    --shared "$6" --context "$7" --output "$8" --env "$9" $M --out "$R/agent.jsonl" >> "$R/agent.txt" 2>&1
+}
+bash "$K/pd_up.sh" "$R" pd affinity || exit 1
+agent warmA affinity 50 32 8 2048 4096 128 1024
+agent warmB rr 51 32 8 2048 4096 128 1024
+agent rr2b rr 4 32 8 2048 4096 128 1024
+agent aff2b affinity 3 32 8 2048 4096 128 1024
+agent rr1b rr 2 16 6 2048 3072 128 768
+agent aff1b affinity 1 16 6 2048 3072 128 768
+echo ROUTING2_DONE >> "$R/agent.txt"
+for u in $(systemctl list-units --plain --no-legend 'dsv4-pdm-*' | awk '{print $1}' | grep -v job); do sudo -n systemctl stop "$u"; done
