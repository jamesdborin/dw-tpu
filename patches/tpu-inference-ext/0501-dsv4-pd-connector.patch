index 000000000..34221d6f2
--- /dev/null
+++ b/pdmini/agent_load.py
@@ -0,0 +1,160 @@
+"""Agent-style multi-turn load through the P/D router.
+
+Each session starts from a prompt = shared system prefix (same for every
+session) + its own context, and every turn appends the generated tokens plus
+--env new "tool output" tokens, so prompts grow and each turn shares its whole
+previous prompt with the next. Sessions run concurrently, turns within a
+session sequentially. Prompts are token ids (random ids from a fixed range),
+so prefix hashing at the router is exact.
+
+  python agent_load.py --url http://127.0.0.1:8000 --sessions 16 --turns 6 \
+     --shared 2048 --context 3072 --output 64 --env 512 --label aff \
+     --metrics http://127.0.0.1:8100 ... --out run.jsonl
+"""
+import argparse
+import asyncio
+import json
+import random
+import time
+
+import httpx
+
+
+async def scrape(urls: list[str]) -> dict:
+    out = {}
+    async with httpx.AsyncClient(timeout=30) as c:
+        for u in urls:
+            try:
+                txt = (await c.get(u + "/metrics")).text
+            except Exception as e:  # noqa: BLE001
+                out[u] = {"error": str(e)}
+                continue
+            vals = {}
+            for line in txt.splitlines():
+                if line.startswith("#") or "prefix_cache" not in line and \
+                        "kv_transfer" not in line and \
+                        "prompt_tokens" not in line and \
+                        "generation_tokens" not in line:
+                    continue
+                try:
+                    name, v = line.rsplit(" ", 1)
+                    name = name.split("{")[0]
+                    vals[name] = vals.get(name, 0.0) + float(v)
+                except ValueError:
+                    pass
+            out[u] = vals
+    return out
+
+
+def delta(a: dict, b: dict) -> dict:
+    return {u: {k: b[u].get(k, 0) - a.get(u, {}).get(k, 0)
+                for k in b[u] if isinstance(b[u].get(k), float)}
+            for u in b}
+
+
+async def one_request(client, url, label, s, t, prompt, args, recs):
+    rid = f"{label}-s{s}-t{t}"
+    body = dict(model=args.model, prompt=prompt, max_tokens=args.output,
+                temperature=0.0, ignore_eos=True, stream=True,
+                return_token_ids=True, session=f"{label}-s{s}")
+    t0 = time.time()
+    first, out_ids, text_chunks = None, [], 0
+    async with client.stream("POST", url + "/v1/completions", json=body,
+                             headers={"X-Request-Id": rid}) as r:
+        r.raise_for_status()
+        buf = b""
+        async for chunk in r.aiter_bytes():
+            buf += chunk
+            while b"\n\n" in buf:
+                ev, buf = buf.split(b"\n\n", 1)
+                if not ev.startswith(b"data: ") or ev[6:] == b"[DONE]":
+                    continue
+                j = json.loads(ev[6:])
+                for ch in j.get("choices") or []:
+                    ids = ch.get("token_ids") or []
+                    if (ids or ch.get("text")) and first is None:
+                        first = time.time()
+                    out_ids.extend(ids)
+                    text_chunks += 1
+    t1 = time.time()
+    recs.append(dict(id=rid, session=s, turn=t, prompt_tokens=len(prompt),
+                     output_tokens=len(out_ids) or text_chunks,
+                     ttft=(first - t0) if first else None, e2e=t1 - t0,
+                     t0=t0, t1=t1))
+    return out_ids
+
+
+async def session(client, url, label, s, args, shared, recs):
+    rng = random.Random(args.seed * 1000 + s)
+    prompt = shared + [rng.randrange(1000, 100000) for _ in range(args.context)]
+    await asyncio.sleep(s * args.stagger)
+    for t in range(args.turns):
+        out = await one_request(client, url, label, s, t, prompt, args, recs)
+        if len(out) < args.output:
+            out = out + [rng.randrange(1000, 100000)
+                         for _ in range(args.output - len(out))]
+        prompt = prompt + out + [rng.randrange(1000, 100000)
+                                 for _ in range(args.env)]
+
+
+def pct(xs, q):
+    xs = sorted(x for x in xs if x is not None)
+    if not xs:
+        return None
+    return xs[min(len(xs) - 1, int(q * len(xs)))]
+
+
+async def main_async(args):
+    rng = random.Random(args.seed)
+    shared = [rng.randrange(1000, 100000) for _ in range(args.shared)]
+    before = await scrape(args.metrics)
+    recs: list[dict] = []
+    t0 = time.time()
+    limits = httpx.Limits(max_connections=args.sessions + 8)
+    async with httpx.AsyncClient(timeout=None, limits=limits) as client:
+        await asyncio.gather(*[
+            session(client, args.url, args.label, s, args, shared, recs)
+            for s in range(args.sessions)
+        ])
+    t1 = time.time()
+    after = await scrape(args.metrics)
+    dur = t1 - t0
+    summary = dict(
+        label=args.label, sessions=args.sessions, turns=args.turns,
+        requests=len(recs), duration_s=dur,
+        output_tok_s=sum(r["output_tokens"] for r in recs) / dur,
+        prompt_tok_s=sum(r["prompt_tokens"] for r in recs) / dur,
+        ttft_mean=sum(r["ttft"] for r in recs if r["ttft"]) / max(
+            1, sum(1 for r in recs if r["ttft"])),
+        ttft_p50=pct([r["ttft"] for r in recs], 0.5),
+        ttft_p90=pct([r["ttft"] for r in recs], 0.9),
+        e2e_p50=pct([r["e2e"] for r in recs], 0.5),
+        metrics_delta=delta(before, after), args=vars(args))
+    with open(args.out, "a") as f:
+        for r in recs:
+            f.write(json.dumps(dict(r, label=args.label)) + "\n")
+        f.write(json.dumps(dict(summary=summary)) + "\n")
+    print(json.dumps({k: v for k, v in summary.items()
+                      if k not in ("metrics_delta", "args")}, indent=1))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--url", default="http://127.0.0.1:8000")
+    ap.add_argument("--model", default="dsv4-flash")
+    ap.add_argument("--sessions", type=int, default=16)
+    ap.add_argument("--turns", type=int, default=6)
+    ap.add_argument("--shared", type=int, default=2048)
+    ap.add_argument("--context", type=int, default=3072)
+    ap.add_argument("--output", type=int, default=64)
+    ap.add_argument("--env", type=int, default=512)
+    ap.add_argument("--stagger", type=float, default=0.25)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--label", default="run")
+    ap.add_argument("--metrics", nargs="*", default=[])
+    ap.add_argument("--out", required=True)
+    asyncio.run(main_async(ap.parse_args()))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pdmini/align_probe.py b/pdmini/align_probe.py
new file mode 100644
index 000000000..ff64b7ba6
--- /dev/null
+++ b/pdmini/align_probe.py
@@ -0,0 +1,45 @@
+"""Which D-side resume alignment gives correct P/D output?
+
+For each alignment A and prompt length L: a fresh random prompt is first run
+cold and colocated on a prefill instance (no transfer: reference), then through
+the router with pd_recompute_align=A. Greedy tokens are compared.
+
+  python align_probe.py --ref http://127.0.0.1:8101 --router http://127.0.0.1:8000
+"""
+import argparse
+import random
+
+import httpx
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--ref", default="http://127.0.0.1:8101")
+ap.add_argument("--router", default="http://127.0.0.1:8000")
+ap.add_argument("--aligns", default="1,4,8,128,1024")
+ap.add_argument("--lengths", default="777,2600,5000,9300")
+ap.add_argument("--seed", type=int, default=2024)
+a = ap.parse_args()
+rng = random.Random(a.seed)
+
+
+def run(c, url, ids, extra=None):
+    body = dict(model="dsv4-flash", prompt=ids, max_tokens=16,
+                temperature=0.0, ignore_eos=True, return_token_ids=True,
+                logprobs=1)
+    body.update(extra or {})
+    r = c.post(url + "/v1/completions", json=body)
+    r.raise_for_status()
+    ch = r.json()["choices"][0]
+    return ch["token_ids"], (ch.get("logprobs") or {}).get("token_logprobs")
+
+
+with httpx.Client(timeout=600) as c:
+    for A in [int(x) for x in a.aligns.split(",")]:
+        for L in [int(x) for x in a.lengths.split(",")]:
+            ids = [rng.randrange(1000, 100000) for _ in range(L)]
+            ref, ref_lp = run(c, a.ref, ids)
+            pd, pd_lp = run(c, a.router, ids, {"pd_recompute_align": A})
+            d = max((abs(x - y) for x, y in zip(ref_lp or [], pd_lp or [])
+                     if x is not None and y is not None), default=None)
+            print(f"align={A} L={L} T={(L - 1) // A * A if A > 1 else L} "
+                  f"{'EQUAL' if ref == pd else 'DIFF'} max|dlogp|={d} "
+                  f"ref={ref[:6]} pd={pd[:6]}", flush=True)
diff --git a/pdmini/analyze.py b/pdmini/analyze.py
new file mode 100644
index 000000000..1825ce469
--- /dev/null
+++ b/pdmini/analyze.py
@@ -0,0 +1,172 @@
+"""Tables for the P/D mini report from one run directory.
+
+  python analyze.py sweep <run-dir> [colo-sweep.jsonl]
+  python analyze.py routing <run-dir> <agent.jsonl> [label ...]
+
+Inputs in <run-dir>: router.jsonl, P0.log P1.log D0.log D1.log (PDSEND /
+PDPULL / PDINSERT lines from TPUConnectorDSV4), pd-sweep.jsonl.
+"""
+import collections
+import json
+import os
+import re
+import statistics
+import sys
+
+LINE = re.compile(r"(PDSEND|PDPULL|PDINSERT) (\{.*\})")
+
+
+def load_jsonl(path):
+    out = []
+    if not os.path.exists(path):
+        return out
+    for line in open(path):
+        line = line.strip()
+        if line:
+            out.append(json.loads(line))
+    return out
+
+
+def connector_events(run):
+    ev = collections.defaultdict(dict)  # uuid -> {kind: rec}
+    for name in ("P0", "P1", "D0", "D1"):
+        p = os.path.join(run, name + ".log")
+        if not os.path.exists(p):
+            continue
+        for line in open(p, errors="replace"):
+            m = LINE.search(line)
+            if m:
+                rec = json.loads(m.group(2))
+                rec["copy"] = name
+                ev[rec["uuid"]][m.group(1)] = rec
+    return ev
+
+
+def med(xs):
+    xs = [x for x in xs if x is not None]
+    return statistics.median(xs) if xs else None
+
+
+def fmt(x, nd=1):
+    if x is None:
+        return "-"
+    if isinstance(x, float):
+        return f"{x:.{nd}f}"
+    return str(x)
+
+
+def sweep(run, colo_path=None):
+    router = {r["id"]: r for r in load_jsonl(os.path.join(run, "router.jsonl"))}
+    ev = connector_events(run)
+    pd = [r for r in load_jsonl(os.path.join(run, "pd-sweep.jsonl"))
+          if not r["warmup"]]
+    colo = {}
+    if colo_path:
+        for r in load_jsonl(colo_path):
+            if not r["warmup"]:
+                colo.setdefault(r["prompt_tokens"], []).append(r["ttft"])
+    by_len = collections.defaultdict(list)
+    for r in pd:
+        rr = router.get(r["id"], {})
+        e = ev.get(rr.get("uuid"), {})
+        by_len[r["prompt_tokens"]].append((r, rr, e))
+    print("| prompt tokens | KV bytes | tail bytes | (bytes-tail)/token | entries | gather ms (P) |"
+          " pull ms (D) | GB/s | Mtok/s | insert ms | P phase ms | D phase ms |"
+          " TTFT P/D ms | TTFT colo ms | P/D overhead ms |")
+    print("|" + "---|" * 15)
+    for L in sorted(by_len):
+        rows = by_len[L]
+        nbytes = med([e.get("PDPULL", {}).get("bytes") for _, _, e in rows])
+        pull = med([e.get("PDPULL", {}).get("pull_ms") for _, _, e in rows])
+        gather = med([e.get("PDSEND", {}).get("gather_ms") for _, _, e in rows])
+        ins = med([e.get("PDINSERT", {}).get("insert_ms") for _, _, e in rows])
+        ent = med([e.get("PDPULL", {}).get("entries_pulled") for _, _, e in rows])
+        tail = med([e.get("PDPULL", {}).get("tail_bytes") for _, _, e in rows])
+        pph = med([(rr["t_prefill"] - rr["t0"]) * 1e3 for _, rr, _ in rows
+                   if "t_prefill" in rr])
+        dph = med([(rr["t_first"] - rr["t_prefill"]) * 1e3 for _, rr, _ in rows
+                   if rr.get("t_first")])
+        ttft = med([r["ttft"] * 1e3 for r, _, _ in rows if r["ttft"]])
+        cttft = med([t * 1e3 for t in colo.get(L, []) if t])
+        gbps = nbytes / (pull / 1e3) / 1e9 if nbytes and pull else None
+        mtok = L / (pull / 1e3) / 1e6 if pull else None
+        per_tok = (nbytes - (tail or 0)) / L if nbytes else None
+        print(f"| {L} | {fmt(nbytes)} | {fmt(tail)} | {fmt(per_tok)} |"
+              f" {fmt(ent)} | {fmt(gather)} | {fmt(pull)} | {fmt(gbps, 2)} |"
+              f" {fmt(mtok, 2)} | {fmt(ins)} | {fmt(pph)} | {fmt(dph)} |"
+              f" {fmt(ttft)} | {fmt(cttft)} |"
+              f" {fmt(ttft - cttft if ttft and cttft else None)} |")
+
+
+def routing(run, agent_path, labels):
+    router = load_jsonl(os.path.join(run, "router.jsonl"))
+    ev = connector_events(run)
+    agent = load_jsonl(agent_path)
+    summaries = {r["summary"]["label"]: r["summary"] for r in agent
+                 if "summary" in r}
+    labels = labels or list(summaries)
+    print("| run | policy | requests | P0/P1/D0/D1 requests | P on longest-cached copy |"
+          " D on longest-cached copy | P cached-token rate | D local-hit rate |"
+          " KV bytes pulled | TTFT p50 ms | TTFT p90 ms | out tok/s | prompt tok/s |")
+    print("|" + "---|" * 13)
+    for lab in labels:
+        rs = [r for r in router if r["id"].startswith(lab + "-")]
+        if not rs:
+            continue
+        cnt = collections.Counter([r["p"] for r in rs] + [r["d"] for r in rs])
+        pw = [r for r in rs if r["p_best_blocks"] > 0]
+        dw = [r for r in rs if r["d_best_blocks"] > 0]
+        p_on = sum(r["p_match_blocks"] == r["p_best_blocks"] for r in pw)
+        d_on = sum(r["d_match_blocks"] == r["d_best_blocks"] for r in dw)
+        ptoks = sum(r["prompt_tokens"] for r in rs)
+        pcached = sum(r.get("p_cached_tokens") or 0 for r in rs)
+        dhit = sum(ev.get(r.get("uuid"), {}).get("PDPULL", {}).get(
+            "local_hit_tokens", 0) for r in rs)
+        nbytes = sum(ev.get(r.get("uuid"), {}).get("PDPULL", {}).get(
+            "bytes", 0) for r in rs)
+        s = summaries.get(lab, {})
+        print(f"| {lab} | {rs[0]['policy']} | {len(rs)} |"
+              f" {cnt['P0']}/{cnt['P1']}/{cnt['D0']}/{cnt['D1']} |"
+              f" {p_on}/{len(pw)} | {d_on}/{len(dw)} |"
+              f" {pcached / ptoks:.1%} | {dhit / ptoks:.1%} |"
+              f" {nbytes / 1e6:.1f} MB |"
+              f" {fmt((s.get('ttft_p50') or 0) * 1e3)} |"
+              f" {fmt((s.get('ttft_p90') or 0) * 1e3)} |"
+              f" {fmt(s.get('output_tok_s'))} | {fmt(s.get('prompt_tok_s'), 0)} |")
+    print()
+    print("Per-copy prefix cache (Prometheus deltas, tokens):")
+    print("| run | copy | queries | hits | hit rate |")
+    print("|---|---|---|---|---|")
+    for lab in labels:
+        md = summaries.get(lab, {}).get("metrics_delta", {})
+        for url, vals in md.items():
+            q = vals.get("vllm:prefix_cache_queries_total", 0)
+            h = vals.get("vllm:prefix_cache_hits_total", 0)
+            print(f"| {lab} | {url} | {q:.0f} | {h:.0f} |"
+                  f" {h / q if q else 0:.1%} |")
+    print()
+    print("Per-copy cached-token rate from responses:")
+    print("| run | copy | requests | prompt tokens | cached / local-hit tokens | rate |")
+    print("|---|---|---|---|---|---|")
+    for lab in labels:
+        rs = [r for r in router if r["id"].startswith(lab + "-")]
+        for copy in ("P0", "P1"):
+            sub = [r for r in rs if r["p"] == copy]
+            t = sum(r["prompt_tokens"] for r in sub)
+            c = sum(r.get("p_cached_tokens") or 0 for r in sub)
+            print(f"| {lab} | {copy} | {len(sub)} | {t} | {c} |"
+                  f" {c / t if t else 0:.1%} |")
+        for copy in ("D0", "D1"):
+            sub = [r for r in rs if r["d"] == copy]
+            t = sum(r["prompt_tokens"] for r in sub)
+            c = sum(ev.get(r.get("uuid"), {}).get("PDPULL", {}).get(
+                "local_hit_tokens", 0) for r in sub)
+            print(f"| {lab} | {copy} | {len(sub)} | {t} | {c} |"
+                  f" {c / t if t else 0:.1%} |")
+
+
+if __name__ == "__main__":
+    if sys.argv[1] == "sweep":
+        sweep(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else None)
+    else:
+        routing(sys.argv[2], sys.argv[3], sys.argv[4:])
diff --git a/pdmini/bisect_probe.py b/pdmini/bisect_probe.py
new file mode 100644
index 000000000..41702ac29
--- /dev/null
+++ b/pdmini/bisect_probe.py
@@ -0,0 +1,45 @@
+"""Bisect the P/D decode mismatch: which transferred part breaks D?
+
+  python bisect_probe.py
+Prompt X (fresh, L tokens):
+  ref    X cold on P1 (colocated reference)
+  local  X directly on D1 (D's own compute; also fills D1's prefix cache)
+  tail   X via P0 -> D1: D1 holds the full 1024-blocks locally, pulls only the
+         last chunk + the sliding-window / compressor-state tail
+  tail2  same with align 1024 (D1 loads nothing, computes the rest: control)
+Prompt Y (fresh): P0 -> D0 full transfer (align 1), for comparison.
+"""
+import json
+import random
+
+import httpx
+
+P1, D1, ROUTER = "http://127.0.0.1:8101", "http://127.0.0.1:8201", "http://127.0.0.1:8000"
+rng = random.Random(77)
+
+
+def run(c, url, ids, extra=None):
+    body = dict(model="dsv4-flash", prompt=ids, max_tokens=8, temperature=0.0,
+                ignore_eos=True, return_token_ids=True)
+    body.update(extra or {})
+    r = c.post(url + "/v1/completions", json=body)
+    r.raise_for_status()
+    j = r.json()
+    return j["choices"][0]["token_ids"], json.dumps(j.get("router", {}).get("uuid"))
+
+
+with httpx.Client(timeout=600) as c:
+    for L in (5000, 2600, 9300):
+        X = [rng.randrange(1000, 100000) for _ in range(L)]
+        ref, _ = run(c, P1, X)
+        loc, _ = run(c, D1, X)
+        tail, u1 = run(c, ROUTER, X, {"pd_force": {"p": 0, "d": 1}})
+        tail2, u2 = run(c, ROUTER, X, {"pd_force": {"p": 0, "d": 1},
+                                       "pd_recompute_align": 1024})
+        Y = [rng.randrange(1000, 100000) for _ in range(L)]
+        refy, _ = run(c, P1, Y)
+        full, u3 = run(c, ROUTER, Y, {"pd_force": {"p": 0, "d": 0}})
+        eq = lambda a: "EQUAL" if a == ref else "DIFF"
+        print(f"L={L} ref={ref} local={eq(loc)} tail={eq(tail)} uuid={u1} "
+              f"tail2={eq(tail2)} full={'EQUAL' if full == refy else 'DIFF'} "
+              f"uuid={u3}", flush=True)
diff --git a/pdmini/build_mini.py b/pdmini/build_mini.py
new file mode 100644
index 000000000..91966df9a
--- /dev/null
+++ b/pdmini/build_mini.py
@@ -0,0 +1,106 @@
+"""Build a layer-truncated DSV4 Flash checkpoint from a local full checkpoint.
+
+  python build_mini.py /opt/dsv4/ckpt/dsv4-flash-full /opt/dsv4/ckpt/dsv4-flash-5L --layers 5
+
+Keeps layers [0, N), embed, head, norm, hc_head*; drops mtp.* and the other
+layers. Tensors are copied bit-exactly. Same logic as
+dsv4-tpu/scripts/build_mini_ckpt.py, but reads the local checkpoint instead of
+the Hub. Prints the kept compress_ratios and a digest of every kept tensor.
+"""
+import argparse
+import hashlib
+import json
+import os
+import re
+import shutil
+
+from safetensors import safe_open
+from safetensors.torch import save_file
+
+
+LAYER_RE = re.compile(r"((?:model\.)?layers\.)(\d+)\.")
+
+
+def keep(name: str, sel: list[int]) -> bool:
+    m = LAYER_RE.match(name)
+    if m:
+        return int(m.group(2)) in sel
+    return not (name.startswith("mtp.") or name.startswith("model.mtp."))
+
+
+def rename(name: str, sel: list[int]) -> str:
+    """Renumber selected source layers to 0..len(sel)-1."""
+    return LAYER_RE.sub(
+        lambda m: f"{m.group(1)}{sel.index(int(m.group(2)))}.", name, count=1)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("src")
+    ap.add_argument("out")
+    ap.add_argument("--layers", type=int, default=5)
+    ap.add_argument("--select", default=None,
+                    help="comma list of source layers to keep, renumbered "
+                    "0..n-1 (default: the first --layers layers)")
+    a = ap.parse_args()
+    sel = ([int(x) for x in a.select.split(",")]
+           if a.select else list(range(a.layers)))
+    os.makedirs(a.out, exist_ok=True)
+    for f in os.listdir(a.src):
+        p = os.path.join(a.src, f)
+        if os.path.isfile(p) and not f.endswith(".safetensors") and \
+                f != "model.safetensors.index.json":
+            shutil.copy(p, os.path.join(a.out, f))
+        elif os.path.isdir(p) and f not in (".cache", ):
+            shutil.copytree(p, os.path.join(a.out, f), dirs_exist_ok=True)
+
+    cfg = json.load(open(os.path.join(a.src, "config.json")))
+    print("full compress_ratios", cfg["compress_ratios"][:8], "...",
+          "num_hidden_layers", cfg["num_hidden_layers"])
+    ratios = cfg["compress_ratios"]
+    nhash = cfg.get("num_hash_layers", 0)
+    is_hash = [s < nhash for s in sel]
+    # Hash-routed MoE layers must stay a prefix after renumbering.
+    assert is_hash == sorted(is_hash, reverse=True), (sel, nhash)
+    cfg["num_hidden_layers"] = len(sel)
+    cfg["compress_ratios"] = [ratios[s] for s in sel]
+    if "num_hash_layers" in cfg:
+        cfg["num_hash_layers"] = sum(is_hash)
+    cfg["num_nextn_predict_layers"] = 0
+    json.dump(cfg, open(os.path.join(a.out, "config.json"), "w"), indent=2)
+
+    wmap = json.load(open(os.path.join(
+        a.src, "model.safetensors.index.json")))["weight_map"]
+    shards = sorted({f for k, f in wmap.items() if keep(k, sel)})
+    new_map, digest = {}, hashlib.sha256()
+    for i, shard in enumerate(shards):
+        out_name = f"model-{i + 1:05d}-of-{len(shards):05d}.safetensors"
+        tensors = {}
+        with safe_open(os.path.join(a.src, shard), "pt") as fh:
+            meta = fh.metadata()
+            for k in sorted(fh.keys()):
+                if keep(k, sel):
+                    tensors[rename(k, sel)] = fh.get_tensor(k)
+        for k in sorted(tensors):
+            new_map[k] = out_name
+        save_file(tensors, os.path.join(a.out, out_name), metadata=meta)
+        print(f"{shard} -> {out_name}: {len(tensors)} tensors", flush=True)
+    import torch
+    for k in sorted(new_map):
+        with safe_open(os.path.join(a.out, new_map[k]), "pt") as fh:
+            t = fh.get_tensor(k)
+        digest.update(k.encode())
+        digest.update(t.contiguous().view(-1).view(torch.uint8).numpy().tobytes())
+    total = sum(os.path.getsize(os.path.join(a.out, f))
+                for f in set(new_map.values()))
+    json.dump({"metadata": {"total_size": total}, "weight_map": new_map},
+              open(os.path.join(a.out, "model.safetensors.index.json"), "w"),
+              indent=2)
+    print("selected layers", sel, "num_hash_layers",
+          cfg.get("num_hash_layers"))
+    print("compress_ratios", cfg["compress_ratios"])
+    print(f"DIGEST {digest.hexdigest()} tensors={len(new_map)} bytes={total}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pdmini/chip_probe.sh b/pdmini/chip_probe.sh
new file mode 100755
index 000000000..449c41d93
--- /dev/null
+++ b/pdmini/chip_probe.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# Find working 2-chip subslices on one v6e-8 host (2x4).
+#   bash chip_probe.sh coords                      # 8-chip process: print id -> coords
+#   bash chip_probe.sh pairs "0,1 2,3 4,5 6,7" 1,2,1  # 4 concurrent 2-chip processes
+# Each process: TPU_VISIBLE_CHIPS=<pair>, TPU_CHIPS_PER_PROCESS_BOUNDS=<bounds>,
+# TPU_PROCESS_BOUNDS=1,1,1, own TPU_PROCESS_PORT; runs a psum and a matmul.
+set -uo pipefail
+PY=/opt/dsv4/.venv/bin/python
+export LIBTPU_INIT_ARGS=--enable_tpunetd_client=false PYTHONUNBUFFERED=1
+unset JAX_PLATFORMS
+OUT=${OUT:-/opt/dsv4/pdmini/probe}; mkdir -p "$OUT"
+case "${1:?mode}" in
+coords)
+  timeout 300 $PY -c '
+import jax
+for d in jax.devices(): print("dev", d.id, "coords", d.coords, "core", d.core_on_chip)
+' 2>&1 | grep -v "^WARNING" | tee "$OUT/coords.txt" ;;
+pairs)
+  PAIRS=${2:?pairs}; BOUNDS=${3:?bounds}; i=0; pids=()
+  for pr in $PAIRS; do
+    ( env TPU_VISIBLE_CHIPS=$pr TPU_CHIPS_PER_PROCESS_BOUNDS=$BOUNDS TPU_PROCESS_BOUNDS=1,1,1 \
+        TPU_PROCESS_PORT=$((8476 + i)) \
+        timeout 300 $PY -c '
+import time, jax, jax.numpy as jnp
+d = jax.devices(); print("devices", [(x.id, x.coords) for x in d])
+x = jax.pmap(lambda v: jax.lax.psum(v, "i"), axis_name="i")(jnp.arange(len(d), dtype=jnp.float32))
+a = jnp.ones((8192, 8192), jnp.bfloat16); f = jax.jit(lambda a: a @ a); f(a).block_until_ready()
+t = time.perf_counter(); [f(a).block_until_ready() for _ in range(10)]
+print("PAIR_OK n=%d psum=%s matmul_ms=%.2f" % (len(d), float(x[0]), (time.perf_counter() - t) * 100))
+' > "$OUT/pair-$i.txt" 2>&1; echo "pair $pr rc=$?" >> "$OUT/pair-$i.txt" ) &
+    pids+=($!); i=$((i + 1))
+  done
+  wait "${pids[@]}"
+  for f in "$OUT"/pair-*.txt; do echo "== $f"; grep -E "devices|PAIR_OK|rc=|Error|error" "$f" | tail -4; done ;;
+esac
diff --git a/pdmini/correctness.py b/pdmini/correctness.py
new file mode 100644
index 000000000..78bcbceeb
--- /dev/null
+++ b/pdmini/correctness.py
@@ -0,0 +1,129 @@
+"""Greedy tokens + logprobs: P/D pipeline (router) vs a colocated instance.
+
+Phase "colo": run every case against the colocated instance, save JSON.
+Phase "pd":   run the same cases through the router, save JSON.
+Phase "compare": diff the two (tokens exact, chosen-token logprob max |diff|,
+top-5 id sets).
+
+  python correctness.py colo --url http://127.0.0.1:8300 --out colo.json
+  python correctness.py pd   --url http://127.0.0.1:8000 --out pd.json
+  python correctness.py compare colo.json pd.json
+
+Cases (all token-id prompts, so both sides see identical inputs):
+  real prompts from dsv4-tpu prompts.json (17 .. ~2.6k tokens) and synthetic
+  1500/5000/12000/30000-token prompts, each run
+    fresh   first time on both sides
+    repeat  same prompt again (P and D both hold it: D pulls nothing or the
+            tail only; colocated: prefix-cache hit)
+  plus "branch" prompts that share the first 4096 tokens of the 12000 case
+  (D holds 4 chunks and pulls only the rest).
+"""
+import argparse
+import json
+import random
+import sys
+import time
+
+import httpx
+
+PROMPTS = "/opt/dsv4/pdmini/prompts.json"
+
+
+def cases():
+    out = []
+    d = json.load(open(PROMPTS))
+    for p in d["base"] + d["branch"][:3]:
+        out.append((p["name"], p["ids"]))
+    rng = random.Random(1234)
+    syn = {n: [rng.randrange(1000, 100000) for _ in range(n)]
+           for n in (1500, 5000, 12000, 30000)}
+    for n, ids in syn.items():
+        out.append((f"syn{n}", ids))
+    run = [(name + ":fresh", ids) for name, ids in out]
+    run += [(name + ":repeat", ids) for name, ids in out]
+    base = syn[12000][:4096]
+    for k in range(3):
+        tail = [rng.randrange(1000, 100000) for _ in range(1000 + 700 * k)]
+        run.append((f"branch4096_{k}:fresh", base + tail))
+    return run
+
+
+def query(client, url, ids, max_tokens):
+    body = dict(model="dsv4-flash", prompt=ids, max_tokens=max_tokens,
+                temperature=0.0, logprobs=5, return_token_ids=True,
+                ignore_eos=True)
+    t0 = time.time()
+    r = client.post(url + "/v1/completions", json=body)
+    r.raise_for_status()
+    j = r.json()
+    ch = j["choices"][0]
+    lp = ch.get("logprobs") or {}
+    return dict(token_ids=ch.get("token_ids"), text=ch.get("text"),
+                token_logprobs=lp.get("token_logprobs"),
+                top_logprobs=lp.get("top_logprobs"),
+                usage=j.get("usage"), router=j.get("router"),
+                latency=time.time() - t0)
+
+
+def run(args):
+    res = {}
+    with httpx.Client(timeout=600) as c:
+        for name, ids in cases():
+            res[name] = dict(prompt_len=len(ids),
+                             **query(c, args.url, ids, args.max_tokens))
+            r = res[name]
+            print(name, len(ids), r["token_ids"][:8] if r["token_ids"] else
+                  r["text"][:40], "%.2fs" % r["latency"], flush=True)
+    json.dump(res, open(args.out, "w"))
+
+
+def compare(a_path, b_path):
+    a, b = json.load(open(a_path)), json.load(open(b_path))
+    worst, ok = 0.0, True
+    rows = []
+    for name in a:
+        x, y = a[name], b.get(name)
+        if y is None:
+            rows.append((name, "missing"))
+            ok = False
+            continue
+        tok_eq = x["token_ids"] == y["token_ids"]
+        first_div = next((i for i, (p, q) in enumerate(
+            zip(x["token_ids"] or [], y["token_ids"] or [])) if p != q), None)
+        n = len(x["token_logprobs"] or [])
+        if first_div is not None:
+            n = first_div
+        diffs = [abs(p - q) for p, q in zip(x["token_logprobs"][:n],
+                                            y["token_logprobs"][:n])
+                 if p is not None and q is not None]
+        mx = max(diffs) if diffs else 0.0
+        top_eq = sum(
+            set(p) == set(q) for p, q in zip(x["top_logprobs"][:n],
+                                             y["top_logprobs"][:n]))
+        worst = max(worst, mx)
+        ok &= tok_eq
+        rows.append((name, x["prompt_len"], "tokens_equal" if tok_eq else
+                     f"DIVERGE@{first_div}", f"max|dlogp|={mx:.3g}",
+                     f"top5_sets_equal={top_eq}/{n}",
+                     "bitexact" if tok_eq and mx == 0 else ""))
+    for r in rows:
+        print(" | ".join(str(v) for v in r))
+    print(f"ALL_TOKENS_EQUAL={ok} worst_max_abs_logprob_diff={worst:.3g}")
+    return 0 if ok else 1
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("phase", choices=["colo", "pd", "compare"])
+    ap.add_argument("files", nargs="*")
+    ap.add_argument("--url")
+    ap.add_argument("--out")
+    ap.add_argument("--max-tokens", type=int, default=32)
+    args = ap.parse_args()
+    if args.phase == "compare":
+        sys.exit(compare(*args.files))
+    run(args)
+
+
+if __name__ == "__main__":
+    main()
