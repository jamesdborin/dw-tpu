diff --git a/tpu_inference/layers/common/shared_expert_tp.py b/tpu_inference/layers/common/shared_expert_tp.py
new file mode 100644
index 000000000..afd9aa716
--- /dev/null
+++ b/tpu_inference/layers/common/shared_expert_tp.py
@@ -0,0 +1,104 @@
+# Copyright 2026 Google LLC
