+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Shared expert computed tensor-parallel inside the routed MoE (MOE_SHARED_EXPERT_TP).
+
+With attention data parallelism every chip holds the whole shared expert and
+runs it on its own few rows: at decode each chip streams ~25 MB of FP8 weights
+per DeepSeek V4 layer to multiply 1-4 rows. The routed experts already
+all-gather every row to every chip and reduce-scatter per-chip partial sums.
+Here the shared expert is sliced like a routed expert instead: chip c holds
+columns [c*I/tp, (c+1)*I/tp) of gate and up and the matching rows of down
+(bf16, dequantized exactly: the FP8 block scales are powers of two), computes
+its partial output for all gathered rows, and the routed reduce-scatter sums
+it with the routed partials. No extra collective; ~1.5 MB of weights per chip.
+Only the summation order of the shared expert's down projection changes.
+"""
+
+import jax
+import jax.numpy as jnp
+from jax.sharding import Mesh, NamedSharding
+from jax.sharding import PartitionSpec as P
+
+from tpu_inference.layers.common.sharding import ShardingAxisName
+
+
+def dequantize_block_fp8(w: jax.Array, s: jax.Array | None,
+                         dtype=jnp.bfloat16) -> jax.Array:
+    """[K, N] fp8 weight with per-(K block, column) scales -> [K, N] dtype.
+
+    ``s`` is any of [nb, N], [nb, 1, N], [1, nb, 1, N] (gmm layouts). With
+    power-of-two scales the result is exact in bf16.
+    """
+    k, n = w.shape
+    if s is None:
+        return w.astype(dtype)
+    s = jnp.asarray(s, jnp.float32)
+    assert s.size % n == 0, (s.shape, w.shape)
+    nb = s.size // n
+    s = s.reshape(nb, n)
+    assert k % nb == 0, (k, nb)
+    wf = w.astype(jnp.float32).reshape(nb, k // nb, n) * s[:, None, :]
+    return wf.reshape(k, n).astype(dtype)
+
+
+def build_tp_shared_expert(w_gate: jax.Array, w_up: jax.Array,
+                           w_down: jax.Array, *, mesh: Mesh,
+                           dtype=jnp.bfloat16):
+    """Dense [H, I] gate/up and [I, H] down -> TP-sliced arrays.
+
+    Returns (w_gu [H, tp * 2 * I/tp], w_down [I, H]) sharded on MLP_TENSOR so
+    shard c holds [gate cols | up cols] of slice c and down rows of slice c.
+    """
+    tp = 1
+    axes = ShardingAxisName.MLP_TENSOR
+    for a in ((axes, ) if isinstance(axes, str) else axes):
+        tp *= mesh.shape.get(a, 1)
+    h, i = w_gate.shape
+    assert w_up.shape == (h, i) and w_down.shape == (i, h), (w_gate.shape,
+                                                            w_up.shape,
+                                                            w_down.shape)
+    assert i % tp == 0, (i, tp)
+    loc = i // tp
+    gu = jnp.stack([w_gate.reshape(h, tp, loc),
+                    w_up.reshape(h, tp, loc)], axis=2)  # [H, tp, 2, loc]
+    gu = gu.reshape(h, tp * 2 * loc).astype(dtype)
+    gu = jax.device_put(gu, NamedSharding(mesh, P(None, axes)))
+    down = jax.device_put(w_down.astype(dtype),
+                          NamedSharding(mesh, P(axes, None)))
+    return gu, down
+
+
+def silu_and_mul_clamp(gate_up: jax.Array, limit: float | None) -> jax.Array:
+    """Same op sequence as vLLM SiluAndMulWithClamp.forward_native (alpha=1,
+    beta=0) / SiluAndMul, in the input dtype."""
+    d = gate_up.shape[-1] // 2
+    gate, up = gate_up[..., :d], gate_up[..., d:]
+    if limit is None:
+        return gate * jax.nn.sigmoid(gate) * up
+    gate = jnp.minimum(gate, jnp.asarray(limit, gate.dtype))
+    up = jnp.clip(up, -limit, limit).astype(up.dtype)
+    return gate * jax.nn.sigmoid(gate) * (up + jnp.asarray(0.0, up.dtype))
+
+
+def tp_shared_expert_partial_local(x: jax.Array, w_gu: jax.Array,
+                                   w_down: jax.Array,
+                                   limit: float | None) -> jax.Array:
+    """This shard's partial shared-expert output for all rows of x (f32).
+
+    Mirrors the replicated path's rounding points: gate_up in x.dtype, the
+    activation in x.dtype, the down projection accumulated in f32.
+    """
+    gu = jnp.dot(x, w_gu, preferred_element_type=jnp.float32).astype(x.dtype)
+    h = silu_and_mul_clamp(gu, limit)
+    return jnp.dot(h, w_down, preferred_element_type=jnp.float32)
