+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Load-time setup for MOE_SHARED_EXPERT_TP (see layers/common/shared_expert_tp.py)."""
+
+import jax
+import jax.numpy as jnp
+import torch
+from jax.sharding import Mesh
+from torch.nn.parameter import Parameter
+from torchax.interop import jax_view, torch_view
+
+from tpu_inference import envs
+from tpu_inference.layers.common.moe import MoEBackend
+from tpu_inference.layers.common.shared_expert_tp import (
+    build_tp_shared_expert, dequantize_block_fp8)
+from tpu_inference.layers.common.sharding import is_attn_dp
+from tpu_inference.logger import init_logger
+
+logger = init_logger(__name__)
+
+
+def _dense_weights(linear: torch.nn.Module) -> list[jax.Array]:
+    """Processed (FP8 block-quant or bf16) linear weight(s) as [K, N] arrays."""
+    ws, ss = linear.weight, getattr(linear, "weight_scale", None)
+    if isinstance(ws, torch.nn.ParameterList):
+        ss = list(ss) if ss is not None else [None] * len(ws)
+        return [
+            dequantize_block_fp8(jax_view(w),
+                                 None if s is None else jax_view(s))
+            for w, s in zip(ws, ss)
+        ]
+    return [
+        dequantize_block_fp8(jax_view(ws), None if ss is None else jax_view(ss))
+    ]
+
+
+def _act_limit(act_fn) -> tuple[bool, float | None]:
+    name = type(act_fn).__name__
+    if name == "SiluAndMul":
+        return True, None
+    if name == "SiluAndMulWithClamp" and getattr(act_fn, "alpha", 1.0) == 1.0 \
+            and getattr(act_fn, "beta", 0.0) == 0.0:
+        return True, float(act_fn.swiglu_limit)
+    return False, None
+
+
+def attach_tp_shared_experts(model: torch.nn.Module, mesh: Mesh) -> int:
+    """Give every eligible MoE runner a tensor-parallel copy of its shared
+    expert (on its RoutedExperts layer). Returns the number of layers."""
+    if not envs.MOE_SHARED_EXPERT_TP:
+        return 0
+    if not is_attn_dp(mesh):
+        logger.warning("MOE_SHARED_EXPERT_TP needs attention data "
+                       "parallelism; ignored.")
+        return 0
+    from tpu_inference.layers.vllm.custom_ops.fused_moe import VllmMoERunner
+    n = 0
+    for name, runner in model.named_modules():
+        if not isinstance(runner, VllmMoERunner):
+            continue
+        shared = runner._shared_experts
+        routed = runner.routed_experts
+        qm = getattr(routed, "quant_method", None)
+        mlp = getattr(shared, "_layer", None)
+        ok_act, limit = _act_limit(getattr(mlp, "act_fn", None))
+        if (shared is None or mlp is None or not ok_act
+                or getattr(qm, "moe_backend", None) != MoEBackend.GMM_TP
+                or not getattr(qm, "is_monolithic", False)
+                or getattr(runner, "routed_input_transform", None) is not None
+                or getattr(runner, "routed_output_transform", None) is not None
+                or getattr(runner, "shared_expert_gate", None) is not None
+                or not hasattr(mlp, "gate_up_proj")
+                or not hasattr(mlp, "down_proj")):
+            logger.warning_once(
+                "MOE_SHARED_EXPERT_TP: %s not eligible; keeping the "
+                "replicated shared expert there.", name)
+            continue
+        gu = _dense_weights(mlp.gate_up_proj)
+        if len(gu) == 1:
+            w_gate, w_up = jnp.split(gu[0], 2, axis=1)
+        else:
+            w_gate, w_up = gu
+        (w_down, ) = _dense_weights(mlp.down_proj)
+        w_gu_tp, w_down_tp = build_tp_shared_expert(w_gate,
+                                                    w_up,
+                                                    w_down,
+                                                    mesh=mesh)
+        routed.shared_tp_w_gu = Parameter(torch_view(w_gu_tp),
+                                          requires_grad=False)
+        routed.shared_tp_w_down = Parameter(torch_view(w_down_tp),
+                                            requires_grad=False)
+        routed.shared_tp_act_limit = limit
+        routed.shared_tp_routed_scale = float(runner.routed_scaling_factor)
+        n += 1
+    logger.info("MOE_SHARED_EXPERT_TP: shared expert tensor-parallel in %d "
+                "MoE layers.", n)
+    return n
