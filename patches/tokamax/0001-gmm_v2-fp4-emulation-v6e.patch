+def needs_fp4_emulation(dtype: jnp.dtype) -> bool:
+  """Whether f4 rhs must be carried as uint4 and decoded in-kernel."""
+  return (
+      jnp.dtype(dtype) == jnp.dtype(jnp.float4_e2m1fn)
+      and pltpu.get_tpu_info().generation < 7
+  )
+
+
+def e2m1_to_codes(rhs: jax.Array) -> jax.Array:
+  """Re-encodes float4_e2m1fn values as the uint4 codes the kernel decodes.
+
+  A code holds, as a two's complement int4, q = sign * (2 * exponent +
+  mantissa) in [-7, 7] (i.e. the e2m1 magnitude bits with the sign applied;
+  -0 becomes +0). `decode_codes` turns it back into the exact e2m1 value with a
+  few bf16 VPU ops, ~4x cheaper than decoding the e2m1 bit fields.
+
+  This is an XLA elementwise pass over all of `rhs`: run it once on stored
+  weights (see gmm_v2's `rhs_fp4_codes`), not per call.
+  """
+  c = lax.bitcast_convert_type(rhs, jnp.uint4).astype(jnp.int8)
+  q = jnp.where(c >= 8, -(c & 7), c & 7).astype(jnp.int4)
+  return lax.bitcast_convert_type(q, jnp.uint4)
+
+
+def decode_codes(codes: jax.Array, dtype: jnp.dtype) -> jax.Array:
+  """Exactly decodes `e2m1_to_codes` codes to `dtype` (in-kernel)."""
+  # e2m1 magnitudes by code: 0 .5 1 1.5 2 3 4 6, i.e. q/2 with the slope
+  # doubling past |q| = 4 and again past |q| = 6:
+  #   v = 2q - clip(q, -4, 4) / 2 - clip(q, -6, 6).
+  # Every intermediate is a small multiple of 1/2, so bf16 is exact.
+  q = lax.bitcast_convert_type(codes, jnp.int4).astype(jnp.bfloat16)
+  v = (q + q) - (jnp.clip(q, -6, 6) + 0.5 * jnp.clip(q, -4, 4))
+  return v.astype(dtype)
+
+
