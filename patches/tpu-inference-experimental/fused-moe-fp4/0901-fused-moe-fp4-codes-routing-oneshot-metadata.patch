+        weights = routing[:, :128]
+        ids = routing[:, 128:].astype(jnp.int32)
+        padded_k_shape = (bt, padded_top_k)
+        e_shape = (bt, padded_num_experts)
+        lane_iota = jax.lax.broadcasted_iota(jnp.int32, (bt, 128), 1)
+        padded_k_iota = jax.lax.broadcasted_iota(jnp.int32, padded_k_shape, 1)
