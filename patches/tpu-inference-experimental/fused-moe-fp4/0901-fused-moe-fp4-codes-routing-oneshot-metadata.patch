+    """Top-k routing exactly as fused_moe_func computes it for the GMM path
+    (scoring function, hash routing, correction bias, renormalization,
+    padding-to-expert-0), for fused_ep_moe's precomputed-routing input."""
+    from tpu_inference.layers.common.fused_moe_gmm import apply_scoring_fn
+    hash_ids = extra.pop("hash_based_topk_indices", None)
+    bias = extra.pop("e_score_correction_bias", None)
+    num_valid_tokens = extra.pop("num_valid_tokens", None)
+    num_tokens = gating_output.shape[0]
+    topk_weights = apply_scoring_fn(scoring_fn, gating_output)
+    if hash_ids is not None:
+        topk_indices = hash_ids
+        topk_weights = jnp.take_along_axis(topk_weights, topk_indices, axis=-1)
+    elif envs.MOE_APPROX_TOPK:
+        topk_weights, topk_indices = jax.lax.approx_max_k(
+            topk_weights,
+            k=top_k,
+            recall_target=envs.MOE_APPROX_TOPK_RECALL_TARGET)
+    elif bias is not None:
+        _, topk_indices = jax.lax.top_k(topk_weights + bias[None, :], k=top_k)
