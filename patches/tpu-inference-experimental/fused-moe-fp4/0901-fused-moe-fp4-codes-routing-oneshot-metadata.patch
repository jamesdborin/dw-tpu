+    if ep_size != mesh.devices.size:
+        raise NotImplementedError(
+            "FUSED_MOE_FP4_EMULATION needs every mesh device on the expert "
+            f"axes, got ep={ep_size} of {mesh.devices.size} devices.")
+    extra.pop("ep_axis_name", None)
