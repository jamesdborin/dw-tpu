+def decode_fp4_codes(codes: jax.Array, dtype) -> jax.Array:
+    """Exactly decodes tokamax `e2m1_to_codes` uint4 codes to `dtype`.
+
+    Same ops as tokamax gmm_v2 `decode_codes` (v6e fp4 emulation): a code is
+    q = sign * (2 * exponent + mantissa) as int4 and the e2m1 value is
+    2q - clip(q, -6, 6) - clip(q, -4, 4) / 2, exact in bf16.
+    """
+    q = lax.bitcast_convert_type(codes, jnp.int4).astype(jnp.bfloat16)
+    v = (q + q) - (jnp.clip(q, -6, 6) + 0.5 * jnp.clip(q, -4, 4))
+    return v.astype(dtype)
+
+
+def dequant_fp4_block(codes: jax.Array, scale: jax.Array, block: int,
+                      dtype) -> jax.Array:
+    """codes (K, N) uint4, scale (K // block, 1, N) -> (K, N) in `dtype`.
+
+    Dequantizes before the matmul in the same order as tokamax gmm_v2 for
+    quant blocks smaller than the MXU: decode to dtype, cast the scale to
+    dtype, multiply. Power-of-two (e8m0) scales keep this exact.
+    """
+    k, n = codes.shape
+    w = decode_fp4_codes(codes, dtype).reshape(k // block, block, n)
+    s = jnp.broadcast_to(scale.astype(dtype), (k // block, block, n))
+    return (w * s).reshape(k, n)
+
+
+def dedupe_topk(topk_weights: jax.Array, topk_ids: jax.Array,
+                num_experts: int) -> tuple[jax.Array, jax.Array]:
+    """Makes each token's expert ids distinct, for precomputed routing.
+
+    The kernel sizes its all-to-all buffers for at most one row per (token,
+    expert); a router can repeat an expert (e.g. a hash table entry). A repeat
+    adds its weight to the first occurrence (f32) and is re-pointed at an
+    expert the token does not use, with weight 0.
+    """
+    top_k = topk_ids.shape[-1]
+    w = topk_weights.astype(jnp.float32)
+    ids = topk_ids.astype(jnp.int32)
+    cand = jnp.arange(min(2 * top_k, num_experts), dtype=jnp.int32)
+    for j in range(1, top_k):
+        same = ids[:, :j] == ids[:, j:j + 1]  # (T, j)
+        dup = jnp.any(same, axis=-1)
+        first = jnp.argmax(same, axis=-1)
+        add = jnp.where(dup, w[:, j], 0.0)
+        w = w.at[jnp.arange(w.shape[0]), first].add(add)
+        used = jnp.any(ids[:, :, None] == cand[None, None, :], axis=1)
+        free = cand[jnp.argmin(used, axis=-1)]
+        ids = ids.at[:, j].set(jnp.where(dup, free, ids[:, j]))
+        w = w.at[:, j].set(jnp.where(dup, 0.0, w[:, j]))
+    return w, ids
+
